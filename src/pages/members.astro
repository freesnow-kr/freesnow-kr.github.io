---
import { club } from '../data/club';
import Meta from '../components/Meta.astro';
import '../styles/ride.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // 끝 슬래시 없이 (scripts/session.ts 참고)
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<Meta title={`${club.name} — My Page`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/`}>FREE SNOW</a>
			<nav id="site-nav" aria-label="메인">
				<a href={`${base}/#season`}>SEASON</a>
				<a href={`${base}/gallery/`}>GALLERY</a>
				<a href={`${base}/webcam/`}>WEBCAM</a>
				<a href={`${base}/rank/`}>CHAT RANK</a>
				<a href={`${base}/shredlog/`}>SHRED LOG</a>
				<a href={`${base}/seasonroom/`}>RIDE &amp; STAY</a>
			</nav>
			<a class="nav-join" href={`${base}/login/`}>LOGIN</a>
			<button class="nav-menu" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="site-nav">☰</button>
		</header>

		<main>
			<section class="mem-intro">
				<p class="kicker">MEMBERS ONLY</p>
				<h1>MY PAGE.</h1>
			</section>

			<section class="mem-body">
				<p class="mem-msg loading">불러오는 중…</p>
				<div class="dash" hidden>
					<!-- 내 정보: 둥근 네모 사진(누르면 바꾸기) + 이름 + 칩 (사용자가 고른 시안 A1, 2026-10-23) -->
					<section class="me">
						<!-- 사진을 누르면 작은 메뉴: 사진 선택 / 사진 지우기 / 취소 -->
						<div class="avatar-wrap">
							<button class="avatar" type="button" aria-haspopup="menu" aria-expanded="false" aria-label="프로필 사진 메뉴">
								<img alt="내 프로필 사진" referrerpolicy="no-referrer" hidden /><span class="avatar-ini" aria-hidden="true"></span>
							</button>
							<span class="avatar-badge" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg></span>
							<div class="photo-menu" role="menu" hidden>
								<label class="pm-item" role="menuitem">사진 선택<input class="avatar-file" type="file" accept="image/*" hidden /></label>
								<button class="pm-item avatar-del" type="button" role="menuitem" hidden>사진 지우기</button>
								<button class="pm-item pm-cancel" type="button" role="menuitem">취소</button>
							</div>
						</div>
						<div class="me-info">
							<p class="me-season"></p>
							<h2 class="me-name"></h2>
							<ul class="me-chips"></ul>
						</div>
					</section>
					<p class="avatar-msg" role="status"></p>

					<!-- 이번 시즌 내 기록 (서버 me.season). 못 받으면 '-' 그대로 -->
					<dl class="strip">
						<div><dt>출격</dt><dd data-k="rides">-</dd></div>
						<!-- 누르면 내 시즌방 이용 상세 (시즌 골라 보기) -->
						<button class="strip-btn stay-open" type="button" aria-haspopup="dialog"><dt class="stay-label">시즌방 <i>자세히 ›</i></dt><dd data-k="stays">-</dd></button>
						<div><dt class="pay-label">정산</dt><dd data-k="pay">-</dd></div>
						<div><dt>SHRED LOG</dt><dd data-k="visits">-</dd></div>
						<div><dt>사진</dt><dd data-k="photos">-</dd></div>
					</dl>

					<nav class="rows" aria-label="계정">
						<a class="row" href={`${base}/password/`}>비밀번호 변경<i>›</i></a>
						<a class="row staff-link" href={`${base}/admin/`} hidden>운영진 화면<i>›</i></a>
						<button class="row out logout" type="button">로그아웃</button>
					</nav>
				</div>

				<!-- 내 시즌방 이용 상세 (모든 회원 것은 운영진 화면 '시즌방 정산') -->
				<dialog class="stay-dlg" aria-labelledby="stay-dlg-title">
					<div class="dlg-head">
						<h3 id="stay-dlg-title">시즌방 이용</h3>
						<select class="stay-season" aria-label="시즌"></select>
						<button class="dlg-close" type="button" aria-label="닫기">✕</button>
					</div>
					<div class="dlg-body">
						<table>
							<thead><tr><th>날짜</th><th>구분</th><th>금액</th></tr></thead>
							<tbody class="stay-rows"></tbody>
							<tfoot><tr><th>합계</th><th class="stay-sum"></th><th class="stay-won"></th></tr></tfoot>
						</table>
					</div>
				</dialog>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-row">
				<a href={`${base}/`}>메인으로</a>
				<span>{club.footer}</span>
			</div>
			<p class="giant" aria-hidden="true">FREE SNOW</p>
		</footer>

		<script>
			import { base, call, loginUrl, logout, photoSrc, store } from '../scripts/session';

			const dash = document.querySelector<HTMLElement>('.dash')!;
			const token = store.get();

			// 로그인 안 했으면 로그인 화면으로
			if (!token) location.replace(loginUrl);
			else {
				const res = await call({ action: 'me', token }).catch(() => null);
				if (!res?.ok) {
					store.clear();
					location.replace(res ? `${loginUrl}?expired` : loginUrl);
				} else {
					document.querySelector('.loading')!.remove();
					dash.hidden = false;
					// 시트 값은 textContent로만 넣음 (HTML 주입 방지)
					store.setName(res.me.name);
					store.setPhoto(res.me.photo ? photoSrc(res.me.photo, 96) : ''); // 헤더 내 메뉴 동그라미
					dash.querySelector('.me-name')!.textContent = res.me.name;
					const chips = [{ master: 'MASTER', staff: 'STAFF' }[res.me.role as string] ?? 'MEMBER', [res.me.grade, res.me.area].filter(Boolean).join(' '), res.me.phone];
					dash.querySelector('.me-chips')!.replaceChildren(
						...chips.filter(Boolean).map((t, i) => {
							const li = document.createElement('li');
							li.textContent = t;
							if (i === 0) li.className = 'role';
							return li;
						}),
					);
					showSeason(res.season);
					setupStays(res.season?.season);
					// 운영진·마스터에게만 링크 (권한은 서버가 따로 확인)
					dash.querySelector<HTMLElement>('.staff-link')!.hidden = !['staff', 'master'].includes(res.me.role);
					setupAvatar(res.me.name, res.me.photo || '');
				}
			}

			// 이번 시즌 내 기록: 숫자는 크게, 단위는 작게
			function showSeason(s: any) {
				if (!s) return;
				dash.querySelector('.me-season')!.textContent = `${s.season} SEASON`;
				const put = (k: string, n: string, unit: string) => {
					const el = dash.querySelector<HTMLElement>(`[data-k="${k}"]`)!;
					el.textContent = n;
					const u = document.createElement('small');
					u.textContent = unit;
					el.append(u);
				};
				put('rides', String(s.rides), '일');
				put('stays', String(s.stays), s.rests ? `박 · 휴식 ${s.rests}` : '박'); // 휴식(4시간)은 숫자 옆에 작게
				put('pay', s.pay.toLocaleString(), '원');
				dash.querySelector('.pay-label')!.textContent = s.owner ? '정산 · 주주' : '정산';
				put('visits', String(s.visits), '일');
				put('photos', String(s.photos), '장');
			}

			// 내 시즌방 이용 상세: 숫자 줄의 '시즌방'을 누르면 팝업, 시즌을 골라 내 기록만 표로 (주주는 0원)
			function setupStays(current?: string) {
				if (!current) return;
				const dlg = document.querySelector<HTMLDialogElement>('.stay-dlg')!;
				const sel = dlg.querySelector<HTMLSelectElement>('.stay-season')!;
				const y = Number(current.slice(0, 2));
				for (let a = y; a >= Math.max(y - 3, 24); a--) sel.append(new Option(`${a}-${a + 1}`, `${a}-${a + 1}`)); // 24-25부터
				const cache: Record<string, any> = {};
				const WD = '일월화수목금토';
				async function draw() {
					const season = sel.value;
					const body = dlg.querySelector('.stay-rows')!;
					const res = cache[season] ?? (cache[season] = await call({ action: 'seasonroom', token, season }).catch(() => null));
					if (!res?.ok) {
						delete cache[season];
						body.replaceChildren(row(['불러오지 못했어요. 잠시 뒤 다시 시도해 주세요.', '', '']));
						return;
					}
					const price = res.prices ?? { 숙박: 10000, 휴식: 5000 };
					const mine = (res.nights as { date: string; kind: string; me: boolean; owner: boolean }[]).filter((n) => n.me);
					const owner = mine.some((n) => n.owner);
					const fee = (k: string) => (owner ? 0 : k === '휴식' ? price.휴식 : price.숙박);
					body.replaceChildren(
						...(mine.length
							? mine.map((n) => {
									const [yy, mm, dd] = n.date.split('-').map(Number);
									// 날짜에 연도는 뺌 (고른 시즌으로 알 수 있어서)
									return row([`${mm}.${dd} (${WD[new Date(yy, mm - 1, dd).getDay()]})`, n.kind === '휴식' ? '4시간 휴식' : '숙박', `${fee(n.kind).toLocaleString()}원`]);
								})
							: [row(['이 시즌엔 이용 기록이 없어요.', '', ''])]),
					);
					const stays = mine.filter((n) => n.kind !== '휴식').length;
					dlg.querySelector('.stay-sum')!.textContent = `${stays}박 · 휴식 ${mine.length - stays}회`;
					dlg.querySelector('.stay-won')!.textContent = owner ? '주주 · 0원' : `${mine.reduce((t, n) => t + fee(n.kind), 0).toLocaleString()}원`;
				}
				const row = (cells: string[]) => {
					const tr = document.createElement('tr');
					for (const c of cells) {
						const td = document.createElement('td');
						td.textContent = c;
						tr.append(td);
					}
					return tr;
				};
				sel.addEventListener('change', draw);
				dash.querySelector('.stay-open')!.addEventListener('click', () => {
					dlg.showModal();
					draw();
				});
				dlg.querySelector('.dlg-close')!.addEventListener('click', () => dlg.close());
				dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); }); // 바깥(어두운 곳) 누르면 닫기
			}

			// 프로필 사진: 브라우저에서 정사각형 256px JPG(드라이브용) + 96px JPG(드라이브가 안 될 때 시트용)로 줄여서 올림
			function setupAvatar(name: string, photo: string) {
				const img = dash.querySelector<HTMLImageElement>('.avatar img')!;
				const ini = dash.querySelector<HTMLElement>('.avatar-ini')!;
				const file = dash.querySelector<HTMLInputElement>('.avatar-file')!;
				const del = dash.querySelector<HTMLButtonElement>('.avatar-del')!;
				const msg = dash.querySelector<HTMLElement>('.avatar-msg')!;
				const wrap = dash.querySelector<HTMLElement>('.me')!; // 사진(또는 아래 '프로필 사진 바꾸기')을 누르면 파일 고르기
				const show = (id: string) => {
					img.hidden = !id;
					if (id) img.src = photoSrc(id, 256);
					ini.hidden = !!id;
					ini.textContent = name.slice(-2);
					del.hidden = !id;
				};
				const toJpeg = (f: File) =>
					new Promise<{ data: string; small: string }>((ok, bad) => {
						const url = URL.createObjectURL(f);
						const pic = new Image();
						pic.onload = () => {
							const side = Math.min(pic.naturalWidth, pic.naturalHeight);
							// 가운데 정사각형만 잘라 S px JPG로
							const square = (S: number, q: number) => {
								const c = document.createElement('canvas');
								c.width = c.height = S;
								c.getContext('2d')!.drawImage(pic, (pic.naturalWidth - side) / 2, (pic.naturalHeight - side) / 2, side, side, 0, 0, S, S);
								return c.toDataURL('image/jpeg', q);
							};
							URL.revokeObjectURL(url);
							ok({ data: square(256, 0.85), small: square(96, 0.8) });
						};
						pic.onerror = () => {
							URL.revokeObjectURL(url);
							bad(new Error('decode'));
						};
						pic.src = url;
					});
				const send = async (body: object, doing: string, done: string) => {
					wrap.setAttribute('aria-busy', 'true');
					msg.textContent = doing;
					const r = await call({ action: 'avatar', token, ...body }).catch(() => null);
					wrap.setAttribute('aria-busy', 'false');
					if (r?.expired) {
						store.clear();
						return location.replace(`${loginUrl}?expired`);
					}
					if (!r?.ok) {
						msg.textContent = r?.error ?? '서버에 연결하지 못했어요. 잠시 뒤 다시 시도해 주세요.';
						return;
					}
					show(r.photo);
					store.setPhoto(r.photo ? photoSrc(r.photo, 96) : '');
					msg.textContent = done;
				};
				show(photo);
				// 사진 메뉴: 사진을 누르면 열림, 바깥 클릭·Esc·고르면 닫힘
				const btn = dash.querySelector<HTMLButtonElement>('.avatar')!;
				const menu = dash.querySelector<HTMLElement>('.photo-menu')!;
				const open = (on: boolean) => {
					menu.hidden = !on;
					btn.setAttribute('aria-expanded', String(on));
				};
				btn.addEventListener('click', () => open(menu.hidden));
				dash.querySelector('.pm-cancel')!.addEventListener('click', () => open(false));
				addEventListener('click', (e) => { if (!(e.target as Element).closest('.avatar-wrap')) open(false); });
				addEventListener('keydown', (e) => { if (e.key === 'Escape') open(false); });
				file.addEventListener('change', async () => {
					open(false);
					const f = file.files?.[0];
					file.value = '';
					if (!f) return;
					const pics = await toJpeg(f).catch(() => null);
					if (!pics) {
						msg.textContent = '이 사진은 열 수 없어요. 다른 사진(JPG·PNG)으로 해 주세요.';
						return;
					}
					send(pics, '사진 올리는 중…', '프로필 사진을 바꿨어요.');
				});
				del.addEventListener('click', () => {
					open(false);
					send({ remove: true }, '지우는 중…', '프로필 사진을 지웠어요.');
				});
			}

			dash.querySelector('.logout')!.addEventListener('click', () => {
				logout();
				location.href = `${base}/`;
			});
		</script>
	</body>
</html>

<style>
	/* 마이페이지는 내용이 짧아서 위아래 여백을 줄임 (공통 .mem-body는 ride.css) */
	.mem-body {
		padding-block: clamp(24px, 4vw, 40px) clamp(40px, 6vw, 64px);
		min-height: 0;
	}
	/* 제목(MY PAGE.)은 다른 페이지와 같은 왼쪽 위치, 내용 덩어리는 따로 가운데 (사용자 요구) */
	.dash {
		display: grid;
		gap: 22px;
		max-width: 760px;
		margin-inline: auto;
	}
	/* 내 정보 카드 */
	.me {
		display: flex;
		align-items: center;
		gap: 26px;
		padding: 26px;
		background: var(--white);
		border-radius: 20px;
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.06);
	}
	.me[aria-busy='true'] {
		opacity: 0.5;
		pointer-events: none;
	}
	.avatar {
		position: relative;
		display: grid;
		place-items: center;
		flex: none;
		width: 120px;
		height: 120px;
		border-radius: 32px;
		overflow: hidden;
		background: var(--black);
		color: var(--white);
		cursor: pointer;
	}
	.avatar {
		padding: 0;
		border: 0;
	}
	.avatar:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}
	.avatar-wrap {
		position: relative;
		flex: none;
	}
	/* 사진 오른쪽 아래 카메라 표시 */
	.avatar-badge {
		position: absolute;
		right: -6px;
		bottom: -6px;
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: var(--white);
		color: var(--black);
		box-shadow: 0 2px 8px rgb(0 0 0 / 0.18);
		pointer-events: none;
	}
	/* 사진 아래 작은 메뉴 */
	.photo-menu {
		position: absolute;
		top: calc(100% + 10px);
		left: 0;
		z-index: 5;
		display: grid;
		min-width: 150px;
		overflow: hidden;
		border-radius: 14px;
		background: var(--white);
		box-shadow: 0 10px 30px rgb(0 0 0 / 0.18);
	}
	.photo-menu[hidden] {
		display: none;
	}
	.pm-item {
		padding: 13px 16px;
		border: 0;
		background: none;
		color: var(--black);
		font: 700 14px 'Noto Sans KR', sans-serif;
		text-align: left;
		cursor: pointer;
	}
	.pm-item + .pm-item {
		border-top: 1px solid var(--line);
	}
	.avatar-del {
		color: #c4320a;
	}
	.pm-cancel {
		color: var(--gray);
	}
	@media (hover: hover) {
		.pm-item:hover {
			background: #f6f5f1;
		}
	}
	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.avatar-ini {
		font: 900 30px 'Noto Sans KR', sans-serif;
	}
	.me-season {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.22em;
		color: var(--accent);
	}
	.me-name {
		margin: 4px 0 12px;
		font: 900 clamp(2rem, 5vw, 2.6rem) 'Noto Sans KR', sans-serif;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}
	.me-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.me-chips :global(li) {
		padding: 5px 12px;
		border-radius: 999px;
		background: var(--bone);
		font-size: 13px;
		font-weight: 700;
	}
	.me-chips :global(li.role) {
		background: var(--black);
		color: var(--white);
	}
	.avatar-msg {
		min-height: 1.2em;
		margin-top: -12px;
		font-size: 13px;
		color: #4a4d55;
	}
	.avatar-msg:empty {
		display: none;
	}
	/* 숫자 띠: 칸 없이 세로줄로 나눔 */
	.strip {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		margin: 0;
		border-block: 1.5px solid var(--black);
	}
	.strip div {
		padding: 16px 14px;
	}
	.strip > * + * {
		border-left: 1px solid var(--line);
	}
	.strip dt {
		font-size: 12px;
		font-weight: 700;
		color: #4a4d55;
	}
	.strip dd {
		margin: 6px 0 0;
		font: 2rem var(--display);
	}
	.strip :global(small) {
		margin-left: 3px;
		font: 700 12px 'Noto Sans KR', sans-serif;
	}
	/* 숫자 줄의 '시즌방' 칸은 버튼 (누르면 상세 팝업) */
	.strip-btn {
		display: block;
