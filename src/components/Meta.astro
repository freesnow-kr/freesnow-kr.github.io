---
// <title> + 카톡·SNS 링크 미리보기(오픈그래프). 미리보기 주소·이미지는 절대 주소여야 함 → astro.config의 site 기준
// 카톡은 미리보기를 캐시함 → 바꾼 뒤엔 카카오 공유 디버거(developers.kakao.com/tool/debugger/sharing)에서 초기화
interface Props {
	title: string;
	description?: string;
}
const { title, description = '엘리시안강촌 스키·스노보드 동호회 프리스노우. 정모 일정, 라이딩 사진, 스키장 웹캠, 시즌 기록까지 한곳에서.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = new URL(Astro.url.pathname, Astro.site);
const image = new URL(`${base}/og.jpg`, Astro.site); // public/og.jpg (1200×630, hero.jpg에서 자름)
---

<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="FREE SNOW" />
<meta property="og:locale" content="ko_KR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<!-- 홈 화면에 앱으로 설치 (PWA, public/manifest.webmanifest · sw.js). 아이콘은 scripts/make-logo.py -->
<link rel="manifest" href={`${base}/manifest.webmanifest`} />
<meta name="theme-color" content="#0b0d12" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="Freesnow" />
<meta name="apple-mobile-web-app-status-bar-style" content="black" />
