---
import { club } from '../data/club';
import Meta from '../components/Meta.astro';
import '../styles/ride.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // 끝 슬래시 없이 (scripts/session.ts 참고)
// 사진은 드라이브 폴더에서 실시간으로 (Worker secret GALLERY_FOLDER_ID)
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<Meta title={`${club.name} — Gallery`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- API(Worker), 사진(드라이브) 서버에 미리 연결 -->
		<link rel="preconnect" href="https://api.freesnow.workers.dev" crossorigin />
		<link rel="preconnect" href="https://lh3.googleusercontent.com" />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/`}><img src={`${base}/logo-white.png`} alt="FREE SNOW" width="103" height="50" /></a>
			<nav id="site-nav" aria-label="메인">
				<a href={`${base}/#season`}>SEASON</a>
				<a href={`${base}/board/`}>BOARD</a>
				<a href={`${base}/gallery/`} aria-current="page">GALLERY</a>
				<a href={`${base}/webcam/`}>WEBCAM</a>
				<a href={`${base}/rank/`}>CHAT RANK</a>
				<a href={`${base}/shredlog/`}>SHRED LOG</a>
				<a href={`${base}/seasonroom/`}>RIDE &amp; STAY</a>
			</nav>
			<a class="nav-join" href={`${base}/login/`}>LOGIN</a>
			<button class="nav-menu" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="site-nav">☰</button>
		</header>

		<main>
			<section class="mem-intro">
				<p class="kicker">ON THE SLOPE</p>
				<h1>GALLERY.</h1>
			</section>

			<section class="mem-body">
				<!-- 회원 누구나 올림 (원본 그대로 Cloudflare R2, 지난 시즌은 드라이브로 보관 — backend/src/photos.ts) -->
				<!-- 한 줄: 왼쪽 [전체][날짜별], 오른쪽 작은 '사진 올리기' (사용자 요구 2026-10-29) -->
				<div class="up">
					<!-- 기본은 전체 사진 한 격자, '날짜별'을 누르면 찍은 날짜로 묶음 + 그날 정모 표시 (고른 보기는 기억). 예전 드라이브 사진은 맨 아래 '예전 사진' -->
					<div class="by-day" role="group" aria-label="보기" hidden>
						<button type="button" data-day="0">전체</button>
						<button type="button" data-day="1">날짜별</button>
					</div>
					<label class="up-btn" hidden>
						+ 사진 올리기
						<input class="up-file" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" multiple hidden />
					</label>
					<a class="up-login" href={`${base}/login/?next=${base}/gallery/`} hidden>로그인하면 사진을 올릴 수 있어요 →</a>
					<p class="up-msg" role="status"></p>
				</div>
				<p class="mem-msg g-msg" role="status">사진 불러오는 중…</p>
				<div class="days"></div>
			</section>
		</main>

		<dialog class="viewer" aria-label="사진 크게 보기">
			<figure>
				<img alt="" referrerpolicy="no-referrer" />
				<figcaption><span class="v-cap"></span> <a class="v-orig" target="_blank" rel="noopener" hidden>원본 ↗</a> <button class="v-del" type="button" hidden>삭제</button></figcaption>
			</figure>
			<button class="v-btn v-close" type="button" aria-label="닫기">✕</button>
			<button class="v-btn v-prev" type="button" aria-label="이전 사진">←</button>
			<button class="v-btn v-next" type="button" aria-label="다음 사진">→</button>
		</dialog>

		<footer class="footer">
			<div class="footer-row">
				<span>{club.footer}</span>
			</div>
			<p class="giant" aria-hidden="true">FREE SNOW</p>
		</footer>

		<script>
			import { call, fetchPhotos, galleryPhotos, largeOf, store, thumbOf, type Photo } from '../scripts/session';
			import { club } from '../data/club';

			const days = document.querySelector<HTMLElement>('.days')!;
			const msg = document.querySelector<HTMLElement>('.g-msg')!;
			const dialog = document.querySelector<HTMLDialogElement>('.viewer')!;
			const img = dialog.querySelector('img')!;
			const cap = dialog.querySelector<HTMLElement>('.v-cap')!;
			const orig = dialog.querySelector<HTMLAnchorElement>('.v-orig')!;
			const del = dialog.querySelector<HTMLButtonElement>('.v-del')!;
			let photos: Photo[] = [];
			let at = 0;

			// 파일 이름, 설명은 textContent, 속성으로만 넣음 (HTML 주입 방지)
			// 날짜별로 보기 (기본은 끔, 고른 것은 이 브라우저에 기억)
			const BY_DAY = 'fs-gallery-byday';
			let byDay = (() => { try { return localStorage.getItem(BY_DAY) === '1'; } catch { return false; } })();
			const dayBtns = [...document.querySelectorAll<HTMLButtonElement>('.by-day button')];
			const markDay = () => dayBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.day === '1') === byDay)));
			markDay();
			dayBtns.forEach((b) =>
				b.addEventListener('click', () => {
					byDay = b.dataset.day === '1';
					try { localStorage.setItem(BY_DAY, byDay ? '1' : '0'); } catch {}
					markDay();
					render(photos);
				}),
			);
			function render(list: Photo[] | null) {
				photos = list ?? [];
				msg.textContent = !list ? '사진을 불러오지 못했어요. 잠시 뒤 다시 시도해 주세요.' : photos.length ? '' : '아직 사진이 없어요.';
				msg.hidden = !msg.textContent;
				// 같은 날끼리 (목록은 이미 찍은 날 최신순, 날짜 없는 예전 사진은 뒤)
				const groups: { date?: string; meetup?: string; items: number[] }[] = [];
				photos.forEach((p, i) => {
					const last = groups.at(-1);
					if (last && last.date === p.date) {
						last.items.push(i);
						last.meetup ??= p.meetup;
					} else groups.push({ date: p.date, meetup: p.meetup, items: [i] });
				});
				const toggle = document.querySelector<HTMLElement>('.by-day')!;
				toggle.hidden = !photos.length;
				if (!byDay) {
					// 전체 보기: 날짜 제목 없이 한 격자
					const ul = document.createElement('ul');
					ul.className = 'grid';
					ul.append(...photos.map((p, i) => tile(p, i)));
					days.replaceChildren(ul);
					return;
				}
				const WD = '일월화수목금토';
				days.replaceChildren(
					...groups.map((g) => {
						const sec = document.createElement('section');
						sec.className = 'day';
						const h = document.createElement('h2');
						h.className = 'day-head';
						const d = g.date ? new Date(`${g.date}T00:00:00`) : null;
						h.append(Object.assign(document.createElement('span'), { textContent: d ? `${g.date!.replace(/-/g, '.')} (${WD[d.getDay()]})` : '예전 사진' }));
						h.append(Object.assign(document.createElement('small'), { textContent: `사진 ${g.items.length}장` }));
						if (g.meetup) h.append(Object.assign(document.createElement('b'), { className: 'day-meetup', textContent: `정모 | ${g.meetup}` }));
						const ul = document.createElement('ul');
						ul.className = 'grid';
						ul.append(...g.items.map((i) => tile(photos[i], i)));
						sec.append(h, ul);
						return sec;
					}),
				);
			}
			// 사진 칸 하나 (i = 전체 목록에서 몇 번째 — 크게 보기에서 ←/→로 날짜를 넘어 이어서 봄)
			function tile(p: Photo, i: number) {
				const li = document.createElement('li');
				const a = document.createElement('a');
				a.href = largeOf(p);
				const pic = document.createElement('img');
				pic.src = thumbOf(p);
				pic.alt = p.caption || `프리스노우 사진 ${i + 1}`;
				pic.loading = i < 8 ? 'eager' : 'lazy';
				pic.referrerPolicy = 'no-referrer';
				a.append(pic);
				a.addEventListener('click', (e) => {
					e.preventDefault();
					show(i);
					dialog.showModal();
				});
				li.append(a);
				return li;
			}
			const show = (i: number) => {
				if (!photos.length) return dialog.close();
				at = (i + photos.length) % photos.length;
				const p = photos[at];
				img.src = largeOf(p);
				img.alt = p.caption || `프리스노우 사진 ${at + 1}`;
				cap.textContent = p.caption;
				orig.hidden = !p.large?.includes('/photo/');
				if (!orig.hidden) orig.href = p.large!.replace(/\/large$/, '/orig');
				del.hidden = !p.mine;
			};
			render(await galleryPhotos());

			dialog.querySelector('.v-close')!.addEventListener('click', () => dialog.close());
			dialog.querySelector('.v-prev')!.addEventListener('click', () => show(at - 1));
			dialog.querySelector('.v-next')!.addEventListener('click', () => show(at + 1));
			// 사진 바깥(검은 배경) 누르면 닫기, ←/→ 넘기기 (Esc는 dialog 기본)
			dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
			dialog.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') show(at - 1);
				if (e.key === 'ArrowRight') show(at + 1);
			});
			// 내가 올린 사진(운영진은 모든 사진) 지우기
			del.addEventListener('click', async () => {
				if (!confirm('이 사진을 지울까요?')) return;
				const res = await call({ action: 'photoDelete', token: store.get(), id: photos[at].id }).catch(() => null);
				if (!res?.ok) return alert(res?.error ?? '지우지 못했어요.');
				photos.splice(at, 1);
				render(photos);
				show(at);
				fetchPhotos();
			});

			// 올리기: 로그인한 회원. 원본 그대로 + 브라우저가 만든 1800px, 720px JPG (화면에 빠르게 보이게)
			const token = store.get();
			const upBtn = document.querySelector<HTMLElement>('.up-btn')!;
			const upMsg = document.querySelector<HTMLElement>('.up-msg')!;
			upBtn.hidden = !token;
			document.querySelector<HTMLElement>('.up-login')!.hidden = !!token;
			const resize = async (file: File, max: number, q: number) => {
				const bmp = await createImageBitmap(file); // 사진 방향(EXIF)은 브라우저가 맞춰 줌
				const s = Math.min(1, max / Math.max(bmp.width, bmp.height));
				const c = document.createElement('canvas');
				c.width = Math.round(bmp.width * s);
				c.height = Math.round(bmp.height * s);
				c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
				return new Promise<Blob>((ok, bad) => c.toBlob((b) => (b ? ok(b) : bad(new Error('jpeg'))), 'image/jpeg', q));
			};
			document.querySelector<HTMLInputElement>('.up-file')!.addEventListener('change', async (e) => {
				const input = e.target as HTMLInputElement;
				const files = [...(input.files ?? [])];
				input.value = '';
				if (!files.length) return;
				upBtn.setAttribute('aria-disabled', 'true');
				let done = 0;
				const fails: string[] = [];
				for (const f of files) {
					upMsg.textContent = `올리는 중… ${done + 1}/${files.length}`;
					try {
						const [large, thumb] = [await resize(f, 1800, 0.85), await resize(f, 720, 0.8)];
						const form = new FormData();
						form.set('token', token!);
						form.set('orig', f);
						form.set('large', large, 'large.jpg');
						form.set('thumb', thumb, 'thumb.jpg');
						form.set('taken', String(f.lastModified)); // 휴대폰 사진은 찍은 시각 → 시즌
						const res = await (await fetch(`${club.api}/photos`, { method: 'POST', body: form })).json();
						if (!res.ok) throw new Error(res.error);
						done++;
					} catch (err) {
						fails.push(`${f.name}: ${(err as Error).message === 'jpeg' || (err as Error).name === 'InvalidStateError' ? '이 브라우저에서 열 수 없는 사진이에요' : (err as Error).message || '실패'}`);
					}
				}
				upBtn.removeAttribute('aria-disabled');
				upMsg.textContent = `${done}장 올렸어요.` + (fails.length ? ` 못 올린 사진: ${fails.join(', ')}` : '');
				render(await fetchPhotos());
			});
		</script>
	</body>
</html>

<style>
	/* 날짜 묶음: 날짜 제목 줄 + 그날 사진 격자 */
	/* 전체 / 날짜별 (게시판 말머리 버튼과 같은 모양) */
	.by-day {
		display: flex;
		gap: 6px;
	}
	.by-day button {
		min-height: 32px;
		padding: 0 14px;
		border: 1.5px solid var(--black);
		border-radius: 99px;
		background: var(--white);
		color: var(--black);
		font: 700 13px 'Noto Sans KR', sans-serif;
		cursor: pointer;
	}
	.by-day button[aria-pressed='true'] {
		background: var(--black);
		color: var(--white);
	}
	.days {
		display: grid;
		gap: 28px;
		margin-top: 12px;
	}
	.days :global(.day-head) {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 10px;
		margin-bottom: 10px;
		padding-bottom: 8px;
		border-bottom: 1px solid var(--line);
		font-size: 16px;
		font-weight: 900;
	}
	.days :global(.day-head small) {
		color: var(--gray);
		font-size: 13px;
		font-weight: 400;
	}
	.days :global(.day-meetup) {
		padding: 2px 8px;
		background: var(--accent);
		color: var(--black);
		font-size: 12px;
	}
	/* 벽돌형: 사진 원래 비율 그대로 (잘리지 않음). 열마다 위→아래로 채움 */
	.days :global(.grid) {
		list-style: none;
		margin: 0;
		padding: 0;
		columns: 4 240px;
		column-gap: 6px;
	}
	@media (max-width: 640px) {
		.days :global(.grid) {
			columns: 2;
			column-gap: 4px;
		}
	}
	.days :global(.grid li) {
		break-inside: avoid;
		margin-bottom: 6px;
	}
	.days :global(.grid a) {
		display: block;
		overflow: hidden;
		background: var(--black);
	}
	.days :global(.grid img) {
		display: block;
		width: 100%;
		height: auto;
		transition: transform 0.4s, opacity 0.2s;
	}
	.days :global(.grid a:hover img) {
		transform: scale(1.03);
		opacity: 0.9;
	}

	.viewer {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgb(11 13 18 / 0.96);
		color: var(--white);
	}
	.viewer::backdrop {
		background: rgb(0 0 0 / 0.6);
	}
	.viewer figure {
		height: 100%;
		margin: 0;
		display: grid;
		grid-template-rows: 1fr auto;
		place-items: center;
		padding: 56px clamp(16px, 6vw, 96px) 24px;
		pointer-events: none;
	}
	.viewer img {
		max-width: 100%;
		max-height: calc(100dvh - 140px);
		object-fit: contain;
		pointer-events: auto;
	}
	.up {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 16px;
		margin-bottom: 16px;
	}
	/* 보기 버튼과 같은 높이의 작은 검정 버튼, 오른쪽 끝 */
	.up-btn {
		display: inline-flex;
		align-items: center;
		min-height: 32px;
		margin-left: auto;
		padding: 0 14px;
		border-radius: 99px;
		background: var(--black);
		color: var(--white);
		font-size: 13px;
		font-weight: 700;
		cursor: pointer;
	}
	.up-login {
		margin-left: auto;
		font-size: 13px;
	}
	/* 올리는 중, 결과 안내는 아래 줄 */
	.up-msg:not(:empty) {
		flex-basis: 100%;
	}
	.up-btn[aria-disabled='true'] {
		opacity: 0.5;
		pointer-events: none;
	}
	.up-login {
		font-weight: 700;
	}
	.up-msg:empty {
		display: none;
	}
	.up-msg {
		font-size: 14px;
		color: #4a4d55;
	}
	.v-orig,
	.v-del {
		color: inherit;
		font: inherit;
		font-size: 13px;
		opacity: 0.8;
	}
	.v-del {
		margin-left: 8px;
		border: 1px solid currentColor;
		background: none;
		padding: 2px 8px;
		cursor: pointer;
	}
	.viewer figcaption {
		margin-top: 14px;
		font-size: 14px;
		color: rgb(255 255 255 / 0.75);
	}
	.v-btn {
		position: absolute;
		width: 48px;
		height: 48px;
		border: 1.5px solid rgb(255 255 255 / 0.5);
		border-radius: 50%;
		background: rgb(0 0 0 / 0.3);
		color: var(--white);
		font-size: 18px;
		cursor: pointer;
	}
	.v-btn:hover {
		background: var(--white);
		color: var(--black);
	}
	.v-close {
		top: 16px;
		right: 16px;
	}
	.v-prev,
	.v-next {
		top: 50%;
		transform: translateY(-50%);
	}
	.v-prev {
		left: 16px;
	}
	.v-next {
		right: 16px;
	}
	@media (max-width: 640px) {
		.v-prev,
		.v-next {
			top: auto;
			bottom: 16px;
			transform: none;
		}
	}
</style>
