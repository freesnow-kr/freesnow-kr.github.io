// Free Snow API — https://api.freesnow.workers.dev (계정 하위 도메인 freesnow + 이름 api)
// 비밀값(RESET_PASSWORD, LOGIN_KEY_SECRET, SNOWLIVE_API, SOMOIM_URL, GALLERY_FOLDER_ID, GOOGLE_API_KEY)은 여기 말고 `wrangler secret put` / 로컬은 .dev.vars
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "freesnow",
			"database_id": "d9ab98ac-ffd8-465e-b358-9dd75a2f0d26",
			"migrations_dir": "migrations"
		}
	],
	// 갤러리 사진 (R2). 처음 한 번 `npx wrangler r2 bucket create freesnow-photos`
	"r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "freesnow-photos" }],
	"vars": { "ALLOWED_ORIGINS": "https://freesnow-kr.github.io,http://localhost:4321" },
	// 매일 03:00 KST: 90일 지난 로그인 이력, 끝난 세션, 지난 캐시 정리
	"triggers": { "crons": ["0 18 * * *"] }
}
