---
import { club, trips, faqs } from '../data/club';
import Meta from '../components/Meta.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // 끝 슬래시 없이 (scripts/session.ts 참고)

// 픽셀 아이콘: '#' = 칠할 칸, currentColor로 색 지정
const px = (rows: string[]) => ({
	w: rows[0].length,
	h: rows.length,
	d: rows.flatMap((r, y) => [...r].map((c, x) => (c === '#' ? `M${x} ${y}h1v1h-1z` : ''))).join(''),
});

const icons = {
	flake: px(['...#...', '.#.#.#.', '..###..', '#######', '..###..', '.#.#.#.', '...#...']),
	arrow: px(['....#..', '.....#.', '#######', '.....#.', '....#..']),
	check: px(['......#', '.....#.', '#...#..', '.#.#...', '..#....']),
	mountain: px(['...#....', '..###...', '..####..', '.######.', '.#######', '########']),
	car: px(['..####..', '.#....#.', '########', '########', '.##..##.']),
	flag: px(['##......', '####....', '######..', '####....', '##......', '#.......', '#.......']),
	mug: px(['######..', '#....###', '#....#.#', '#....#.#', '#....###', '######..']),
};

const chips = ['완전 초보 환영', '정기 회비 없음', '스키 · 보드 모두'];

const steps = [
	{ title: '오픈채팅 입장', desc: '링크로 들어와서 인사 한 줄이면 가입 끝.' },
	{ title: '정모 투표', desc: '공지된 일정에 투표하고 카풀·숙소를 같이 정해요.' },
	{ title: '같이 타기', desc: '실력별로 조를 나눠 타고, 끝나면 다 같이 뒤풀이.' },
];

const activities = [
	{ icon: icons.mountain, title: '월 1~2회 정모', desc: '시즌 내내 강원도 리조트를 돌아가며 타요.' },
	{ icon: icons.car, title: '카풀 매칭', desc: '사는 동네끼리 묶어서 기름값 나눠 내요.' },
	{ icon: icons.flag, title: '초보 강습 데이', desc: '상급자 회원이 넘어지는 법부터 알려줘요.' },
	{ icon: icons.mug, title: '뒤풀이', desc: '슬로프만큼 중요한 시간. 물론 자유 참석.' },
];
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<Meta title={`${club.name} | 스키·보드 동호회`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Bricolage+Grotesque:wght@600;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="site-header">
			<div class="wrap header-row">
				<a class="logo" href="#">
					<svg class="pi" viewBox={`0 0 ${icons.flake.w} ${icons.flake.h}`} aria-hidden="true"><path d={icons.flake.d} /></svg>
					{club.name}
				</a>
				<nav aria-label="메인">
					<a href="#how">활동 방식</a>
					<a href="#trips">일정</a>
					<a href="#faq">FAQ</a>
				</nav>
				<a class="btn btn-go btn-sm" href={club.joinUrl} target="_blank" rel="noopener">참여하기</a>
			</div>
		</header>

		<main>
			<section class="hero">
				<div class="wrap hero-row">
					<div class="hero-copy">
						<h1>혼자 타면 운동,<br /><span class="hl">같이 타면</span> 여행.</h1>
						<p class="sub">스키어와 보더가 모여 시즌 내내 함께 타는 동호회, {club.name}.</p>
						<ul class="chips">
							{chips.map((c) => (
								<li class="chip">
									<svg class="pi" viewBox={`0 0 ${icons.check.w} ${icons.check.h}`} aria-hidden="true"><path d={icons.check.d} /></svg>
									{c}
								</li>
							))}
						</ul>
						<div class="cta-row">
							<a class="btn btn-go" href={club.joinUrl} target="_blank" rel="noopener">
								오픈채팅 참여
								<svg class="pi" viewBox={`0 0 ${icons.arrow.w} ${icons.arrow.h}`} aria-hidden="true"><path d={icons.arrow.d} /></svg>
							</a>
							<a class="btn btn-white" href="#trips">시즌 일정 보기</a>
						</div>
					</div>
					<img class="mascot" src={`${base}/mascot.svg`} alt="스노우보드와 스키를 타는 픽셀 펭귄" width="500" height="300" />
				</div>
			</section>

			<div class="dither" style="--from: var(--paper); --to: var(--night)"></div>
			<section id="how" class="section night">
				<div class="wrap">
					<p class="eyebrow">How it works</p>
					<h2>가입부터 첫 런까지, <span class="hl hl-ice">세 단계</span></h2>
					<ol class="steps">
						{steps.map((s, i) => (
							<li>
								<span class="n">{i + 1}</span>
								<h3>{s.title}</h3>
								<p>{s.desc}</p>
							</li>
						))}
					</ol>
				</div>
			</section>
			<div class="dither" style="--from: var(--night); --to: var(--pine-deep)"></div>

			<section class="section pine-band">
				<div class="wrap">
					<p class="eyebrow">What we do</p>
					<h2>시즌 동안 이런 걸 해요</h2>
					<ul class="tiles">
						{activities.map((a, i) => (
							<li class="tile">
								<span class={`tile-icon t${i % 4}`}>
									<svg class="pi" viewBox={`0 0 ${a.icon.w} ${a.icon.h}`} aria-hidden="true"><path d={a.icon.d} /></svg>
								</span>
								<h3>{a.title}</h3>
								<p>{a.desc}</p>
							</li>
						))}
					</ul>
				</div>
			</section>
			<div class="dither" style="--from: var(--pine-deep); --to: var(--paper-2)"></div>

			<section id="trips" class="section paper-2">
				<div class="wrap">
					<p class="eyebrow">2026–27 Season</p>
					<h2>시즌 일정</h2>
					<ul class="trips">
						{trips.map((t) => (
							<li class="trip">
								<time>{t.date}</time>
								<div>
									<h3>{t.place}</h3>
									<p>{t.note}</p>
								</div>
								<span class="tag">{t.tag}</span>
							</li>
						))}
					</ul>
				</div>
			</section>
			<div class="dither" style="--from: var(--paper-2); --to: var(--paper)"></div>

			<section id="faq" class="section">
				<div class="wrap faq-wrap">
					<h2>자주 묻는 질문</h2>
					{faqs.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
			</section>

			<section class="final">
				<div class="wrap final-inner">
					<h2>이번 시즌, <span class="hl">같이 타요.</span></h2>
					<p>첫 정모 전에 들어오면 카풀부터 같이 맞춰 드려요.</p>
					<a class="btn btn-honey" href={club.joinUrl} target="_blank" rel="noopener">
						오픈채팅 참여
						<svg class="pi" viewBox={`0 0 ${icons.arrow.w} ${icons.arrow.h}`} aria-hidden="true"><path d={icons.arrow.d} /></svg>
					</a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap footer-row">
				<span>{club.footer}</span>
				<a href={club.joinUrl} target="_blank" rel="noopener">오픈채팅</a>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--paper: #f7f4ea;
		--paper-2: #ebe7d8;
		--rule: #ddd8c6;
		--card: #fff;
		--ink: #16211b;
		--ink-2: #46534b;
		--pine: #1f6b45;
		--pine-deep: #134a2f;
		--honey: #f5b52e;
		--honey-d: #c98a0f;
		--ice: #bfe6f2;
		--berry: #e85d4a;
		--night: #121a16;
		--night-2: #1c2721;
		--night-ink: #e6ece8;
		--night-ink-2: #a3b2a9;
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		font: 17px/1.6 'Atkinson Hyperlegible', system-ui, sans-serif;
		color: var(--ink);
		background: var(--paper);
	}
	h1,
	h2,
	h3,
	.logo {
		font-family: 'Bricolage Grotesque', system-ui, sans-serif;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}
	h2 {
		font-size: clamp(1.8rem, 4.5vw, 2.6rem);
		margin: 0 0 2rem;
	}
	h3 {
		font-size: 1.2rem;
		margin: 0 0 0.35rem;
	}
	p {
		margin: 0;
	}
	ul,
	ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.wrap {
		max-width: 1080px;
		margin: 0 auto;
		padding: 0 20px;
	}
	.pi {
		width: 1em;
		height: 1em;
		fill: currentColor;
		shape-rendering: crispEdges;
		flex: none;
	}

	/* header */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--paper);
		border-bottom: 1px solid var(--rule);
	}
	.header-row {
		display: flex;
		align-items: center;
		gap: 24px;
		height: 68px;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 8px;
		font-weight: 800;
		font-size: 1.3rem;
		color: var(--pine);
		text-decoration: none;
	}
	.site-header nav {
		display: flex;
		gap: 20px;
		margin-left: auto;
	}
	.site-header nav a {
		color: var(--ink-2);
		text-decoration: none;
		font-weight: 700;
	}
	.site-header nav a:hover {
		color: var(--ink);
	}
	@media (max-width: 640px) {
		.site-header nav {
			display: none;
		}
		.header-row > .btn {
			margin-left: auto;
		}
	}

	/* buttons */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		min-height: 50px;
		padding: 0 22px;
		border-radius: 10px;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
		transition: transform 80ms, box-shadow 80ms;
	}
	.btn:active {
		transform: translateY(2px);
	}
	.btn-go {
		background: var(--pine);
		color: #fff;
		box-shadow: 0 3px 0 var(--pine-deep);
	}
	.btn-go:active {
		box-shadow: 0 1px 0 var(--pine-deep);
	}
	.btn-white {
		background: var(--card);
		color: var(--ink);
		box-shadow: inset 0 0 0 1px var(--rule), 0 2px 0 var(--rule);
	}
	.btn-honey {
		background: var(--honey);
		color: var(--ink);
		box-shadow: 0 3px 0 var(--honey-d);
	}
	.btn-honey:active {
		box-shadow: 0 1px 0 var(--honey-d);
	}
	.btn-sm {
		min-height: 40px;
		padding: 0 14px;
		border-radius: 8px;
		font-size: 15px;
	}

	/* hero */
	.hero {
		padding: 64px 0 40px;
	}
	.hero-row {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		align-items: center;
		gap: 40px;
	}
	.hero h1 {
		font-size: clamp(2.4rem, 6vw, 4rem);
		margin: 0 0 1.25rem;
	}
	.hl {
		background: linear-gradient(transparent 55%, var(--honey) 55%);
		padding: 0 0.1em;
	}
	.hl-ice {
		background: linear-gradient(transparent 55%, var(--pine) 55%);
	}
	.sub {
		font-size: 1.15rem;
		color: var(--ink-2);
		max-width: 32em;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 1.5rem 0;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 12px;
		border-radius: 999px;
		background: var(--card);
		box-shadow: inset 0 0 0 1px var(--rule);
		font-size: 15px;
		font-weight: 700;
	}
	.chip .pi {
		color: var(--pine);
		width: 0.85em;
	}
	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.mascot {
		width: 100%;
		height: auto;
		image-rendering: pixelated;
	}
	@media (max-width: 820px) {
		.hero-row {
			grid-template-columns: 1fr;
		}
		.mascot {
			max-width: 440px;
			margin: 0 auto;
		}
	}

	/* 섹션 경계 픽셀 디더 */
	.dither {
		height: 16px;
		background: repeating-conic-gradient(var(--to) 0 25%, var(--from) 0 50%) 0 0 / 16px 16px;
	}

	/* sections */
	.section {
		padding: 72px 0;
	}
	.eyebrow {
		font-weight: 700;
		font-size: 14px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--pine);
		margin-bottom: 0.5rem;
	}
	.night {
		background: var(--night);
		color: var(--night-ink);
	}
	.night .eyebrow {
		color: var(--honey);
	}
	.steps {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 16px;
		counter-reset: step;
	}
	.steps li {
		background: var(--night-2);
		border-radius: 14px;
		padding: 24px;
	}
	.steps p {
		color: var(--night-ink-2);
	}
	.n {
		display: inline-grid;
		place-items: center;
		width: 36px;
		height: 36px;
		margin-bottom: 14px;
		border-radius: 8px;
		background: var(--honey);
		color: var(--ink);
		font-weight: 700;
	}

	.pine-band {
		background: var(--pine-deep);
		color: #fff;
	}
	.pine-band .eyebrow {
		color: var(--ice);
	}
	.tiles {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 16px;
	}
	.tile {
		background: var(--card);
		color: var(--ink);
		border-radius: 14px;
		padding: 24px;
		box-shadow: 0 4px 0 rgb(0 0 0 / 0.25);
	}
	.tile p {
		color: var(--ink-2);
	}
	.tile-icon {
		display: inline-grid;
		place-items: center;
		width: 48px;
		height: 48px;
		margin-bottom: 14px;
		border-radius: 10px;
		font-size: 24px;
	}
	.t0 {
		background: var(--ice);
		color: var(--pine-deep);
	}
	.t1 {
		background: var(--honey);
		color: var(--ink);
	}
	.t2 {
		background: var(--berry);
		color: #fff;
	}
	.t3 {
		background: var(--pine);
		color: #fff;
	}

	.paper-2 {
		background: var(--paper-2);
	}
	.trips {
		display: grid;
		gap: 12px;
	}
	.trip {
		display: grid;
		grid-template-columns: 6.5rem 1fr auto;
		align-items: center;
		gap: 16px;
		background: var(--card);
		border-radius: 14px;
		padding: 20px 24px;
		box-shadow: inset 0 0 0 1px var(--rule), 0 2px 0 var(--rule);
	}
	.trip time {
		font-family: 'Bricolage Grotesque', system-ui, sans-serif;
		font-weight: 800;
		font-size: 1.2rem;
		color: var(--pine);
	}
	.trip p {
		color: var(--ink-2);
	}
	.tag {
		padding: 4px 10px;
		border-radius: 999px;
		background: var(--ice);
		font-size: 14px;
		font-weight: 700;
	}
	@media (max-width: 560px) {
		.trip {
			grid-template-columns: 1fr auto;
		}
		.trip time {
			grid-column: 1 / -1;
		}
	}

	.faq-wrap {
		max-width: 760px;
	}
	details {
		background: var(--card);
		border-radius: 12px;
		box-shadow: inset 0 0 0 1px var(--rule);
		padding: 18px 22px;
		margin-bottom: 10px;
	}
	summary {
		cursor: pointer;
		font-weight: 700;
	}
	details p {
		margin-top: 10px;
		color: var(--ink-2);
	}

	.final {
		padding: 0 0 72px;
	}
	.final-inner {
		text-align: center;
	}
	.final-inner h2 {
		margin-bottom: 0.75rem;
	}
	.final-inner p {
		color: var(--ink-2);
		margin-bottom: 1.5rem;
	}

	.site-footer {
		background: var(--night);
		color: var(--night-ink-2);
		padding: 28px 0;
		font-size: 15px;
	}
	.footer-row {
		display: flex;
		justify-content: space-between;
	}
	.site-footer a {
		color: var(--night-ink);
	}
	:focus-visible {
		outline: 3px solid var(--honey);
		outline-offset: 2px;
	}
</style>
