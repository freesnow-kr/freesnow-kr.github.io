---
import { club } from '../data/club';
import Meta from '../components/Meta.astro';
import '../styles/ride.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // 끝 슬래시 없이 (scripts/session.ts 참고)
// 운영진 화면. 주소를 숨기는 건 보안이 아님 — 권한은 전부 서버(backend/src/admin.ts)가 확인
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<Meta title={`${club.name} — Admin`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/`}>FREE SNOW</a>
			<nav id="site-nav" aria-label="메인">
				<a href={`${base}/#season`}>SEASON</a>
				<a href={`${base}/board/`}>BOARD</a>
				<a href={`${base}/gallery/`}>GALLERY</a>
				<a href={`${base}/webcam/`}>WEBCAM</a>
				<a href={`${base}/rank/`}>CHAT RANK</a>
				<a href={`${base}/shredlog/`}>SHRED LOG</a>
				<a href={`${base}/seasonroom/`}>RIDE &amp; STAY</a>
			</nav>
			<a class="nav-join" href={`${base}/login/`}>LOGIN</a>
			<button class="nav-menu" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="site-nav">☰</button>
		</header>

		<main>
			<section class="mem-intro">
				<p class="kicker">STAFF ONLY</p>
				<h1>ADMIN.</h1>
			</section>

			<section class="mem-body">
				<p class="mem-msg loading">불러오는 중…</p>
				<div class="adm" hidden>
					<!-- 요약 칩: 가입 대기가 있으면 주황, 누르면 그 탭으로 -->
					<div class="stats">
						<button type="button" class="stat" data-go="members">활동 회원 <b class="stat-active">-</b><span class="stat-total"></span></button>
						<button type="button" class="stat" data-go="signups">가입 대기 <b class="stat-pending">-</b></button>
					</div>
					<div class="tabs" role="tablist">
						<button type="button" data-tab="signups">가입 신청</button>
						<button type="button" data-tab="members">회원</button>
						<button type="button" data-tab="room">시즌방 정산</button>
						<button type="button" data-tab="owners">시즌방 주주</button>
						<button type="button" data-tab="chat">채팅 랭킹</button>
						<button type="button" data-tab="photos">사진 보관</button>
						<button type="button" data-tab="logins">로그인 이력</button>
						<button type="button" data-tab="teams">조 편성</button>
						<button type="button" data-tab="audit" class="admin-only">운영 기록</button>
					</div>

					<section class="panel" data-panel="signups">
						<p class="hint">승인하면 회원이 되고, 아이디(010 뺀 번호) + 생년월일 8자리로 처음 한 번 로그인해서 새 비밀번호를 정해요.</p>
						<div class="scroll"><table><thead><tr><th>No</th><th>신청일</th><th>이름</th><th>성별</th><th>생년월일</th><th>지역</th><th>연락처</th><th></th></tr></thead><tbody class="signup-rows"></tbody></table></div>
					</section>

					<section class="panel" data-panel="members" hidden>
						<div class="member-tools">
							<input class="search" type="search" placeholder="이름·연락처·지역으로 찾기" />
							<button class="btn-mini ink member-export" type="button">엑셀 다운로드</button>
						</div>
						<p class="hint">비밀번호 초기화(운영진 이상, 관리자 계정은 관리자만): 그 회원의 로그인이 모두 끊기고 72시간 동안 공용 초기화 비밀번호로만 들어올 수 있어요.</p>
						<div class="scroll"><table><thead><tr><th>No</th><th>이름</th><th>연락처</th><th>지역</th><th>거주지</th><th>권한</th><th>상태</th><th>최근 로그인</th><th>비밀번호</th><th></th></tr></thead><tbody class="member-rows"></tbody></table></div>
					</section>

					<section class="panel" data-panel="room" hidden>
						<p class="hint">모든 회원의 시즌방 사용 이력 (숙박 1박 10,000원 · 4시간 휴식 5,000원, 시즌방 주주는 0원). 회원 본인 것은 각자 마이페이지에서 봐요.</p>
						<div class="row room-pick"><select class="room-season"></select><select class="room-month"></select></div>
						<div class="scroll"><table><thead><tr><th>No</th><th>날짜</th><th>이름</th><th>구분</th><th>금액</th></tr></thead><tbody class="room-rows"></tbody><tfoot><tr><th></th><th>합계</th><th></th><th class="room-sum"></th><th class="room-won"></th></tr></tfoot></table></div>
					</section>

					<section class="panel" data-panel="owners" hidden>
						<p class="hint">시즌마다 주주를 정해요(주주는 그 시즌 시즌방 정산이 0원). 바꾸면 바로 저장돼요.</p>
						<div class="owner-cards"></div>
						<p class="owner-msg" role="status"></p>
					</section>

					<!-- 조 편성: 정모·체육대회 때 임시로 조 짜 보기 (점수판은 사용자 요청으로 뺌), 저장은 선택 -->
					<section class="panel" data-panel="teams" hidden>
						<div class="tm-top">
							<select class="tm-pick" aria-label="행사"></select>
							<button class="btn-mini tm-new" type="button">+ 새 행사</button>
							<span class="tm-dirty" hidden>저장 안 됨</span>
							<button class="btn-mini ink tm-save" type="button">저장</button>
							<button class="btn-mini tm-del" type="button">지우기</button>
						</div>
						<div class="tm-meta">
							<label>행사 이름 <input class="tm-title" maxlength="60" placeholder="예: 가을 체육대회" /></label>
							<label>날짜 <input class="tm-date" type="date" /></label>
						</div>
						<!-- 시안 A: 왼쪽 명단 체크, 오른쪽에 바로 조 (단계 탭 없음) -->
						<div class="tm-split">
							<div class="tm-roster">
								<input class="tm-find" type="search" placeholder="이름·지역 찾기" />
								<div class="tm-row">
									<span class="tm-n"></span>
									<button class="btn-mini tm-all" type="button">전체</button>
									<button class="btn-mini tm-none" type="button">해제</button>
								</div>
								<ul class="tm-members"></ul>
								<div class="tm-row tm-guest">
									<input class="tm-gname" maxlength="20" placeholder="게스트 이름 (회원 아닌 참가자)" />
									<select class="tm-ggender" aria-label="게스트 성별"><option value="">성별</option><option>남</option><option>여</option></select>
									<button class="btn-mini ink tm-gadd" type="button">추가</button>
								</div>
								<div class="tm-guests"></div>
							</div>
							<div class="tm-board">
								<div class="tm-row tm-setbar">
									<label><input class="tm-count" type="number" min="2" max="12" value="4" aria-label="조 수" /> 조</label>
									<label class="tm-opt"><input class="tm-g" type="checkbox" checked /> 성별 고르게</label>
									<label class="tm-opt"><input class="tm-s" type="checkbox" checked /> 운영진 나눠서</label>
									<button class="btn-mini ink tm-auto" type="button">자동 편성 ↻</button>
								</div>
								<p class="hint">이름을 누르면 다른 조로 옮기거나 조장으로 정할 수 있어요. 조장은 자동 편성을 다시 해도 그 조에 그대로 있어요.</p>
								<div class="tm-teams"></div>
							</div>
						</div>

					</section>

					<section class="panel" data-panel="chat" hidden>
						<p class="hint">카카오톡 오픈채팅방 → 대화 내보내기(CSV) 파일을 고르면, 이 브라우저에서 닉네임별 메시지 수만 세서 올려요. 대화 내용은 서버로 가지 않아요. 전체 기록이라 가장 최근 파일 하나면 돼요.</p>
						<input class="chat-file" type="file" accept=".csv,text/csv,.txt" />
						<p class="chat-msg" role="status"></p>
					</section>

					<section class="panel" data-panel="photos" hidden>
						<p class="hint">회원이 올린 사진은 Cloudflare에 원본으로 저장돼요. 이번·지난 시즌만 남기고, 그보다 오래된 시즌은 구글 드라이브 '프리스노우 시즌' 폴더로 옮겨요(매일 자동으로 조금씩, 아래 버튼으로 바로).</p>
						<p class="photo-ready hint"></p>
						<div class="scroll"><table><thead><tr><th>시즌</th><th>Cloudflare</th><th>드라이브</th><th></th></tr></thead><tbody class="photo-rows"></tbody></table></div>
						<p class="photo-msg" role="status"></p>
					</section>

					<section class="panel" data-panel="logins" hidden>
						<p class="hint">최근 300건. IP는 앞부분만 저장해요. 90일 지나면 자동으로 지워져요.</p>
						<div class="scroll"><table><thead><tr><th>시각</th><th>이름</th><th>결과</th><th>IP</th><th>브라우저</th></tr></thead><tbody class="login-rows"></tbody></table></div>
					</section>

					<section class="panel" data-panel="audit" hidden>
						<div class="scroll"><table><thead><tr><th>시각</th><th>누가</th><th>무엇을</th><th>내용</th></tr></thead><tbody class="audit-rows"></tbody></table></div>
					</section>
				</div>

				<dialog class="status-dlg">
					<form method="dialog" class="status-form">
						<h2 class="status-who">상태</h2>
						<label class="st"><input type="radio" name="st" value="active" /> 활동</label>
						<label class="st"><input type="radio" name="st" value="suspended" /> 정지 <small>잠시 로그인 막기</small></label>
						<label class="st"><input type="radio" name="st" value="withdrawn" /> 탈퇴 <small>기록은 그대로 두고 로그인 막기</small></label>
						<div class="edit-btns">
							<button class="btn btn-line-dark" value="cancel" formnovalidate>닫기</button>
							<button class="btn btn-ink" value="save">저장</button>
						</div>
					</form>
				</dialog>

				<dialog class="edit">
					<form method="dialog" class="edit-form">
						<h2>회원 정보 수정</h2>
						<label>이름 <input name="name" required /></label>
						<label>연락처 <input name="phone" inputmode="numeric" required /></label>
						<label>성별 <select name="gender"><option value="">-</option><option>남</option><option>여</option></select></label>
						<label>생년월일 <input name="birth" placeholder="1996-02-12" /></label>
						<label>지역 <input name="region" placeholder="경기북부, 서울 …" /></label>
						<label>거주지 <input name="area" /></label>
						<label>비공개 연락처 <input name="private_contact" /></label>
						<fieldset class="admin-only">
							<label>권한 <select name="role"><option value="member">회원</option><option value="master">마스터 (명예)</option><option value="staff">운영진</option><option value="admin">관리자</option></select></label>
						</fieldset>
						<p class="edit-error" role="alert"></p>
						<div class="edit-btns">
							<button class="btn btn-line-dark" value="cancel" formnovalidate>닫기</button>
							<button class="btn btn-ink edit-save" value="save">저장</button>
						</div>
					</form>
				</dialog>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-row">
				<a href={`${base}/members/`}>MEMBERS로</a>
				<span>{club.footer}</span>
			</div>
			<p class="giant" aria-hidden="true">FREE SNOW</p>
		</footer>

		<script>
			import { call, loginUrl, store } from '../scripts/session';
			import { parseChat } from '../scripts/chat';

			const $ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => root.querySelector<T>(s)!;
			const token = store.get();
			const back = `${loginUrl}?next=${encodeURIComponent(location.pathname)}`;
			const ROLE: Record<string, string> = { member: '회원', master: '마스터', staff: '운영진', admin: '관리자' };
			const STATUS: Record<string, string> = { active: '활동', suspended: '정지', withdrawn: '탈퇴' };
			const when = (iso: string | null) => (iso ? new Date(iso).toLocaleString('ko-KR', { dateStyle: 'short', timeStyle: 'short' }) : '-');
			const phone = (d: string) => (d?.length === 11 ? `${d.slice(0, 3)}-${d.slice(3, 7)}-${d.slice(7)}` : d ?? '');
			let role = 'staff';

			// 서버 호출: 만료면 로그인으로, 실패면 알림 후 null
			async function api(action: string, body: object = {}) {
				const res = await call({ action, token, ...body }).catch(() => null);
				if (res?.expired) {
					store.clear();
					location.replace(`${back}&expired`);
					return null;
				}
				if (!res?.ok) {
					alert(res?.error ?? '서버에 연결하지 못했어요. 잠시 뒤 다시 시도해 주세요.');
					return null;
				}
				return res;
			}
			// 표 한 줄: 글자는 textContent로만 (HTML 주입 방지), 노드는 그대로
			const tr = (cells: (string | Node)[]) => {
				const row = document.createElement('tr');
				for (const c of cells) {
					const td = document.createElement('td');
					td.append(c);
					row.append(td);
				}
				return row;
			};
			const button = (text: string, onClick: () => void, cls = 'btn-mini') => {
				const b = document.createElement('button');
				b.type = 'button';
				b.className = cls;
				b.textContent = text;
				b.addEventListener('click', onClick);
				return b;
			};
			const empty = (body: HTMLElement, cols: number, text: string) => {
				const row = tr([text]);
				(row.firstChild as HTMLTableCellElement).colSpan = cols;
				body.replaceChildren(row);
			};

			async function loadSignups() {
				const res = await api('admin.signups');
				if (!res) return;
				const body = $('.signup-rows');
				if (!res.signups.length) return empty(body, 8, '대기 중인 신청이 없어요.');
				body.replaceChildren(
					...res.signups.map((s: any, i: number) => {
						const decide = async (approve: boolean) => {
							if (!confirm(`${s.name} 님 신청을 ${approve ? '승인' : '거절'}할까요?`)) return;
							if (await api('admin.signupDecide', { id: s.id, approve })) Promise.all([loadSignups(), loadSummary()]);
						};
						const btns = document.createElement('span');
						btns.className = 'btns';
						btns.append(button('승인', () => decide(true), 'btn-mini ink'), button('거절', () => decide(false)));
						return tr([String(i + 1), when(s.created_at), s.name, s.gender ?? '', s.birth ?? '', `${s.sido} ${s.area}`, phone(s.phone), btns]);
					}),
				);
			}

			let members: any[] = [];
			async function loadMembers() {
				const res = await api('admin.members');
				if (!res) return;
				members = res.members;
				drawMembers();
				drawOwners();
			}
			function drawMembers() {
				const q = $<HTMLInputElement>('.search').value.trim().replace(/-/g, '');
				const list = members.filter((m) => !q || [m.name, m.phone, m.region, m.area].join(' ').includes(q));
				const body = $('.member-rows');
				if (!list.length) return empty(body, 10, '없어요.');
				body.replaceChildren(
					...list.map((m, i) => {
						const btns = document.createElement('span');
						btns.className = 'btns';
						btns.append(button('수정', () => edit(m)));
						// 비밀번호 초기화: 운영진 이상 (관리자 계정은 관리자만 — 서버도 확인)
						if (m.role !== 'admin' || role === 'admin')
							btns.append(
								button('비번 초기화', async () => {
									if (!confirm(`${m.name} 님 비밀번호를 초기화할까요? 지금 로그인도 모두 끊겨요.`)) return;
									const r = await api('admin.reset', { memberId: m.id });
									if (r) alert(`초기화했어요. ${new Date(r.resetUntil).toLocaleString('ko-KR')}까지 공용 초기화 비밀번호로 로그인하면 새 비밀번호를 정하게 돼요.`), loadMembers();
								}),
							);
						// 상태 변경: 운영진 이상 (관리자 계정은 관리자만 — 서버도 확인)
						if (m.role !== 'admin' || role === 'admin') btns.append(button('상태 변경', () => changeStatus(m)));
						const pw = m.reset_pending ? '초기화 대기' : m.password_changed ? '설정함' : '첫 로그인 전';
						const row = tr([String(i + 1), m.name, phone(m.phone), m.region, m.area, ROLE[m.role], statusBadge(m.status), when(m.last_login), pw, btns]);
						if (m.status !== 'active') row.className = 'off';
						return row;
					}),
				);
			}
			$('.search').addEventListener('input', drawMembers);

			// TODO(2026-10-23, 사용자): 엑셀 양식(열 구성·순서·서식, CSV → .xlsx 여부)은 나중에 다시 정하기로 함 — 지금은 임시 양식
			// 회원 명부 내려받기: 엑셀에서 바로 열리는 CSV (UTF-8 BOM으로 한글 안 깨짐, 연락처는 하이픈 넣어 앞 0 유지)
			// 서버에 export: true로 다시 받아서 운영 기록을 남김 (개인정보)
			$('.member-export').addEventListener('click', async () => {
				const res = await api('admin.members', { export: true });
				if (!res) return;
				const cell = (v: unknown) => {
					let t = v == null ? '' : String(v);
					if (/^[=+\-@]/.test(t)) t = "'" + t; // 엑셀 수식으로 안 읽히게
					return /[",\n]/.test(t) ? `"${t.replace(/"/g, '""')}"` : t;
				};
				const day = (iso: string | null) => (iso ? new Date(iso).toLocaleDateString('sv-SE') : '');
				const head = ['No', '이름', '연락처', '성별', '생년월일', '지역', '거주지', '비공개연락처', '권한', '상태', '가입일', '최근 로그인'];
				const rows = res.members.map((m: any, i: number) => [i + 1, m.name, phone(m.phone), m.gender, m.birth, m.region, m.area, m.private_contact, ROLE[m.role], STATUS[m.status], day(m.joined_at), day(m.last_login)]);
				const csv = '\uFEFF' + [head, ...rows].map((r) => r.map(cell).join(',')).join('\r\n');
				const a = document.createElement('a');
				a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
				a.download = `프리스노우_회원명부_${new Date().toLocaleDateString('sv-SE')}.csv`;
				a.click();
				URL.revokeObjectURL(a.href);
			});

			// 상태는 표에 글자(배지)로, 바꾸기는 '상태 변경' 버튼 → 작은 창에서 고르기
			const statusBadge = (st: string) => {
				const b = document.createElement('span');
				b.className = `status-badge s-${st}`;
				b.textContent = STATUS[st];
				return b;
			};
			const statusDlg = $<HTMLDialogElement>('.status-dlg');
			let statusFor: any = null;
			function changeStatus(m: any) {
				statusFor = m;
				$('.status-who').textContent = `${m.name} 님 상태`;
				statusDlg.querySelectorAll<HTMLInputElement>('input[name=st]').forEach((x) => (x.checked = x.value === m.status));
				statusDlg.showModal();
			}
			statusDlg.querySelector('form')!.addEventListener('submit', async (e) => {
				if ((e.submitter as HTMLButtonElement)?.value !== 'save') return;
				e.preventDefault();
				const next = statusDlg.querySelector<HTMLInputElement>('input[name=st]:checked')?.value;
				if (!next || next === statusFor.status) return statusDlg.close();
				if (next !== 'active' && !confirm(`${statusFor.name} 님을 '${STATUS[next]}'(으)로 바꾸면 지금 로그인이 끊기고 다시 로그인할 수 없어요. 바꿀까요?`)) return;
				const r = await api('admin.memberStatus', { id: statusFor.id, status: next });
				if (!r) return;
				statusDlg.close();
				loadMembers();
				loadSummary();
			});

			// 수정 창: 운영진은 정보만, 마스터는 권한·상태도
			const dialog = $<HTMLDialogElement>('.edit');
			const form = $<HTMLFormElement>('.edit-form');
			let editing: any = null;
			function edit(m: any) {
				editing = m;
				for (const k of ['name', 'phone', 'gender', 'birth', 'region', 'area', 'private_contact', 'role']) (form.elements.namedItem(k) as HTMLInputElement).value = m[k] ?? '';
				$('.edit-error').textContent = '';
				dialog.showModal();
			}
			form.addEventListener('submit', async (e) => {
				if ((e.submitter as HTMLButtonElement)?.value !== 'save') return;
				e.preventDefault();
				const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
				const { role: newRole, ...info } = d;
				const status = editing.status; // 상태는 '상태 변경' 버튼에서
				const r1 = await call({ action: 'admin.memberUpdate', token, id: editing.id, ...info }).catch(() => null);
				if (!r1?.ok) return void ($('.edit-error').textContent = r1?.error ?? '저장하지 못했어요.');
				// 권한은 관리자만 (서버가 다시 확인)
				const roleNext = role === 'admin' ? newRole : editing.role;
				if (roleNext !== editing.role) {
					const r2 = await call({ action: 'admin.memberStatus', token, id: editing.id, role: roleNext, status }).catch(() => null);
					if (!r2?.ok) return void ($('.edit-error').textContent = r2?.error ?? '권한·상태를 저장하지 못했어요.');
				}
				dialog.close();
				loadMembers();
			});

			// 시즌방 주주 (사용자가 고른 시안 D): 이번·지난·지지난 시즌을 카드로 나란히, ✕로 빼고 '+ 주주 더하기'로 더함, 바로 저장
			// 이번 시즌 카드엔 '지난 시즌 주주 그대로 가져오기'
			const ownerSeasons = (() => {
				const now = new Date();
				const cur = (now.getMonth() >= 6 ? now.getFullYear() : now.getFullYear() - 1) % 100;
				return [cur, cur - 1, cur - 2].map((a) => `${a}-${a + 1}`);
			})();
			const owners: Record<string, Set<string>> = {};
			async function loadOwners() {
				const all = await Promise.all(ownerSeasons.map((season) => api('admin.roomOwners', { season })));
				all.forEach((r, i) => r && (owners[ownerSeasons[i]] = new Set(r.memberIds)));
				drawOwners();
			}
			async function saveOwners(season: string, ids: string[], done: string) {
				const r = await api('admin.roomOwners', { season, memberIds: ids });
				if (!r) return;
				owners[season] = new Set(r.memberIds);
				$('.owner-msg').textContent = done;
				drawOwners();
			}
			function drawOwners() {
				const name = (id: string) => members.find((m) => m.id === id)?.name ?? '(지운 회원)';
				$('.owner-cards').replaceChildren(
					...ownerSeasons.map((season, si) => {
						const own = owners[season];
						const card = document.createElement('section');
						card.className = 'owner-card' + (si === 0 ? ' now' : '');
						const h = document.createElement('h3');
						const big = document.createElement('span');
						big.textContent = season;
						const tag = document.createElement('small');
						tag.textContent = si === 0 ? '이번 시즌' : '지난 시즌';
						h.append(big, tag);
						const cnt = document.createElement('p');
						cnt.className = 'owner-count';
						cnt.textContent = own ? `주주 ${own.size}명` : '불러오는 중…';
						card.append(h, cnt);
						if (!own) return card;
						const ul = document.createElement('ul');
						ul.append(
							...[...own].map((id) => {
								const li = document.createElement('li');
								const nm = document.createElement('span');
								nm.textContent = name(id);
								const x = document.createElement('button');
								x.type = 'button';
								x.className = 'owner-x';
								x.textContent = '✕';
								x.ariaLabel = `${name(id)} 빼기`;
								x.addEventListener('click', () => saveOwners(season, [...own].filter((v) => v !== id), `${season} 주주에서 ${name(id)} 님을 뺐어요.`));
								li.append(nm, x);
								return li;
							}),
						);
						if (!own.size) {
							const li = document.createElement('li');
							li.className = 'empty';
							li.textContent = '주주가 없어요.';
							ul.append(li);
						}
						const add = document.createElement('select');
						add.className = 'owner-add';
						add.ariaLabel = `${season} 주주 더하기`;
						add.append(new Option('+ 주주 더하기', ''), ...members.filter((m) => m.status === 'active' && !own.has(m.id)).map((m) => new Option(`${m.name} (${m.region || m.area || '-'})`, m.id)));
						add.addEventListener('change', () => add.value && saveOwners(season, [...own, add.value], `${season} 주주에 ${name(add.value)} 님을 더했어요.`));
						card.append(ul, add);
						const prev = ownerSeasons[si + 1];
						if (si === 0 && prev && owners[prev]) {
							const copy = document.createElement('button');
							copy.type = 'button';
							copy.className = 'owner-copy';
							copy.textContent = `${prev} 주주 그대로 가져오기`;
							copy.addEventListener('click', () => {
								if (!confirm(`${season} 주주를 ${prev} 주주 ${owners[prev].size}명으로 바꿀까요?`)) return;
								saveOwners(season, [...owners[prev]], `${prev} 주주 ${owners[prev].size}명을 ${season}에 가져왔어요.`);
							});
							card.append(copy);
						}
						return card;
					}),
				);
			}

			// ── 조 편성 ──
			type Person = { key: string; name: string; gender: string; memberId?: string; staff?: boolean; guest?: boolean; leader?: boolean; team: number };
			type Ev = { id?: string; title: string; date: string; data: { teams: { name: string }[]; people: Person[] } };
			let ev: Ev | null = null;
			let tmEvents: any[] = [];
			const blank = (): Ev => ({ title: '', date: new Date().toLocaleDateString('sv-SE'), data: { teams: [], people: [] } });
			const dirty = (on = true) => ($('.tm-dirty').hidden = !on);
			const tmTeamColor = ['#ff5a1f', '#2f6df6', '#1e9e5a', '#a64ce0', '#e0245e', '#d49b00', '#0aa5b8', '#6b6d73', '#8a4b20', '#3b3f8f', '#c76e00', '#2d7d2d'];

			async function loadTeams() {
				if (!members.length) await loadMembers();
				const r = await api('admin.teams.list');
				if (!r) return;
				tmEvents = r.events;
				const pick = $<HTMLSelectElement>('.tm-pick');
				pick.replaceChildren(new Option('행사 고르기', ''), ...tmEvents.map((e) => new Option(`${e.date} ${e.title} (${e.people}명)`, e.id)));
				if (ev?.id) pick.value = ev.id;
				if (!ev) (ev = blank()), drawEvent();
			}
			$('.tm-pick').addEventListener('change', async (e) => {
				const id = (e.target as HTMLSelectElement).value;
				if (!id) return;
				const r = await api('admin.teams.get', { id });
				if (!r) return;
				ev = r.event;
				drawEvent();
				dirty(false);
			});
			$('.tm-new').addEventListener('click', () => {
				ev = blank();
				$<HTMLSelectElement>('.tm-pick').value = '';
				drawEvent();
				dirty(false);
			});
			$('.tm-save').addEventListener('click', async () => {
				ev!.title = $<HTMLInputElement>('.tm-title').value;
				ev!.date = $<HTMLInputElement>('.tm-date').value;
				const r = await api('admin.teams.save', { id: ev!.id, title: ev!.title, date: ev!.date, data: ev!.data });
				if (!r) return;
				ev!.id = r.id;
				dirty(false);
				loadTeams();
			});
			$('.tm-del').addEventListener('click', async () => {
				if (!ev?.id) return void ((ev = blank()), drawEvent());
				if (!confirm(`'${ev.title}' 행사를 지울까요?`)) return;
				if (await api('admin.teams.delete', { id: ev.id })) (ev = null), loadTeams();
			});
			$('.tm-title').addEventListener('input', () => dirty());
			$('.tm-date').addEventListener('input', () => dirty());
			const genderCount = (list: Person[]) => {
				const m = list.filter((p) => p.gender === '남').length, f = list.filter((p) => p.gender === '여').length;
				return `${list.length}명${m || f ? ` (남 ${m} · 여 ${f})` : ''}`;
			};
			const asPerson = (m: any): Person => ({ key: `m:${m.id}`, name: m.name, gender: m.gender ?? '', memberId: m.id, staff: m.role === 'staff' || m.role === 'admin', team: -1 });
			const genderDot = (g: string) => {
				const s = document.createElement('span');
				s.className = 'tm-dot' + (g === '남' ? ' m' : g === '여' ? ' f' : '');
				return s;
			};

			function drawEvent() {
				$<HTMLInputElement>('.tm-title').value = ev!.title;
				$<HTMLInputElement>('.tm-date').value = ev!.date;
				drawPeople();
				drawSplit();
			}
			const changed = () => (dirty(), drawCount(), drawSplit());
			function drawCount() {
				const active = members.filter((m) => m.status === 'active').length;
				$('.tm-n').textContent = `${genderCount(ev!.data.people)} / ${active}명`;
			}

			// 왼쪽 명단: 활동 회원 체크 + 게스트. 체크할 땐 목록을 다시 그리지 않음(포커스 유지)
			function drawPeople() {
				const d = ev!.data;
				const on = new Set(d.people.filter((p) => p.memberId).map((p) => p.memberId));
				const q = $<HTMLInputElement>('.tm-find').value.trim();
				$('.tm-members').replaceChildren(
					...members
						.filter((m) => m.status === 'active' && (!q || [m.name, m.region, m.area].join(' ').includes(q)))
						.map((m) => {
							const li = document.createElement('li');
							const label = document.createElement('label');
							const cb = document.createElement('input');
							cb.type = 'checkbox';
							cb.checked = on.has(m.id);
							cb.addEventListener('change', () => {
								if (cb.checked) d.people.push(asPerson(m));
								else d.people = d.people.filter((p) => p.memberId !== m.id);
								changed();
							});
							const nm = document.createElement('b');
							nm.textContent = m.name;
							const area = document.createElement('small');
							area.textContent = [m.region, m.area].filter(Boolean).join(' ');
							label.append(cb, genderDot(m.gender), nm, ...(m.role === 'staff' || m.role === 'admin' ? [Object.assign(document.createElement('i'), { textContent: '★' })] : []), area);
							li.append(label);
							return li;
						}),
				);
				$('.tm-guests').replaceChildren(
					...d.people
						.filter((p) => p.guest)
						.map((p) => {
							const t = document.createElement('span');
							t.className = 'tm-chip on guest';
							t.textContent = `${p.name}${p.gender ? ` · ${p.gender}` : ''} (게스트) `;
							const x = document.createElement('button');
							x.type = 'button';
							x.textContent = '✕';
							x.ariaLabel = `${p.name} 빼기`;
							x.addEventListener('click', () => ((d.people = d.people.filter((v) => v !== p)), drawPeople(), changed()));
							t.append(x);
							return t;
						}),
				);
				drawCount();
			}
			$('.tm-find').addEventListener('input', drawPeople);
			$('.tm-all').addEventListener('click', () => {
				const d = ev!.data;
				const have = new Set(d.people.map((p) => p.memberId));
				for (const m of members) if (m.status === 'active' && !have.has(m.id)) d.people.push(asPerson(m));
				drawPeople(), changed();
			});
			$('.tm-none').addEventListener('click', () => ((ev!.data.people = ev!.data.people.filter((p) => p.guest)), drawPeople(), changed()));
			$('.tm-gadd').addEventListener('click', () => {
				const name = $<HTMLInputElement>('.tm-gname').value.trim();
				if (!name) return;
				ev!.data.people.push({ key: `g:${Date.now()}`, name, gender: $<HTMLSelectElement>('.tm-ggender').value, guest: true, team: -1 });
				$<HTMLInputElement>('.tm-gname').value = '';
				drawPeople(), changed();
			});

			// 자동 편성: 인원 → (성별) → (운영진) 순으로 고르게. 조장은 자기 조에 그대로 두고 나머지만 섞음
			function autoSplit() {
				const d = ev!.data;
				const n = Math.max(2, Math.min(12, Number($<HTMLInputElement>('.tm-count').value) || 2));
				d.teams = Array.from({ length: n }, (_, i) => d.teams[i] ?? { name: `${i + 1}조` });
				const byGender = $<HTMLInputElement>('.tm-g').checked, byStaff = $<HTMLInputElement>('.tm-s').checked;
				const shuffle = <T,>(a: T[]) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
				const gkey = (p: Person) => (byGender ? p.gender || '?' : '');
				for (const p of d.people) if (p.leader && p.team >= n) p.leader = false; // 없어진 조의 조장은 풀림
				const fixed = d.people.filter((p) => p.leader);
				// 성별 묶음마다(큰 묶음부터) 운영진 먼저 → 그 성별이 가장 적은 조 → 운영진이 가장 적은 조 → 인원이 가장 적은 조 (같으면 무작위)
				const size = new Array(n).fill(0), staffN = new Array(n).fill(0);
				for (const p of fixed) size[p.team]++, p.staff && staffN[p.team]++;
				const groups: Record<string, Person[]> = {};
				for (const p of d.people) if (!p.leader) (groups[gkey(p)] ||= []).push(p);
				for (const g of Object.keys(groups).sort((a, b) => groups[b].length - groups[a].length)) {
					const sameN = new Array(n).fill(0);
					for (const p of fixed) if (gkey(p) === g) sameN[p.team]++;
					const list = shuffle(groups[g]).sort((a, b) => (byStaff ? Number(!!b.staff) - Number(!!a.staff) : 0));
					for (const p of list) {
						const t = shuffle([...Array(n).keys()]).sort((a, b) => sameN[a] - sameN[b] || (byStaff && p.staff ? staffN[a] - staffN[b] : 0) || size[a] - size[b])[0];
						p.team = t;
						sameN[t]++;
						size[t]++;
						if (p.staff) staffN[t]++;
					}
				}
				dirty();
				drawSplit();
			}
			$('.tm-auto').addEventListener('click', () => {
				const d = ev!.data;
				if (!d.people.length) return alert('먼저 왼쪽에서 참가자를 골라 주세요.');
				const leaders = d.people.some((p) => p.leader);
				if (d.people.some((p) => p.team >= 0 && !p.leader) && !confirm(leaders ? '조장은 그대로 두고 나머지를 새로 짤까요?' : '지금 편성을 지우고 새로 짤까요?')) return;
				autoSplit();
			});

			// 조 카드: 이름 줄 = 투명한 select를 덮어 둠 → 누르면 옮기기·조장 메뉴(휴대폰은 기본 선택 창)
			function setLeader(p: Person, on: boolean) {
				if (on) for (const o of ev!.data.people) if (o.team === p.team) o.leader = false;
				p.leader = on;
			}
			function drawSplit() {
				const d = ev!.data;
				if (d.teams.length) $<HTMLInputElement>('.tm-count').value = String(d.teams.length);
				const box = $('.tm-teams');
				const waiting = d.people.filter((p) => p.team < 0 || p.team >= d.teams.length);
				// 한 줄에 한 명: 성별 점 · 이름 · (조장/운영진/게스트 꼬리표)
				const row = (p: Person, ti: number) => {
					const c = document.createElement('li');
					c.className = 'tm-person' + (p.leader ? ' leader' : '');
					const nm = document.createElement('b');
					nm.textContent = p.name;
					const tags = [p.leader && '조장', p.staff && '운영진', p.guest && '게스트'].filter(Boolean).map((t) => Object.assign(document.createElement('small'), { textContent: t as string }));
					c.append(genderDot(p.gender), nm, ...tags);
					const mv = document.createElement('select');
					mv.ariaLabel = `${p.name}${p.leader ? ' (조장)' : ''} 옮기기`;
					const head = new Option(`${p.name}`, '');
					head.disabled = true;
					mv.append(head);
					if (ti >= 0) mv.append(new Option(p.leader ? '조장 풀기' : '조장으로 정하기', 'leader'));
					mv.append(...d.teams.map((t, i) => new Option(`${t.name}로 옮기기`, String(i))).filter((_, i) => i !== ti));
					if (ti >= 0) mv.append(new Option('안 나눔으로', '-1'));
					mv.value = '';
					mv.addEventListener('change', () => {
						if (mv.value === 'leader') setLeader(p, !p.leader);
						else {
							const lead = p.leader;
							p.leader = false;
							p.team = Number(mv.value);
							if (lead && p.team >= 0) setLeader(p, true); // 조장은 옮긴 조에서도 조장
						}
						dirty(), drawSplit();
					});
					c.append(mv);
					return c;
				};
				const card = (title: string, list: Person[], ti: number) => {
					const c = document.createElement('section');
					c.className = 'tm-team';
					c.style.setProperty('--tc', ti >= 0 ? tmTeamColor[ti % tmTeamColor.length] : '#8a8d95');
					const h = document.createElement('div');
					h.className = 'tm-team-head';
					if (ti >= 0) {
						const nm = document.createElement('input');
						nm.value = title;
						nm.maxLength = 20;
						nm.ariaLabel = '조 이름';
						nm.addEventListener('input', () => ((d.teams[ti].name = nm.value || `${ti + 1}조`), dirty()));
						h.append(nm);
					} else h.append(document.createTextNode(title));
					const cnt = document.createElement('small');
					cnt.textContent = genderCount(list);
					h.append(cnt);
					const ol = document.createElement('ol');
					ol.append(...[...list].sort((a, b) => Number(!!b.leader) - Number(!!a.leader) || Number(!!b.staff) - Number(!!a.staff) || a.name.localeCompare(b.name, 'ko')).map((p) => row(p, ti)));
					c.append(h, ol);
					return c;
				};
				box.replaceChildren(...d.teams.map((t, i) => card(t.name, d.people.filter((p) => p.team === i), i)), ...(waiting.length ? [card('아직 안 나눔', waiting, -1)] : []));
			}

			$('.chat-file').addEventListener('change', async (e) => {
				const f = (e.target as HTMLInputElement).files?.[0];
				if (!f) return;
				const msg = $('.chat-msg');
				msg.textContent = '세는 중…';
				const stats = parseChat(await f.text());
				if (!stats.total) return void (msg.textContent = '메시지를 찾지 못했어요. 카톡 대화 내보내기 CSV가 맞는지 확인해 주세요.');
				msg.textContent = '올리는 중…';
				const res = await api('admin.chatUpload', stats);
				msg.textContent = res ? `올렸어요: ${stats.from} ~ ${stats.to}, 메시지 ${stats.total.toLocaleString()}개, ${stats.ranks.length}명` : '';
			});

			// 사진 보관: 시즌별 Cloudflare/드라이브 장 수, 보관할 수 있는 시즌은 버튼 → 남은 게 없을 때까지 묶음으로 반복
			const mb = (b: number) => `${(b / 1024 / 1024).toFixed(b > 1e8 ? 0 : 1)}MB`;
			async function loadPhotos() {
				const res = await api('admin.photoStatus');
				if (!res) return;
				$('.photo-ready').textContent = res.ready ? '구글 드라이브 연결됨.' : '구글 드라이브가 아직 연결되지 않았어요 — 보관하려면 개발 담당이 backend/scripts/google-auth.mjs로 한 번 연결해야 해요.';
				const by: Record<string, { r2: number; drive: number; bytes: number }> = {};
				for (const r of res.seasons) {
					const x = (by[r.season] ||= { r2: 0, drive: 0, bytes: 0 });
					x[r.storage as 'r2' | 'drive'] = r.n;
					if (r.storage === 'r2') x.bytes = r.bytes;
				}
				const body = $('.photo-rows');
				const seasons = Object.keys(by).sort().reverse();
				if (!seasons.length) return empty(body, 4, '아직 올린 사진이 없어요.');
				body.replaceChildren(
					...seasons.map((s) => {
						const x = by[s];
						const cell = s < res.keepFrom && x.r2 && res.ready
							? button('드라이브로 보관', async () => {
								if (!confirm(`${s} 시즌 사진 ${x.r2}장을 드라이브로 옮길까요? 옮긴 뒤 Cloudflare에서는 지워요.`)) return;
								for (;;) {
									const r = await api('admin.photoArchive', { season: s });
									if (!r) break;
									$('.photo-msg').textContent = `${s}: 옮기는 중… 남은 사진 ${r.remaining}장`;
									if (!r.remaining || !r.moved) break;
								}
								loadPhotos();
							}, 'btn-mini ink')
							: s >= res.keepFrom ? 'Cloudflare에 둠' : '';
						return tr([s, x.r2 ? `${x.r2}장 · ${mb(x.bytes)}` : '-', x.drive ? `${x.drive}장` : '-', cell]);
					}),
				);
			}

			// 시즌방 정산: 시즌(7/1~6/30)을 한 번 받아 달(또는 시즌 전체)별로 사람마다 숙박·휴식·금액
			const roomSeason = $<HTMLSelectElement>('.room-season');
			const roomMonth = $<HTMLSelectElement>('.room-month');
			const roomCache: Record<string, any> = {};
			{
				const now = new Date();
				const cur = (now.getMonth() >= 6 ? now.getFullYear() : now.getFullYear() - 1) % 100;
				for (const s of [cur, cur - 1, cur - 2]) roomSeason.append(new Option(`${s}-${s + 1} 시즌`, `${s}-${s + 1}`));
			}
			const fillMonths = () => {
				const y = 2000 + Number(roomSeason.value.slice(0, 2));
				const now = new Date().toLocaleDateString('sv-SE').slice(0, 7);
				roomMonth.replaceChildren(new Option('시즌 전체', ''), ...Array.from({ length: 12 }, (_, i) => {
					const d = new Date(y, 6 + i, 1);
					const v = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
					return new Option(`${d.getFullYear()}년 ${d.getMonth() + 1}월`, v);
				}));
				roomMonth.value = [...roomMonth.options].some((o) => o.value === now) ? now : '';
			};
			async function loadRoom() {
				const season = roomSeason.value;
				const res = roomCache[season] ?? (roomCache[season] = await api('seasonroom', { season }));
				if (!res) return void delete roomCache[season];
				const price = res.prices ?? { 숙박: 10000, 휴식: 5000 };
				// 날짜순으로 한 줄씩 (사용자 요구: 사람별로 묶지 않음). 같은 날은 이름순 — 서버가 이미 그렇게 정렬해서 줌
				const WD = '일월화수목금토';
				const rows = res.nights.filter((n: any) => !roomMonth.value || n.date.startsWith(roomMonth.value));
				const fee = (n: any) => (n.owner ? 0 : n.kind === '휴식' ? price.휴식 : price.숙박);
				const body = $('.room-rows');
				if (!rows.length) empty(body, 5, '기록이 없어요.');
				else
					body.replaceChildren(
						...rows.map((n: any, i: number) => {
							const [y, m, d] = n.date.split('-').map(Number);
							return tr([String(i + 1), `${m}.${d} (${WD[new Date(y, m - 1, d).getDay()]})`, `${n.name}${n.owner ? ' · 주주' : ''}`, n.kind === '휴식' ? '4시간 휴식' : '숙박', `${fee(n).toLocaleString()}원`]);
						}),
					);
				const stays = rows.filter((n: any) => n.kind !== '휴식').length;
				$('.room-sum').textContent = `숙박 ${stays}박 · 휴식 ${rows.length - stays}회`;
				$('.room-won').textContent = `${rows.reduce((t: number, n: any) => t + fee(n), 0).toLocaleString()}원`;
			}
			roomSeason.addEventListener('change', () => (fillMonths(), loadRoom()));
			roomMonth.addEventListener('change', loadRoom);
			fillMonths();

			async function loadLogins() {
				const res = await api('admin.logins');
				if (!res) return;
				const body = $('.login-rows');
				if (!res.logins.length) return empty(body, 5, '아직 기록이 없어요.');
				const REASON: Record<string, string> = { password: '성공', birth: '성공(첫 로그인)', reset: '성공(초기화)', wrong: '비밀번호 틀림', unknown: '없는 아이디', locked: '잠김', suspended: '정지된 계정', withdrawn: '탈퇴한 계정' };
				body.replaceChildren(...res.logins.map((l: any) => {
					const row = tr([when(l.at), l.name ?? '-', REASON[l.reason] ?? l.reason ?? '', l.ip_masked ?? '', (l.ua ?? '').slice(0, 60)]);
					if (!l.ok) row.className = 'off';
					return row;
				}));
			}
			async function loadAudit() {
				const res = await api('admin.audit');
				if (!res) return;
				const body = $('.audit-rows');
				if (!res.logs.length) return empty(body, 4, '아직 기록이 없어요.');
				body.replaceChildren(...res.logs.map((l: any) => tr([when(l.at), l.actor ?? '-', l.action, (l.detail ?? '').slice(0, 200)])));
			}
			async function loadSummary() {
				const res = await api('admin.summary');
				if (!res) return null;
				role = res.role;
				$('.stat-active').textContent = String(res.active);
				$('.stat-total').textContent = ` / ${res.total}`;
				$('.stat-pending').textContent = String(res.pending);
				$('.stat-pending').closest('.stat')!.classList.toggle('is-todo', res.pending > 0);
				return res;
			}

			// 탭: 처음 열 때 불러옴
			const loaders: Record<string, () => unknown> = { signups: loadSignups, members: loadMembers, room: loadRoom, owners: loadOwners, teams: loadTeams, chat: () => {}, photos: loadPhotos, logins: loadLogins, audit: loadAudit };
			const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs button')];
			const open = (name: string) => {
				tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === name)));
				document.querySelectorAll<HTMLElement>('.panel').forEach((p) => (p.hidden = p.dataset.panel !== name));
				loaders[name]();
			};
			tabs.forEach((t) => t.addEventListener('click', () => open(t.dataset.tab!)));
			document.querySelectorAll<HTMLButtonElement>('.stat').forEach((b) => b.addEventListener('click', () => open(b.dataset.go!)));

			if (!token) location.replace(back);
			else if (await loadSummary()) {
				$('.loading').remove();
				$('.adm').hidden = false;
				document.querySelectorAll<HTMLElement>('.admin-only').forEach((el) => (el.hidden = role !== 'admin'));
				await loadMembers(); // 주주 체크 목록에도 씀
				open('signups');
			} else $('.loading').textContent = '운영진만 볼 수 있어요.';
		</script>
	</body>
</html>

