---
import { club, trips, faqs } from '../data/club';
import '../styles/ride.css';

const base = import.meta.env.BASE_URL;

const ticker = ['SKI', 'SNOWBOARD', 'CARPOOL', 'NIGHT RIDE', 'APRÈS', 'FIRST CHAIR'];

const disciplines = [
	{ name: 'SKI', ko: '스키', desc: '정설된 슬로프에서 카빙, 상급자는 모글까지.', tone: 'ice' },
	{ name: 'SNOWBOARD', ko: '스노우보드', desc: '그라운드 트릭부터 파크까지, 실력별로 조를 나눠요.', tone: 'dusk' },
];
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{club.name} — Ride Together</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/`}>FREE SNOW</a>
			<nav aria-label="메인">
				<a href="#season">SEASON</a>
				<a href="#ride">RIDE</a>
				<a href="#faq">FAQ</a>
				<a href={`${base}/webcam/`}>WEBCAM</a>
			</nav>
			<a class="nav-join" href={club.joinUrl} target="_blank" rel="noopener">JOIN</a>
		</header>

		<main>
			<section class="hero">
				<video class="hero-art" autoplay muted loop playsinline poster={`${base}/hero.jpg`} aria-hidden="true">
					<source src={`${base}/hero.mp4`} type="video/mp4" />
				</video>
				<div class="hero-shade"></div>
				<button class="hero-sound" type="button" aria-pressed="false" aria-label="소리 켜기">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M4 9h4l5-4v14l-5-4H4z" />
						<path class="on" d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" />
						<path class="off" d="M17 9l5 6M22 9l-5 6" />
					</svg>
				</button>
				<button class="hero-pause" type="button" aria-label="배경 영상 일시정지">❚❚</button>
				<div class="hero-copy">
					<p class="kicker">2026 — 27 SEASON</p>
					<h1>RIDE<br />TOGETHER.</h1>
					<p class="lede">스키어와 보더가 함께 타는 동호회. 첫 리프트부터 마지막 런까지, 이번 시즌은 같이.</p>
					<div class="actions">
						<a class="btn btn-solid" href={club.joinUrl} target="_blank" rel="noopener">JOIN THE TEAM</a>
						<a class="btn btn-line" href="#season">SEE THE SEASON</a>
					</div>
				</div>
			</section>

			<div class="ticker" aria-hidden="true">
				<div class="ticker-track">
					{[0, 1].map(() => ticker.map((t) => <span>{t}<i>✱</i></span>))}
				</div>
			</div>

			<section id="season" class="season">
				<div class="head">
					<h2>THE SEASON</h2>
					<p>이번 시즌 정모 일정. 일정마다 오픈채팅에서 투표로 인원을 받아요.</p>
				</div>
				<ol class="trip-list">
					{trips.map((t, i) => (
						<li>
							<span class="idx">{String(i + 1).padStart(2, '0')}</span>
							<time>{t.date}</time>
							<div class="trip-main">
								<h3>{t.place}</h3>
								<p>{t.note}</p>
							</div>
							<span class="trip-tag">{t.tag}</span>
						</li>
					))}
				</ol>
			</section>

			<section id="ride" class="split">
				{disciplines.map((d) => (
					<article class={`panel ${d.tone}`}>
						<p class="kicker">{d.ko}</p>
						<h2>{d.name}</h2>
						<p>{d.desc}</p>
					</article>
				))}
			</section>

			<section class="manifesto">
				<p>
					잘 타는 사람보다<br />
					<em>오래 같이 타는 사람</em>이<br />
					더 많은 팀.
				</p>
			</section>

			<section id="faq" class="faq">
				<h2>FAQ</h2>
				<div>
					{faqs.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-row">
				<a href={club.joinUrl} target="_blank" rel="noopener">오픈채팅 참여 →</a>
				<a href={`${base}/cute/`}>픽셀 버전 보기</a>
				<span>© {new Date().getFullYear()} {club.name}</span>
			</div>
			<p class="giant" aria-hidden="true">FREE SNOW</p>
		</footer>
		<script>
			const nav = document.querySelector('.nav')!;
			const onScroll = () => nav.classList.toggle('is-solid', scrollY > 40);
			addEventListener('scroll', onScroll, { passive: true });
			onScroll();
			const video = document.querySelector<HTMLVideoElement>('.hero-art')!;
			const btn = document.querySelector<HTMLButtonElement>('.hero-pause')!;
			const sync = () => {
				btn.textContent = video.paused ? '▶' : '❚❚';
				btn.ariaLabel = video.paused ? '배경 영상 재생' : '배경 영상 일시정지';
			};
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) video.pause();
			btn.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
			// 자동재생은 음소거로만 허용돼서, 소리는 버튼으로 켬
			const sound = document.querySelector<HTMLButtonElement>('.hero-sound')!;
			sound.addEventListener('click', () => {
				video.muted = !video.muted;
				if (!video.muted && video.paused) video.play();
				sound.setAttribute('aria-pressed', String(!video.muted));
				sound.ariaLabel = video.muted ? '소리 켜기' : '소리 끄기';
			});
			video.addEventListener('play', sync);
			video.addEventListener('pause', sync);
			sync();
		</script>
	</body>
</html>
