---
import { club } from '../data/club';
import Meta from '../components/Meta.astro';
import '../styles/ride.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // 끝 슬래시 없이 (scripts/session.ts 참고)
// 개인정보처리방침 (사용자 요구 2026-10-23 — 구글 OAuth 앱 게시에 링크가 필요해서). 내용은 사이트, 서버가 실제로 하는 것만.
// 모으는 항목, 보관 방식을 바꾸면 여기도 고칠 것 (가입 화면 signup.astro '개인정보 수집, 이용 안내'와 맞출 것)
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<Meta title={`${club.name} — 개인정보처리방침`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/`}><img src={`${base}/logo-white.png`} alt="FREE SNOW" width="103" height="50" /></a>
			<nav id="site-nav" aria-label="메인">
				<a href={`${base}/#season`}>SEASON</a>
				<a href={`${base}/board/`}>BOARD</a>
				<a href={`${base}/gallery/`}>GALLERY</a>
				<a href={`${base}/webcam/`}>WEBCAM</a>
				<a href={`${base}/rank/`}>CHAT RANK</a>
				<a href={`${base}/shredlog/`}>SHRED LOG</a>
				<a href={`${base}/seasonroom/`}>RIDE &amp; STAY</a>
			</nav>
			<a class="nav-join" href={`${base}/login/`}>LOGIN</a>
			<button class="nav-menu" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="site-nav">☰</button>
		</header>

		<main>
			<section class="mem-intro">
				<p class="kicker">POLICY</p>
				<h1>PRIVACY.</h1>
			</section>

			<section class="mem-body">
				<article class="policy">
					<h2>개인정보처리방침</h2>
					<p class="lead">프리스노우 동호회(이하 '동호회')가 이 사이트에서 어떤 정보를 왜 모으고 어떻게 다루는지 알려 드려요.</p>

					<h3>1. 모으는 정보</h3>
					<ul>
						<li><b>가입 신청</b> 휴대폰 번호(로그인 아이디, 비상 연락처), 비밀번호, 이름, 성별, 출생연도(19세 이상만 가입할 수 있어서 출생연도로 확인 — 올해 19세가 되는 해에 태어난 사람부터), 거주지(시도, 시군구). 모두 필수예요. 비밀번호와 로그인용 휴대폰 번호는 되돌릴 수 없게 암호화되어서 저장돼요. 비상 연락처는 암호화해 저장하고, 비상시 운영진만 풀어 볼 수 있어요(볼 때마다 기록).</li>
						<li><b>동의 기록</b> 동의한 시각과 그때의 개인정보처리방침 시행일</li>
						<li><b>운영진만</b> 운영진 본인의 메일(운영진 알림용)</li>
						<li><b>사이트를 쓰면서 생기는 것</b> 출격, 시즌방 체크, 강습 요청, SHRED LOG 기록(출격, 지출, 장비 관리), 앱 알림을 켠 기기의 알림 주소, 스노우라이브 연결 ID와 라이딩 통계, 게시글, 댓글, 좋아요, 올린 사진, 프로필 사진</li>
						<li><b>로그인 기록</b> 성공, 실패 여부와 시각, 브라우저 정보. 아이디와 IP는 알아볼 수 없게 바꾸거나 앞부분만 저장해요. 비밀번호는 되돌릴 수 없는 방식(해시)으로만 저장해요.</li>
					</ul>

					<h3>2. 쓰는 곳</h3>
					<ul>
						<li>회원 로그인, 같은 사람의 중복 가입 방지, 가입 확인(오픈채팅 닉네임과 맞춰 보기)</li>
						<li>출격, 시즌방 명단, 정모 조 편성 등 동호회 활동</li>
						<li>스키장 사고 등 비상시 연락</li>
						<li>시즌방 정산, 강습 연결 등 운영진 업무</li>
						<li>부정 로그인, 스팸 막기</li>
					</ul>

					<h3>3. 누가 볼 수 있나요</h3>
					<ul>
						<li><b>운영진만</b> 성별, 출생연도, 거주지, 비상 연락처(볼 때마다 기록), 동의 기록, 강습 요청과 연결 내용, 로그인 기록</li>
						<li><b>다른 회원도</b> 이름(출격, 시즌방 명단, 게시글 작성자 등), 프로필 사진, 회원이 쓴 글과 사진</li>
						<li><b>누구나</b> 공지 글, 갤러리 사진</li>
						<li>동호회는 회원 정보를 다른 곳에 팔거나 넘기지 않아요.</li>
					</ul>

					<h3>4. 보관 기간</h3>
					<ul>
						<li>탈퇴하거나 가입이 거절되면 개인정보를 지체 없이 지워요. 탈퇴 때 지우는 것과 남는 것은 아래 '7. 회원 탈퇴'를 봐 주세요.</li>
						<li>로그인 기록은 90일이 지나면 자동으로 지워요.</li>
						<li>서버의 자동 백업(장애 복구용)에는 지운 정보가 최대 30일 동안 남았다가 사라져요.</li>
					</ul>

					<h3>5. 저장, 처리를 맡기는 곳</h3>
					<ul>
						<li><b>Cloudflare</b> 서버, 회원 정보 저장, 사진 저장</li>
						<li><b>GitHub Pages</b> 사이트 화면</li>
						<li><b>Google</b> 지난 시즌 사진 보관(구글 드라이브), 운영진 알림 메일 발송(Gmail)</li>
						<li><b>Apple, Google 푸시 서비스</b> 앱 알림 전달(알림을 켠 회원만 — 운영진 알림, 폭설 예보)</li>
					</ul>
					<h4 id="abroad">국외 이전</h4>
					<p>위 회사들의 서버가 해외에 있어서, 사이트를 쓰는 동안 아래처럼 정보가 해외로 전송, 저장돼요. 원하지 않으면 가입하지 않거나 탈퇴할 수 있어요(이 경우 회원 기능을 쓸 수 없어요).</p>
					<ul>
						<li><b>Cloudflare, Inc.</b> (미국 등 Cloudflare 데이터센터) — 회원 정보, 기록, 사진 전체 / 서버, 저장 / 탈퇴할 때까지</li>
						<li><b>GitHub, Inc.</b> (미국) — 개인정보 없음(사이트 화면만) / 접속 기록은 GitHub 정책에 따름</li>
						<li><b>Google LLC</b> (미국 등) — 지난 시즌 갤러리 사진, 운영진 알림 메일(이름, 성별, 지역), 앱 알림 / 사진 보관, 메일, 알림 발송 / 사진은 지울 때까지, 메일은 받은 운영진이 지울 때까지</li>
						<li><b>Apple Inc.</b> (미국) — 앱 알림 내용 / 알림 전달 / 전달 후 바로</li>
						<li>전송 시기, 방법: 사이트를 쓸 때마다 암호화된 인터넷 연결(HTTPS)로</li>
					</ul>

					<h3>6. 브라우저에 저장하는 것</h3>
					<p>로그인 상태, 마지막으로 쓴 아이디, 화면 설정, 로그인 전 SHRED LOG 기록을 이 브라우저에만 저장해요. 광고, 추적용 쿠키는 쓰지 않아요.</p>

					<h3 id="delete">7. 회원 탈퇴 (계정 삭제)</h3>
					<p>로그인한 뒤 <a href={`${base}/members/`}>마이페이지</a> 맨 아래 '회원 탈퇴'에서 비밀번호를 한 번 더 넣으면 바로 탈퇴돼요(앱에서도 같아요). 로그인할 수 없으면 아래 문의처로 요청해 주세요.</p>
					<ul>
						<li><b>바로 지우는 것</b> 휴대폰 번호(아이디), 이름, 성별, 출생연도, 거주지, 비상 연락처, 메일, 비밀번호, 프로필 사진, SHRED LOG(장비 관리 포함), 스노우라이브 기록, 앱 알림 기기, 로그인 상태</li>
						<li><b>남는 것</b> 게시글, 댓글, 갤러리 사진, 출격, 시즌방 기록(정산)은 다른 회원과 함께 쓰는 기록이라 남고 '탈퇴 회원'으로만 보여요. 지우고 싶으면 탈퇴 전에 직접 지우거나 운영진에게 요청해 주세요.</li>
						<li><b>로그인 기록</b> 90일 뒤 자동으로 지워요.</li>
						<li>가입 정보가 일치하지 않거나 허위 정보로 가입한 경우 운영진이 예고 없이 탈퇴 처리할 수 있어요.</li>
					</ul>

					<h3>8. 회원의 권리</h3>
					<p>내 정보를 보거나 고치거나 지워 달라고 언제든 요청할 수 있어요. 아래 문의처로 알려 주세요.</p>

					<h3>9. 개인정보 보호책임자, 문의</h3>
					<p>
						개인정보 보호책임자: 동호회 관리자(운영진 대표)
						{club.joinUrl && <> | <a href={club.joinUrl} target="_blank" rel="noopener">카카오 오픈채팅 ↗</a></>}
					</p>
					<p>개인정보 침해 신고, 상담: 개인정보침해 신고센터 (국번 없이) 118, privacy.kisa.or.kr</p>

					<p class="date">시행일 2026년 10월 27일 <!-- 바꾸면 backend/src/lib.ts POLICY_VERSION도 (가입 동의 기록) --></p>
				</article>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-row">
				<span>{club.footer}</span>
			</div>
			<p class="giant" aria-hidden="true">FREE SNOW</p>
		</footer>

		<script>
			import '../scripts/session';
		</script>
	</body>
</html>

<style>
	.policy {
		display: grid;
		gap: 12px;
		max-width: 760px;
		line-height: 1.7;
	}
	.policy h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		font-weight: 900;
		letter-spacing: -0.03em;
	}
	.policy h3 {
		margin-top: 20px;
		font-size: 1.1rem;
		font-weight: 900;
	}
	.policy h4 {
		margin-top: 12px;
		font-size: 1rem;
		font-weight: 900;
	}
	.policy ul {
		display: grid;
		gap: 6px;
		margin: 0;
		padding-left: 1.2em;
	}
	.policy b {
		margin-right: 6px;
	}
	.lead,
	.date {
		color: #4a4d55;
	}
	.date {
		margin-top: 24px;
		font-size: 14px;
	}
	.policy a {
		color: inherit;
		font-weight: 700;
	}
</style>
