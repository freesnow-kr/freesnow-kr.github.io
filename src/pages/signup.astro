---
import { club } from '../data/club';
import Meta from '../components/Meta.astro';
import regions from '../data/regions.json'; // scripts/make-regions.mjs 로 법정동 CSV에서 생성
import '../styles/ride.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // 끝 슬래시 없이 (scripts/session.ts 참고)
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<Meta title={`${club.name} — Sign up`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/`}><img src={`${base}/logo-white.png`} alt="FREE SNOW" width="103" height="50" /></a>
			<nav id="site-nav" aria-label="메인">
				<a href={`${base}/#season`}>SEASON</a>
				<a href={`${base}/board/`}>BOARD</a>
				<a href={`${base}/gallery/`}>GALLERY</a>
				<a href={`${base}/webcam/`}>WEBCAM</a>
				<a href={`${base}/rank/`}>CHAT RANK</a>
				<a href={`${base}/shredlog/`}>SHRED LOG</a>
				<a href={`${base}/seasonroom/`}>RIDE &amp; STAY</a>
			</nav>
			<a class="nav-join" href={`${base}/login/`}>LOGIN</a>
			<button class="nav-menu" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="site-nav">☰</button>
		</header>

		<main>
			<section class="mem-intro">
				<p class="kicker">JOIN FREE SNOW</p>
				<h1>SIGN UP.</h1>
			</section>

			<section class="mem-body">
				{!club.api && <p class="mem-msg">회원가입 준비 중이에요.</p>}

				<form class="signup" hidden={!club.api} novalidate>
					<h2>회원가입</h2>

					<!-- 아이디 = 010 뺀 휴대폰 번호 (사용자 결정 2026-10-26). 서버는 번호를 되돌릴 수 없는 값(HMAC)으로만 저장, 화면 어디에도 안 보임 -->
					<label>
						<span>휴대폰 번호 <small>(아이디로 사용해요)</small></span>
						<span class="id-row">
							<span class="id-pre" aria-hidden="true">010</span>
							<input name="phone" type="tel" inputmode="numeric" autocomplete="username" maxlength="9" placeholder="1234-5678" required />
						</span>
						<small class="field-note">번호는 암호화되어서 저장되고, 화면 어디에도 보이지 않아요.</small>
					</label>
					<label class="choice">
						<input name="emergency" type="checkbox" />
						<span class="choice-text">이 번호를 비상 연락처로도 사용해요 (선택)<small>스키장 사고 등 비상시 운영진만 확인할 수 있어요</small></span>
					</label>

					<label>
						비밀번호
						<input name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" placeholder="8자 이상" required />
					</label>
					<label>
						비밀번호 확인
						<input name="password2" type="password" autocomplete="new-password" maxlength="128" required />
					</label>

					<label>
						이름
						<input name="name" type="text" autocomplete="name" maxlength="20" required />
					</label>

					<fieldset>
						<legend>성별</legend>
						<label class="choice"><input type="radio" name="gender" value="남" required /> 남</label>
						<label class="choice"><input type="radio" name="gender" value="여" /> 여</label>
					</fieldset>

					<label>
						출생연도
						<!-- 필수, 고르기 (사용자 요구 2026-10-26). 동호회는 19세 이상만 — 연 나이 기준, 올해 19세가 되는 해(올해-19년생)부터 (사용자 요구). 고를 수 있으면 되니까 나이 체크를 따로 안 받음
						     (빌드한 해 기준 — 해가 바뀌면 다시 배포. 서버도 같은 규칙) -->
						<select name="year" required>
							<option value="">선택</option>
							{Array.from({ length: new Date().getFullYear() - 19 - 1940 + 1 }, (_, i) => new Date().getFullYear() - 19 - i).map((y) => <option value={y}>{y}년</option>)}
						</select>
						<small class="field-note">{new Date().getFullYear() - 19}년생부터 가입할 수 있어요.</small>
					</label>

					<fieldset>
						<legend><span>거주지 <small>(선택)</small></span></legend>
						<div class="area">
							<select name="sido" aria-label="시도">
								<option value="">시도</option>
								{Object.keys(regions).map((sido) => <option value={sido}>{sido}</option>)}
							</select>
							<select name="sigungu" aria-label="시군구" disabled>
								<option value="">시군구</option>
							</select>
						</div>
					</fieldset>

					<!-- 봇 방지: 사람에겐 안 보이는 칸 -->
					<label class="hp" aria-hidden="true">
						website
						<input name="website" type="text" tabindex="-1" autocomplete="off" />
					</label>

					<!-- 동의 문구를 바꾸면: backend lib.ts POLICY_VERSION + privacy.astro 시행일 + 새 version의 consent_terms 줄(migration) -->
					<details class="privacy">
						<summary>개인정보 수집, 이용 안내</summary>
						<ul>
							<li><b>필수 항목</b> 휴대폰 번호(아이디 — 암호화되어서 저장), 비밀번호, 이름, 성별, 출생연도(19세 이상 확인) — 회원 로그인, 중복 가입 방지, 가입 확인(오픈채팅 닉네임과 맞춰 보기), 출격, 시즌방 명단, 정모 조 편성</li>
							<li><b>선택 항목</b> 거주지, 휴대폰 번호의 비상 연락처 사용 — 회원 명부 지역별 정리, 비상시 연락(운영진만 봐요)</li>
							<li><b>보유 기간</b> 탈퇴 또는 가입 거절 시 지체 없이 삭제</li>
							<li>필수 항목에 동의하지 않으면 가입할 수 없어요. 선택 항목은 동의하지 않아도 가입할 수 있어요.</li>
							<li>서버는 해외(Cloudflare 등)에 있어요. 자세한 건 처리방침을 봐 주세요.</li>
							<li><a href={`${base}/privacy/`} target="_blank">개인정보처리방침 전체 보기 ↗</a></li>
						</ul>
					</details>
					<label class="choice agree">
						<input name="agree" type="checkbox" required />
						필수 항목 수집, 이용에 동의해요 (필수)
					</label>
					<label class="choice">
						<input name="agreeOpt" type="checkbox" />
						선택 항목(거주지, 비상 연락처 사용) 수집, 이용에 동의해요 (선택)
					</label>

					<p class="warn">가입 정보가 일치하지 않거나 허위 정보로 가입한 경우 예고 없이 탈퇴 처리돼요.</p>
					<button class="btn btn-ink" type="submit">가입 신청</button>
					<p class="mem-error" role="alert"></p>
				</form>

				<div class="done" hidden>
					<h2>신청이 접수됐어요</h2>
					<p>운영진이 확인하면 휴대폰 번호(010 빼고)와 정한 비밀번호로 로그인할 수 있어요.</p>
					<a class="btn btn-line-dark" href={`${base}/`}>메인으로</a>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-row">
				<span>{club.footer}</span>
			</div>
			<p class="giant" aria-hidden="true">FREE SNOW</p>
		</footer>

		<script>
			import { busy, call } from '../scripts/session';
			import regions from '../data/regions.json';

			const form = document.querySelector<HTMLFormElement>('.signup')!;
			const error = form.querySelector<HTMLElement>('.mem-error')!;
			const done = document.querySelector<HTMLElement>('.done')!;

			// 서버도 같은 검사를 하지만, 먼저 화면에서 알려줌
			// 시도 고르면 그 시도의 시군구 목록 채우기
			const sigungu = form.sigungu as HTMLSelectElement;
			form.sido.addEventListener('change', () => {
				const list: string[] = (regions as Record<string, string[]>)[form.sido.value] ?? [];
				sigungu.replaceChildren(new Option('시군구', ''), ...list.map((g) => new Option(g, g)));
				sigungu.disabled = !list.length;
				if (list.length === 1) sigungu.value = list[0]; // 세종처럼 하나뿐이면 자동 선택
			});

			const check = (d: FormData) => {
				const ph = String(d.get('phone')).replace(/\D/g, '').replace(/^010(?=\d{8}$)/, '');
				if (!/^\d{8}$/.test(ph)) return '휴대폰 번호를 확인해 주세요. (010 빼고 8자리)';
				if (String(d.get('password')).length < 8) return '비밀번호는 8자 이상으로 정해 주세요.';
				if (d.get('password') !== d.get('password2')) return '비밀번호 확인이 달라요.';
				if (!String(d.get('name')).trim() || !d.get('gender')) return '이름과 성별을 적어 주세요.';
				if (!d.get('year')) return '출생연도를 골라 주세요.';
				if ((d.get('sido') || d.get('emergency')) && !d.get('agreeOpt')) return '선택 항목을 적었다면 선택 항목 동의에 체크해 주세요. (안 적어도 가입돼요)';
				if (!d.get('agree')) return '필수 항목 수집, 이용에 동의해 주세요.';
				return '';
			};

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const d = new FormData(form);
				const msg = check(d);
				error.textContent = msg;
				if (msg) return;

				busy(form, true, '신청 중…');
				const opt = d.get('agreeOpt') === 'on'; // 선택 동의를 안 했으면 선택 항목은 안 보냄
				const res = await call({
					action: 'signup',
					phone: d.get('phone'),
					password: d.get('password'),
					name: d.get('name'),
					gender: d.get('gender'),
					agreeOpt: opt,
					year: d.get('year'),
					sido: opt ? d.get('sido') : '',
					sigungu: opt ? d.get('sigungu') : '',
					emergency: opt && d.get('emergency') === 'on',
					website: d.get('website'),
					agree: d.get('agree') === 'on',
				}).catch(() => null);
				busy(form, false, '');
				if (!res?.ok) {
					error.textContent = res?.error ?? '서버에 연결하지 못했어요. 잠시 뒤 다시 시도해 주세요.';
					return;
				}
				form.hidden = true;
				done.hidden = false;
				scrollTo({ top: 0 });
			});
		</script>
	</body>
</html>

<style>
	.signup,
	.done {
		display: grid;
		gap: 20px;
		max-width: 480px;
	}
	.signup h2,
	.done h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		font-weight: 900;
		letter-spacing: -0.03em;
	}
	.signup label,
	.signup legend {
		display: grid;
		gap: 8px;
		font-size: 14px;
		font-weight: 700;
	}
	.signup fieldset {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		min-width: 0; /* fieldset은 기본이 '내용보다 안 좁아짐'이라 휴대폰에서 폼이 화면 밖으로 밀렸음 (2026-10-26) */
		margin: 0;
		padding: 0;
		border: 0;
	}
	.signup legend {
		margin-bottom: 8px;
	}
	.signup input[type='text'],
	.signup input[type='password'],
	.signup input[type='tel'],
	.signup select {
		min-height: 52px;
		padding: 0 16px;
		border: 1.5px solid var(--black);
		border-radius: 0;
		background-color: var(--white);
		color: var(--black);
		font: inherit;
		font-size: 17px;
		font-weight: 400;
	}
	.signup select {
		width: 100%;
		min-width: 0;
		padding-right: 38px; /* 화살표 자리 (모양은 ride.css 공통) */
	}
	.signup input {
		min-width: 0;
	}
	/* minmax(0, …): 가장 긴 선택지('제주특별자치도' 등)가 칸을 넓히지 않게 */
	.area {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 8px;
		width: 100%;
	}
	.field-note {
		font-size: 13px;
	}
	.signup small {
		color: var(--gray);
		font-weight: 400;
	}
	/* 휴대폰 번호: 고정 '010' + 8자리 */
	.id-row {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 8px;
		width: 100%;
	}
	.id-pre {
		font-size: 17px;
		font-weight: 700;
	}
	.choice {
		display: flex !important;
		align-items: center;
		gap: 8px !important;
		font-size: 16px !important;
		font-weight: 400 !important;
		cursor: pointer;
	}
	/* 체크박스 옆 두 줄 문구 (비상 연락처) — 둘째 줄은 작게 아래로 */
	.choice-text {
		display: grid;
		gap: 2px;
	}
	.choice-text small {
		font-size: 13px;
	}
	.choice input {
		width: 18px;
		height: 18px;
		accent-color: var(--black);
	}
	.agree {
		font-weight: 700 !important;
	}
	.hp {
		position: absolute;
		left: -9999px;
	}
	.privacy {
		border: 1px solid var(--line);
		padding: 14px 16px;
		font-size: 14px;
		color: #4a4d55;
	}
	.privacy summary {
		cursor: pointer;
		font-weight: 700;
		color: var(--black);
	}
	/* 허위 가입 안내 (사용자 요구 2026-10-26) */
	.warn {
		color: #c4320a;
		font-size: 14px;
		font-weight: 700;
	}
	.privacy ul {
		margin: 10px 0 0;
		padding-left: 18px;
		display: grid;
		gap: 4px;
	}
	.mem-error {
		color: #c4320a;
		font-weight: 700;
		min-height: 1.6em;
	}
	.done p {
		color: #4a4d55;
	}
	.done .btn {
		justify-self: start;
	}
</style>
