# .dev.vars 로 복사 (로컬 wrangler dev 전용, gitignore). 배포 값은 `wrangler secret put 이름`
RESET_PASSWORD=
LOGIN_KEY_SECRET=
# 휴대폰 번호 HMAC·비상 연락처 암호화 (openssl rand -base64 32). 실서버 값은 잃으면 복구 불가 → 따로 백업
PHONE_KEY=
SNOWLIVE_API=
SOMOIM_URL=
GALLERY_FOLDER_ID=
# 선택: 있으면 갤러리를 Drive API로 (만든 날짜 최신순)
GOOGLE_API_KEY=
# 선택: 시즌 사진을 드라이브로 보관 (node scripts/google-auth.mjs가 읽고 Worker secret으로 넣음)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
