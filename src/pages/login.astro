---
import { club } from '../data/club';
import Meta from '../components/Meta.astro';
import '../styles/ride.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // 끝 슬래시 없이 (scripts/session.ts 참고)
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<Meta title={`${club.name} — Login`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/`}><img src={`${base}/logo-white.png`} alt="FREE SNOW" width="103" height="50" /></a>
			<nav id="site-nav" aria-label="메인">
				<a href={`${base}/#season`}>SEASON</a>
				<a href={`${base}/board/`}>BOARD</a>
				<a href={`${base}/gallery/`}>GALLERY</a>
				<a href={`${base}/webcam/`}>WEBCAM</a>
				<a href={`${base}/rank/`}>CHAT RANK</a>
				<a href={`${base}/shredlog/`}>SHRED LOG</a>
				<a href={`${base}/seasonroom/`}>RIDE &amp; STAY</a>
			</nav>
			<a class="nav-join" href={`${base}/login/`} aria-current="page">LOGIN</a>
			<button class="nav-menu" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="site-nav">☰</button>
		</header>

		<main>
			<section class="mem-intro">
				<p class="kicker">MEMBERS ONLY</p>
				<h1>LOGIN.</h1>
			</section>

			<section class="mem-body">
				{!club.api && <p class="mem-msg">회원 로그인 준비 중이에요.</p>}

				<form class="login tf" hidden={!club.api}>
					<!-- 얇은 폼 (ride.css .tf, 사용자 요구 2026-10-26) -->
					<h2 class="tf-title">로그인</h2>
					<input name="loginId" type="text" autocomplete="username" autocapitalize="off" spellcheck="false" inputmode="numeric" aria-label="휴대폰 번호 (아이디)" placeholder="휴대폰 번호 (010 제외)" required />
					<input name="password" type="password" autocomplete="current-password" aria-label="비밀번호" placeholder="비밀번호" required />
					<div class="row">
						<a href={`${base}/signup/`}>회원가입</a>
						<button class="tf-btn" type="submit">로그인</button>
					</div>
					<ul class="tf-notes">
						<li>비밀번호를 잊었다면 운영진에게 초기화를 요청해 주세요.</li>
					</ul>
					<p class="mem-error" role="alert"></p>
				</form>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-row">
				<span>{club.footer}</span>
			</div>
			<p class="giant" aria-hidden="true">FREE SNOW</p>
		</footer>

		<script>
			import { base, busy, call, passwordUrl, store } from '../scripts/session';

			const form = document.querySelector<HTMLFormElement>('.login')!;
			const error = form.querySelector<HTMLElement>('.mem-error')!;

			// 이미 로그인돼 있으면 회원 페이지로
			// 로그인 뒤 돌아갈 곳: 기본은 메인, ?next=/#season 등 이 사이트 안 주소면 거기로
			const want = new URLSearchParams(location.search).get('next') ?? '';
			const next = want.startsWith(`${base}/`) && !want.startsWith('//') ? want : `${base}/`;
			if (store.get()) location.replace(next);
			if (store.id()) store.setId(''); // 예전에 기억한 아이디(휴대폰 번호, fs_)는 지움 — 아이디가 휴대폰 번호라 이 브라우저에 안 남김
			// 회원 페이지에서 토큰 만료로 돌아온 경우
			if (new URLSearchParams(location.search).has('expired')) error.textContent = '다시 로그인해 주세요.';

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				error.textContent = '';
				busy(form, true, '로그인 중…');
				const data = new FormData(form);
				// 로그인은 항상 30일 + 쓰는 동안 자동 연장 (session.ts). 아이디도 늘 기억
				const res = await call({ action: 'login', loginId: data.get('loginId'), password: data.get('password') }).catch(() => null);
				if (!res?.ok) {
					busy(form, false, '');
					error.textContent = res?.error ?? '서버에 연결하지 못했어요. 잠시 뒤 다시 시도해 주세요.';
					return;
				}
				store.set(res.token);
				// 브라우저가 저장을 막으면(Safari '모든 쿠키 차단' 등) 서버 로그인은 됐어도 다음 페이지에서 로그인 안 된 상태가 됨 → 조용히 넘어가지 말고 알림
				if (store.get() !== res.token) {
					busy(form, false, '');
					error.textContent = '이 브라우저가 로그인 정보 저장을 막고 있어요. Safari라면 설정 → Safari → \'모든 쿠키 차단\'을 끄고, 개인정보 보호 브라우징이 아닌 창에서 다시 로그인해 주세요.';
					return;
				}
				store.setId(''); // 아이디가 휴대폰 번호라 이 브라우저에도 남기지 않음 (브라우저 비밀번호 저장은 됨)
				try { localStorage.setItem('fs-member-renewed', String(Date.now())); } catch {}
				store.setName(res.name);
				// 초기화 비밀번호로 들어왔으면 새 비밀번호부터
				location.href = res.mustChange ? `${passwordUrl}?first&next=${encodeURIComponent(next)}` : next;
			});
		</script>
	</body>
</html>

<style>
	/* 회원가입 링크는 왼쪽, 로그인 버튼은 오른쪽 */
	.row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 4px;
	}
	.row a {
		color: #3a3d45;
		font-size: 13px;
	}
</style>
