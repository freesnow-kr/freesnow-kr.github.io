---
import { club, trips, faqs } from '../data/club';

const base = import.meta.env.BASE_URL;

const ticker = ['SKI', 'SNOWBOARD', 'CARPOOL', 'NIGHT RIDE', 'APRÈS', 'FIRST CHAIR'];

const disciplines = [
	{ name: 'SKI', ko: '스키', desc: '정설된 슬로프에서 카빙, 상급자는 모글까지.', tone: 'ice' },
	{ name: 'SNOWBOARD', ko: '스노우보드', desc: '그라운드 트릭부터 파크까지, 실력별로 조를 나눠요.', tone: 'dusk' },
];
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{club.name} — Ride Together</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/ride/`}>FREE SNOW</a>
			<nav aria-label="메인">
				<a href="#season">SEASON</a>
				<a href="#ride">RIDE</a>
				<a href="#faq">FAQ</a>
			</nav>
			<a class="nav-join" href={club.joinUrl} target="_blank" rel="noopener">JOIN</a>
		</header>

		<main>
			<section class="hero">
				<video class="hero-art" autoplay muted loop playsinline poster={`${base}/hero.jpg`} aria-hidden="true">
					<source src={`${base}/hero.mp4`} type="video/mp4" />
				</video>
				<div class="hero-shade"></div>
				<button class="hero-pause" type="button" aria-label="배경 영상 일시정지">❚❚</button>
				<div class="hero-copy">
					<p class="kicker">2026 — 27 SEASON</p>
					<h1>RIDE<br />TOGETHER.</h1>
					<p class="lede">스키어와 보더가 함께 타는 동호회. 첫 리프트부터 마지막 런까지, 이번 시즌은 같이.</p>
					<div class="actions">
						<a class="btn btn-solid" href={club.joinUrl} target="_blank" rel="noopener">JOIN THE CREW</a>
						<a class="btn btn-line" href="#season">SEE THE SEASON</a>
					</div>
				</div>
			</section>

			<div class="ticker" aria-hidden="true">
				<div class="ticker-track">
					{[0, 1].map(() => ticker.map((t) => <span>{t}<i>✱</i></span>))}
				</div>
			</div>

			<section id="season" class="season">
				<div class="head">
					<h2>THE SEASON</h2>
					<p>이번 시즌 정모 일정. 일정마다 오픈채팅에서 투표로 인원을 받아요.</p>
				</div>
				<ol class="trip-list">
					{trips.map((t, i) => (
						<li>
							<span class="idx">{String(i + 1).padStart(2, '0')}</span>
							<time>{t.date}</time>
							<div class="trip-main">
								<h3>{t.place}</h3>
								<p>{t.note}</p>
							</div>
							<span class="trip-tag">{t.tag}</span>
						</li>
					))}
				</ol>
			</section>

			<section id="ride" class="split">
				{disciplines.map((d) => (
					<article class={`panel ${d.tone}`}>
						<p class="kicker">{d.ko}</p>
						<h2>{d.name}</h2>
						<p>{d.desc}</p>
					</article>
				))}
			</section>

			<section class="manifesto">
				<p>
					잘 타는 사람보다<br />
					<em>오래 같이 타는 사람</em>이<br />
					더 많은 크루.
				</p>
			</section>

			<section id="faq" class="faq">
				<h2>FAQ</h2>
				<div>
					{faqs.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-row">
				<a href={club.joinUrl} target="_blank" rel="noopener">오픈채팅 참여 →</a>
				<a href={`${base}/`}>픽셀 버전 보기</a>
				<span>© {new Date().getFullYear()} {club.name}</span>
			</div>
			<p class="giant" aria-hidden="true">FREE SNOW</p>
		</footer>
		<script>
			const video = document.querySelector<HTMLVideoElement>('.hero-art')!;
			const btn = document.querySelector<HTMLButtonElement>('.hero-pause')!;
			const sync = () => {
				btn.textContent = video.paused ? '▶' : '❚❚';
				btn.ariaLabel = video.paused ? '배경 영상 재생' : '배경 영상 일시정지';
			};
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) video.pause();
			btn.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
			video.addEventListener('play', sync);
			video.addEventListener('pause', sync);
			sync();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--black: #0b0d12;
		--white: #ffffff;
		--bone: #f1efea;
		--gray: #8b8f99;
		--line: #d9d6cf;
		--accent: #ff5a1f;
		--display: 'Anton', 'Noto Sans KR', Impact, sans-serif;
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		font: 16px/1.6 'Noto Sans KR', system-ui, sans-serif;
		color: var(--black);
		background: var(--bone);
		-webkit-font-smoothing: antialiased;
	}
	h1,
	h2,
	h3,
	p {
		margin: 0;
	}
	a {
		color: inherit;
	}
	.kicker {
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.2em;
	}

	/* nav: 히어로 위에 투명하게 */
	.nav {
		position: absolute;
		inset: 0 0 auto;
		z-index: 10;
		display: flex;
		align-items: center;
		gap: 32px;
		padding: 22px clamp(20px, 4vw, 56px);
		color: var(--white);
	}
	.wordmark {
		font-family: var(--display);
		font-size: 26px;
		letter-spacing: 0.02em;
		text-decoration: none;
	}
	.nav nav {
		display: flex;
		gap: 28px;
		margin-left: auto;
	}
	.nav nav a,
	.nav-join {
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-decoration: none;
	}
	.nav nav a:hover {
		text-decoration: underline;
		text-underline-offset: 6px;
	}
	.nav-join {
		padding: 10px 18px;
		border: 1.5px solid currentColor;
	}
	.nav-join:hover {
		background: var(--white);
		color: var(--black);
	}
	@media (max-width: 640px) {
		.nav nav {
			display: none;
		}
		.nav-join {
			margin-left: auto;
		}
	}

	/* hero */
	.hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		align-items: flex-end;
		color: var(--white);
		background: var(--black);
		overflow: hidden;
	}
	.hero-art {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero-pause {
		position: absolute;
		right: clamp(20px, 4vw, 56px);
		bottom: clamp(48px, 8vh, 96px);
		z-index: 2;
		width: 44px;
		height: 44px;
		border: 1.5px solid rgb(255 255 255 / 0.6);
		border-radius: 50%;
		background: rgb(0 0 0 / 0.25);
		color: var(--white);
		font-size: 12px;
		cursor: pointer;
	}
	.hero-pause:hover {
		background: var(--white);
		color: var(--black);
	}
	.hero-shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgb(0 0 0 / 0.45), rgb(0 0 0 / 0.15) 30%, rgb(0 0 0 / 0.35) 55%, rgb(0 0 0 / 0.8));
	}
	.hero-copy {
		position: relative;
		padding: 0 clamp(20px, 4vw, 56px) clamp(48px, 8vh, 96px);
		max-width: 1100px;
	}
	.hero h1 {
		font-family: var(--display);
		font-weight: 400;
		font-size: clamp(4rem, 13vw, 11rem);
		line-height: 0.9;
		letter-spacing: -0.01em;
		margin: 16px 0 24px;
	}
	.lede {
		max-width: 30em;
		font-size: 17px;
		color: rgb(255 255 255 / 0.85);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		min-height: 52px;
		padding: 0 28px;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-decoration: none;
		transition: background 0.2s, color 0.2s;
	}
	.btn-solid {
		background: var(--white);
		color: var(--black);
	}
	.btn-solid:hover {
		background: var(--accent);
		color: var(--white);
	}
	.btn-line {
		border: 1.5px solid var(--white);
	}
	.btn-line:hover {
		background: var(--white);
		color: var(--black);
	}

	/* ticker */
	.ticker {
		overflow: hidden;
		background: var(--accent);
		color: var(--black);
		padding: 14px 0;
	}
	.ticker-track {
		display: flex;
		width: max-content;
		animation: scroll 30s linear infinite;
	}
	.ticker span {
		font-family: var(--display);
		font-size: 28px;
		letter-spacing: 0.02em;
		padding-right: 28px;
		white-space: nowrap;
	}
	.ticker i {
		font-style: normal;
		padding-left: 28px;
	}
	@keyframes scroll {
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ticker-track {
			animation: none;
		}
	}

	/* season */
	.season {
		padding: clamp(64px, 10vw, 140px) clamp(20px, 4vw, 56px);
	}
	.head {
		display: grid;
		grid-template-columns: 1fr minmax(0, 360px);
		align-items: end;
		gap: 24px;
		margin-bottom: 48px;
	}
	.head h2,
	.split h2,
	.faq h2 {
		font-family: var(--display);
		font-weight: 400;
		font-size: clamp(3rem, 8vw, 6.5rem);
		line-height: 0.95;
	}
	.head p {
		color: #4a4d55;
	}
	.trip-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1.5px solid var(--black);
	}
	.trip-list li {
		display: grid;
		grid-template-columns: 3rem 8rem 1fr auto;
		align-items: center;
		gap: 24px;
		padding: 28px 0;
		border-bottom: 1px solid var(--line);
		transition: padding 0.25s;
	}
	.trip-list li:hover {
		padding-left: 16px;
	}
	.idx {
		color: var(--gray);
		font-weight: 700;
	}
	.trip-list time {
		font-family: var(--display);
		font-size: 28px;
	}
	.trip-main h3 {
		font-size: clamp(1.3rem, 2.4vw, 1.9rem);
		font-weight: 900;
		letter-spacing: -0.02em;
	}
	.trip-main p {
		color: #4a4d55;
	}
	.trip-tag {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.12em;
		padding: 6px 12px;
		border: 1px solid var(--black);
	}
	@media (max-width: 720px) {
		.head {
			grid-template-columns: 1fr;
		}
		.trip-list li {
			grid-template-columns: 2rem 1fr auto;
			gap: 4px 16px;
		}
		.trip-list time {
			grid-column: 2;
			font-size: 22px;
		}
		.trip-main {
			grid-column: 2 / -1;
		}
		.trip-tag {
			grid-row: 1;
			grid-column: 3;
		}
	}

	/* split panels */
	.split {
		display: grid;
		grid-template-columns: 1fr 1fr;
	}
	.panel {
		min-height: 80vh;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 12px;
		padding: clamp(28px, 4vw, 56px);
		color: var(--white);
	}
	.panel p:last-child {
		max-width: 24em;
		color: rgb(255 255 255 / 0.85);
	}
	.panel.ice {
		background:
			linear-gradient(160deg, transparent 55%, rgb(255 255 255 / 0.25) 55.2%, transparent 70%),
			linear-gradient(200deg, #9fb6d4, #2b3f63 70%, #141b2b);
	}
	.panel.dusk {
		background:
			linear-gradient(20deg, transparent 50%, rgb(255 255 255 / 0.18) 50.2%, transparent 65%),
			linear-gradient(200deg, #ff9a6b, #8a3a52 55%, #1a1324);
	}
	@media (max-width: 720px) {
		.split {
			grid-template-columns: 1fr;
		}
		.panel {
			min-height: 60vh;
		}
	}

	/* manifesto */
	.manifesto {
		padding: clamp(80px, 14vw, 200px) clamp(20px, 4vw, 56px);
		background: var(--white);
	}
	.manifesto p {
		font-size: clamp(2rem, 6vw, 5rem);
		font-weight: 900;
		line-height: 1.15;
		letter-spacing: -0.04em;
	}
	.manifesto em {
		font-style: normal;
		color: var(--accent);
	}

	/* faq */
	.faq {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
		gap: 48px;
		padding: clamp(64px, 10vw, 140px) clamp(20px, 4vw, 56px);
	}
	.faq details {
		border-bottom: 1px solid var(--line);
		padding: 24px 0;
	}
	.faq details:first-child {
		border-top: 1.5px solid var(--black);
	}
	.faq summary {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		cursor: pointer;
		list-style: none;
		font-size: 1.15rem;
		font-weight: 700;
	}
	.faq summary::-webkit-details-marker {
		display: none;
	}
	.faq summary::after {
		content: '+';
		font-weight: 400;
		font-size: 1.5rem;
		line-height: 1;
	}
	.faq details[open] summary::after {
		content: '−';
	}
	.faq details p {
		margin-top: 12px;
		color: #4a4d55;
	}
	@media (max-width: 720px) {
		.faq {
			grid-template-columns: 1fr;
			gap: 24px;
		}
	}

	/* footer */
	.footer {
		background: var(--black);
		color: var(--white);
		padding: 48px clamp(20px, 4vw, 56px) 0;
		overflow: hidden;
	}
	.footer-row {
		display: flex;
		flex-wrap: wrap;
		gap: 16px 32px;
		font-size: 14px;
	}
	.footer-row span {
		margin-left: auto;
		color: var(--gray);
	}
	.giant {
		font-family: var(--display);
		font-size: 21vw;
		line-height: 0.8;
		margin: 48px 0 -0.08em;
		white-space: nowrap;
		letter-spacing: -0.01em;
	}
	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}
</style>
