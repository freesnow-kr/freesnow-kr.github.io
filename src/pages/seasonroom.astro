---
import { club } from '../data/club';
import Meta from '../components/Meta.astro';
import '../styles/ride.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // 끝 슬래시 없이 (scripts/session.ts 참고)
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<Meta title={`${club.name} — Ride & Stay`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/`}><img src={`${base}/logo-white.png`} alt="FREE SNOW" width="103" height="50" /></a>
			<nav id="site-nav" aria-label="메인">
				<a href={`${base}/#season`}>SEASON</a>
				<a href={`${base}/board/`}>BOARD</a>
				<a href={`${base}/gallery/`}>GALLERY</a>
				<a href={`${base}/webcam/`}>WEBCAM</a>
				<a href={`${base}/rank/`}>CHAT RANK</a>
				<a href={`${base}/shredlog/`}>SHRED LOG</a>
				<a href={`${base}/seasonroom/`} aria-current="page">RIDE &amp; STAY</a>
			</nav>
			<a class="nav-join" href={`${base}/login/`}>LOGIN</a>
			<button class="nav-menu" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="site-nav">☰</button>
		</header>

		<main>
			<section class="mem-intro">
				<p class="kicker">MEMBERS ONLY</p>
				<h1>RIDE &amp; STAY.</h1>
			</section>

			<section class="mem-body">
				<p class="mem-msg loading">불러오는 중…</p>
				<div class="room" hidden>
					<p class="room-hint">날짜를 누르면 그날 출격, 시즌방을 쓴 사람이 보이고, 내 출격, 숙박, 4시간 휴식을 체크하거나 바꾸거나 취소할 수 있어요.<br />출격한 날엔 강습도 요청할 수 있어요.</p>

					<!-- 넓은 화면: 달력 오른쪽에 고른 날 명단 (달력 높이만큼, 넘치면 안에서 스크롤) / 좁은 화면: 달력 아래 -->
					<div class="room-main">
						<div class="cal-col">
							<div class="room-head">
								<button class="month-btn month-prev" type="button" aria-label="이전 달">‹</button>
								<h2 class="month-label" aria-live="polite"></h2>
								<button class="month-btn month-next" type="button" aria-label="다음 달">›</button>
							</div>
							<div class="view-row">
								<button class="view-btn" type="button"></button>
							</div>
							<div class="cal">
								{['일', '월', '화', '수', '목', '금', '토'].map((d) => <span class="wd">{d}</span>)}
								<div class="days"></div>
							</div>
						</div>

						<form class="day-panel">
							<h3 class="day-title"></h3>
							<div class="day-group ride-group">
								<p class="group-title ride-title"></p>
								<ul class="day-names ride-names"></ul>
								<div class="day-actions ride-actions"></div>
								<p class="lesson-note" hidden>강습을 요청했어요. 운영진이 따로 연결해 드려요. (요청은 나와 운영진만 봐요)</p>
							</div>
							<div class="day-group">
								<p class="group-title stay-title"></p>
								<ul class="day-names stay-names"></ul>
								<div class="day-actions stay-actions"></div>
							</div>
						</form>
					</div>

				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-row">
				<a href={`${base}/members/`}>MEMBERS로</a>
				<span>{club.footer}</span>
			</div>
			<p class="giant" aria-hidden="true">FREE SNOW</p>
		</footer>

		<script>
			import { call, loginUrl, store } from '../scripts/session';

			type Kind = '숙박' | '휴식';
			type Night = { date: string; name: string; kind: Kind; me: boolean; owner: boolean };
			type Ride = { date: string; name: string; me: boolean };
			const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
			const token = store.get();
			const msg = $('.loading');
			const box = $('.room');
			const panel = $<HTMLFormElement>('.day-panel');

			const today = new Date().toLocaleDateString('sv-SE'); // YYYY-MM-DD (현지 시간)
			// 시즌 = 7/1 ~ 6/30 (서버도 같음): 2026-12-13 → '26-27'
			const seasonOf = (date: string) => {
				const [y, m] = date.split('-').map(Number);
				const s = (m >= 7 ? y : y - 1) % 100;
				return `${String(s).padStart(2, '0')}-${String(s + 1).padStart(2, '0')}`;
			};
			const WD = ['일', '월', '화', '수', '목', '금', '토'];
			const label = (date: string) => {
				const [y, m, d] = date.split('-').map(Number);
				return `${m}월 ${d}일 ${WD[new Date(y, m - 1, d).getDay()]}`;
			};

			const shift = (date: string, days: number) => {
				const [y, m, d] = date.split('-').map(Number);
				return new Date(y, m - 1, d + days).toLocaleDateString('sv-SE');
			};
			const weekStart = (date: string) => shift(date, -new Date(`${date}T00:00`).getDay()); // 그 주 일요일

			// 보기: 넓은 화면은 늘 한 달(사용자 요구 2026-10-23 — 옆 명단 칸 높이가 3주 달력에 안 맞아서).
			// 좁은 화면(860px 이하, 명단이 달력 아래)만 기본 3주(지난주, 이번 주, 다음 주) + '한 달 보기' 버튼. 고른 보기는 이 브라우저에 기억
			const VIEW_KEY = 'fs-room-view';
			const narrow = matchMedia('(max-width: 860px)');
			const wanted = (): 'weeks' | 'month' => (narrow.matches && localStorage.getItem(VIEW_KEY) !== 'month' ? 'weeks' : 'month');
			let view = wanted();
			let month = today.slice(0, 7); // 'YYYY-MM' (한 달 보기)
			let start = shift(weekStart(today), -7); // 3주 보기 첫날(일요일)
			let selected = today;
			const seasons: Record<string, { nights: Night[]; rides: Ride[] | null; lessons: string[] | null }> = {}; // 시즌별로 한 번 불러와서 달 이동은 바로
			// 불러온 시즌 전부 (3주가 시즌 경계 7/1에 걸칠 수 있어서). rides가 없는 시즌이 있으면(예전 서버) 출격 숨김
			const loaded = () => {
				const list = Object.values(seasons);
				return {
					nights: list.flatMap((x) => x.nights),
					rides: list.length && list.every((x) => x.rides) ? list.flatMap((x) => x.rides!) : null,
					lessons: list.length && list.every((x) => x.lessons) ? list.flatMap((x) => x.lessons!) : null, // 내 강습 요청 날짜 (없으면 예전 서버 → 버튼 숨김)
				};
			};
			// 화면에 보일 날짜 (한 달 보기는 첫 주 앞 빈 칸 수도)
			const visible = (): { dates: string[]; blanks: number } => {
				if (view === 'weeks') return { dates: Array.from({ length: 21 }, (_, i) => shift(start, i)), blanks: 0 };
				const [y, m] = month.split('-').map(Number);
				const last = new Date(y, m, 0).getDate();
				return { dates: Array.from({ length: last }, (_, i) => `${month}-${String(i + 1).padStart(2, '0')}`), blanks: new Date(y, m - 1, 1).getDay() };
			};
			// 보일 날짜의 시즌 중 아직 안 불러온 것만 불러옴. 하나라도 실패하면 false
			async function ensure() {
				const { dates } = visible();
				const need = [...new Set([seasonOf(dates[0]), seasonOf(dates.at(-1)!)])].filter((x) => !seasons[x]);
				if (!need.length) return true;
				box.setAttribute('aria-busy', 'true');
				const ok = (await Promise.all(need.map((x) => room(x)))).every(Boolean);
				box.setAttribute('aria-busy', 'false');
				return ok;
			}

			const back = `${loginUrl}?next=${encodeURIComponent(location.pathname)}`;
			// 시즌방 API (op 있으면 체크, 취소). 실패하면 null
			async function room(season: string, body: object = {}) {
				const res = await call({ action: 'seasonroom', token, season, ...body }).catch(() => null);
				if (res?.expired) {
					store.clear();
					location.replace(`${back}&expired`);
					return null;
				}
				if (!res?.ok) {
					alert(res?.error ?? '서버에 연결하지 못했어요. 잠시 뒤 다시 시도해 주세요.');
					return null;
				}
				// rides가 없으면 출격 기능이 없는 예전 서버 → 출격 버튼을 숨김 (예전 서버는 '출격'을 숙박으로 저장해 버림)
				return (seasons[season] = { nights: res.nights, rides: Array.isArray(res.rides) ? res.rides : null, lessons: Array.isArray(res.lessons) ? res.lessons : null });
			}

			// 버튼 묶음: [글자, op, kind, 진한 버튼?]
			const buttons = (list: [string, string, string, boolean][]) =>
				list.map(([text, op, kind, main]) => {
					const b = document.createElement('button');
					b.type = 'submit';
					b.className = `btn ${main ? 'btn-ink' : 'btn-line-dark'}`;
					b.textContent = text;
					b.dataset.op = op;
					b.dataset.kind = kind;
					return b;
				});
			const names = (list: { name: string; me: boolean; kind?: Kind; lesson?: boolean }[]) =>
				(list.length ? list : [null]).map((n) => {
					const li = document.createElement('li');
					// 주주는 여기선 따로 안 적음 (정산표에만)
					li.textContent = n ? `${n.name}${n.me ? ' (나)' : ''}${n.kind === '휴식' ? ' | 4시간 휴식' : ''}${n.lesson ? ' | 강습 요청' : ''}` : '아직 아무도 없어요.';
					li.className = n?.me ? 'me' : n ? '' : 'empty';
					return li;
				});

			function render() {
				const { nights, rides, lessons } = loaded();
				const { dates, blanks } = visible();
				const md = (date: string) => date.slice(5).split('-').map(Number).join('.'); // '10.11'
				$('.month-label').textContent = view === 'weeks' ? `${md(dates[0])} – ${md(dates.at(-1)!)}` : `${month.slice(0, 4)}년 ${Number(month.slice(5))}월`;
				$('.view-btn').textContent = view === 'weeks' ? '한 달 보기' : '3주 보기';
				$('.month-prev').ariaLabel = view === 'weeks' ? '이전 주' : '이전 달';
				$('.month-next').ariaLabel = view === 'weeks' ? '다음 주' : '다음 달';

				// 달력 칸마다 숫자만 — 출격 N명 / 숙박 N명(휴식 포함)
				const days = $('.days');
				const cells: HTMLElement[] = [];
				for (let i = 0; i < blanks; i++) cells.push(document.createElement('span'));
				for (const date of dates) {
					const d = Number(date.slice(8));
					const stay = nights.filter((n) => n.date === date);
					const ride = (rides ?? []).filter((n) => n.date === date);
					const mine = stay.some((n) => n.me) || ride.some((n) => n.me);
					const b = document.createElement('button');
					b.type = 'button';
					b.className = 'day';
					b.classList.toggle('is-mine', mine);
					b.classList.toggle('is-today', date === today);
					b.setAttribute('aria-pressed', String(date === selected));
					b.ariaLabel = `${label(date)}, 출격 ${ride.length}명, 숙박 ${stay.length}명${mine ? ', 나도 있음' : ''}`;
					const num = document.createElement('span');
					num.className = 'num';
					num.textContent = view === 'weeks' && (d === 1 || date === dates[0]) ? md(date) : String(d); // 3주 보기는 달이 바뀌는 날에 '11.1'
					b.append(num);
					for (const [text, n] of [['출격', ride.length], ['숙박', stay.length]] as const) {
						if (!n) continue;
						const line = document.createElement('span');
						line.className = 'count';
						line.textContent = `${text} ${n}명`;
						b.append(line);
					}
					b.addEventListener('click', () => {
						selected = date;
						render();
					});
					cells.push(b);
				}
				days.replaceChildren(...cells);

				// 고른 날: 출격 명단 + 시즌방 명단, 내 체크 / 바꾸기 / 취소 (지난 날짜도 자유롭게)
				$('.day-title').textContent = label(selected);
				const dayRides = (rides ?? []).filter((n) => n.date === selected);
				$('.ride-group').hidden = !rides;
				$('.ride-title').textContent = `출격 ${dayRides.length}명`;
				// 강습 요청: 내가 출격한 날만 버튼. 요청은 나만 보임(다른 회원 요청은 서버가 안 보냄) → 운영진이 따로 연결
				const rode = dayRides.some((n) => n.me);
				const asked = !!lessons?.includes(selected);
				$('.ride-names').replaceChildren(...names(dayRides.map((n) => ({ ...n, lesson: n.me && asked }))));
				$('.ride-actions').replaceChildren(
					...buttons(
						!rode
							? [['출격', 'add', '출격', true]]
							: [['출격 취소', 'remove', '출격', false], ...(lessons ? [asked ? ['강습 요청 취소', 'remove', '강습', false] : ['강습 요청', 'add', '강습', false]] : [])] as [string, string, string, boolean][],
					),
				);
				$('.lesson-note').hidden = !asked;

				const who = nights.filter((n) => n.date === selected);
				const mine = who.find((n) => n.me);
				$('.stay-title').textContent = `시즌방 ${who.length}명`;
				$('.stay-names').replaceChildren(...names(who));
				$('.stay-actions').replaceChildren(
					...buttons(
						!mine
							? [['시즌방 숙박', 'add', '숙박', true], ['4시간 휴식', 'add', '휴식', false]]
							: mine.kind === '숙박'
								? [['4시간 휴식으로 변경', 'add', '휴식', false], ['취소', 'remove', '', false]]
								: [['시즌방 숙박으로 변경', 'add', '숙박', false], ['취소', 'remove', '', false]],
					),
				);
			}

			// ‹ ›: 3주 보기는 한 주씩, 한 달 보기는 한 달씩. 오늘이 보이면 오늘, 아니면 첫날을 고름
			async function go(delta: number) {
				if (view === 'weeks') start = shift(start, 7 * delta);
				else {
					const [y, m] = month.split('-').map(Number);
					month = new Date(y, m - 1 + delta, 1).toLocaleDateString('sv-SE').slice(0, 7);
				}
				const { dates } = visible();
				selected = dates.includes(today) ? today : dates[0];
				await ensure();
				render();
			}
			$('.month-prev').addEventListener('click', () => go(-1));
			$('.month-next').addEventListener('click', () => go(1));
			// 3주 ↔ 한 달: 고른 날이 보이게 맞춤
			async function setView(next: 'weeks' | 'month') {
				if (next === view) return;
				view = next;
				if (view === 'month') month = selected.slice(0, 7);
				else start = shift(weekStart(selected), -7);
				await ensure();
				render();
			}
			$('.view-btn').addEventListener('click', () => {
				try { localStorage.setItem(VIEW_KEY, view === 'weeks' ? 'month' : 'weeks'); } catch {}
				setView(view === 'weeks' ? 'month' : 'weeks');
			});
			narrow.addEventListener('change', () => setView(wanted())); // 창 크기를 바꾸면 그 화면 규칙으로

			// 누른 버튼만 스피너, 나머지 버튼은 잠금
			panel.addEventListener('submit', async (e) => {
				e.preventDefault();
				const btn = e.submitter as HTMLButtonElement | null;
				if (!btn) return;
				const { op, kind } = btn.dataset;
				panel.querySelectorAll('button').forEach((b) => (b.disabled = true));
				btn.classList.add('is-loading');
				btn.textContent = op === 'remove' ? '취소 중' : '저장 중';
				await room(seasonOf(selected), { op, kind, date: selected });
				render();
			});

			// 로그인 안 했으면 로그인 화면으로 (로그인 후 이 페이지로 돌아옴)
			if (!token) location.replace(back);
			else if (await ensure()) {
				msg.remove();
				box.hidden = false;
				render();
			} else msg.textContent = '시즌방 기록을 불러오지 못했어요. 잠시 뒤 새로고침해 주세요.';
		</script>
	</body>
</html>

<style>
	.room {
		display: grid;
		gap: 20px;
		max-width: 1100px;
	}
	/* 달력 | 고른 날 명단. 명단 칸은 높이를 0으로 두고 칸 높이(=달력)까지 늘려서, 넘치면 안에서 스크롤 */
	.room-main {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 320px;
		gap: 20px;
	}
	.cal-col {
		display: grid;
		gap: 16px;
		align-content: start;
	}
	@media (max-width: 860px) {
		.room-main {
			grid-template-columns: 1fr;
		}
	}
	.room[aria-busy='true'] {
		opacity: 0.6;
		cursor: progress;
	}
	/* ‹ 2026년 10월 › — 달력 폭 기준 가운데 */
	.room-head {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
	}
	.month-label {
		min-width: 7em;
		text-align: center;
		font: clamp(1.6rem, 3.5vw, 2.4rem) var(--display);
		font-weight: 400;
	}
	.month-btn {
		width: 44px;
		height: 44px;
		border: 1.5px solid var(--black);
		background: var(--white);
		font-size: 22px;
		line-height: 1;
		cursor: pointer;
	}
	.month-btn:hover {
		background: var(--black);
		color: var(--white);
	}
	.room-hint {
		color: #4a4d55;
		font-size: 14px;
	}
	/* 3주 / 한 달 보기 전환 — 좁은 화면만 (넓은 화면은 늘 한 달) */
	.view-row {
		display: none;
		justify-content: flex-end;
		margin-bottom: -8px;
	}
	@media (max-width: 860px) {
		.view-row {
			display: flex;
		}
	}
	.view-btn {
		min-height: 32px;
		padding: 0 12px;
		border: 1.5px solid var(--black);
		background: var(--white);
		color: var(--black);
		font: 700 12px 'Noto Sans KR', sans-serif;
		cursor: pointer;
	}
	/* 달력: 요일 줄 + 날짜 칸 (JS가 만든 칸이라 :global) */
	.cal {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 4px;
	}
	.wd {
		padding: 4px 0;
		text-align: center;
		font-size: 12px;
		font-weight: 700;
		color: #4a4d55;
	}
	.wd:first-child {
		color: #b3261e;
	}
	.days {
		display: contents;
	}
	.cal :global(.day) {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 2px;
		min-height: 80px;
		padding: 8px;
		border: 1px solid var(--line);
		background: var(--white);
