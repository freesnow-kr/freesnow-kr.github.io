---
import { club } from '../data/club';
import Meta from '../components/Meta.astro';
import '../styles/ride.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // 끝 슬래시 없이 (scripts/session.ts 참고)
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<Meta title={`${club.name} — Password`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/`}><img src={`${base}/logo-white.png`} alt="FREE SNOW" width="91" height="44" /></a>
			<nav id="site-nav" aria-label="메인">
				<a href={`${base}/#season`}>SEASON</a>
				<a href={`${base}/board/`}>BOARD</a>
				<a href={`${base}/gallery/`}>GALLERY</a>
				<a href={`${base}/webcam/`}>WEBCAM</a>
				<a href={`${base}/rank/`}>CHAT RANK</a>
				<a href={`${base}/shredlog/`}>SHRED LOG</a>
				<a href={`${base}/seasonroom/`}>RIDE &amp; STAY</a>
			</nav>
			<a class="nav-join" href={`${base}/login/`}>LOGIN</a>
			<button class="nav-menu" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="site-nav">☰</button>
		</header>

		<main>
			<section class="mem-intro">
				<p class="kicker">MEMBERS ONLY</p>
				<h1>PASSWORD.</h1>
			</section>

			<section class="mem-body">
				{!club.api && <p class="mem-msg">비밀번호 변경은 준비 중이에요.</p>}

				<!-- ?first: 첫 전환(생년월일로 로그인)·초기화 비밀번호로 들어온 경우 → 지금 비밀번호 칸 없이 -->
				<form class="pw" hidden={!club.api}>
					<h2>비밀번호 변경</h2>
					<p class="first-note" hidden>처음 로그인했거나 비밀번호를 초기화했어요. 앞으로 쓸 새 비밀번호를 정해 주세요.</p>
					<label class="current">
						지금 비밀번호
						<input name="current" type="password" autocomplete="current-password" />
					</label>
					<label>
						새 비밀번호
						<input name="next" type="password" autocomplete="new-password" minlength="8" maxlength="128" required />
					</label>
					<label>
						새 비밀번호 확인
						<input name="again" type="password" autocomplete="new-password" minlength="8" maxlength="128" required />
					</label>
					<p class="mem-hint">8자 이상. 생년월일·전화번호가 들어간 비밀번호는 쓸 수 없어요.</p>
					<button class="btn btn-ink" type="submit">비밀번호 바꾸기</button>
					<p class="mem-error" role="alert"></p>
				</form>

				<div class="pw-done" hidden>
					<h2>비밀번호를 바꿨어요.</h2>
					<p class="mem-hint">다른 기기에서는 다시 로그인해 주세요.</p>
					<a class="btn btn-ink pw-go" href={`${base}/`}>계속하기</a>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-row">
				<span>{club.footer}</span>
			</div>
			<p class="giant" aria-hidden="true">FREE SNOW</p>
		</footer>

		<script>
			import { base, busy, call, loginUrl, membersUrl, store } from '../scripts/session';

			const form = document.querySelector<HTMLFormElement>('.pw')!;
			const error = form.querySelector<HTMLElement>('.mem-error')!;
			const q = new URLSearchParams(location.search);
			const first = q.has('first');
			// 다 바꾼 뒤 갈 곳: 이 사이트 안 주소만 (login.astro와 같은 규칙), 기본은 회원 페이지
			const want = q.get('next') ?? '';
			const next = want.startsWith(`${base}/`) && !want.startsWith('//') ? want : membersUrl;
			const token = store.get();

			if (!token) location.replace(loginUrl);
			if (first) {
				form.querySelector<HTMLElement>('.current')!.hidden = true;
				form.querySelector<HTMLElement>('.first-note')!.hidden = false;
			}

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				error.textContent = '';
				const data = new FormData(form);
				if (data.get('next') !== data.get('again')) {
					error.textContent = '새 비밀번호가 서로 달라요.';
					return;
				}
				busy(form, true, '바꾸는 중…');
				const res = await call({ action: 'password', token, current: data.get('current'), next: data.get('next') }).catch(() => null);
				if (res?.expired) {
					store.clear();
					location.replace(`${loginUrl}?expired`);
					return;
				}
				if (!res?.ok) {
					busy(form, false, '');
					error.textContent = res?.error ?? '서버에 연결하지 못했어요. 잠시 뒤 다시 시도해 주세요.';
					return;
				}
				form.hidden = true;
				const done = document.querySelector<HTMLElement>('.pw-done')!;
				done.querySelector<HTMLAnchorElement>('.pw-go')!.href = next;
				done.hidden = false;
			});
		</script>
	</body>
</html>

<style>
	.pw,
	.pw-done {
		display: grid;
		gap: 18px;
		max-width: 420px;
	}
	.pw h2,
	.pw-done h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		font-weight: 900;
		letter-spacing: -0.03em;
	}
	.pw label {
		display: grid;
		gap: 8px;
		font-size: 14px;
		font-weight: 700;
	}
	.pw input {
		min-height: 52px;
		padding: 0 16px;
		border: 1.5px solid var(--black);
		background: var(--white);
		font: inherit;
		font-size: 17px;
		font-weight: 400;
	}
	.first-note {
		font-weight: 700;
	}
	.mem-error {
		color: #c4320a;
		font-weight: 700;
		min-height: 1.6em;
	}
	.mem-hint {
		font-size: 14px;
		color: #4a4d55;
	}
	.pw-done .btn {
		justify-content: center;
	}
</style>
