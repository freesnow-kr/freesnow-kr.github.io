# .env 로 복사해서 값 채우기 (로컬 개발용). 배포 값은 GitHub 저장소 Settings > Secrets and variables > Actions 에 같은 이름으로
PUBLIC_JOIN_URL=
PUBLIC_SOMOIM_URL=
# API 서버 (Cloudflare Worker). 로컬에서 backend를 띄워 볼 땐 http://localhost:8787
PUBLIC_API_URL=https://api.freesnow.workers.dev
# 선택: 안드로이드 APK 내려받기 주소 (구글 드라이브 https://drive.google.com/uc?export=download&id=파일ID). 비우면 /app/ 에서 APK 안내 숨김
PUBLIC_APK_URL=
