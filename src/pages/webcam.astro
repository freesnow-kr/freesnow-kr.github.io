---
import { club } from '../data/club';
import Meta from '../components/Meta.astro';
import '../styles/ride.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // 끝 슬래시 없이 (scripts/session.ts 참고)

// 각 스키장 공식 웹캠 페이지 (2026-10 확인). 주소 바뀌면 여기만 수정
// embed: 공식 페이지를 이 페이지 안에 띄움 (지산은 사이트가 iframe을 막아서 링크로)
// cams: 영상(HLS)을 이 페이지에서 바로 재생 (사용자 결정 2026-11-10: 스키장 허락 없이 공식 웹캠 영상 주소를 씀 — 막히면 끊김, 그땐 cams를 빼면 공식 페이지 embed로 돌아감)
// 지역 → 스키장. id는 src/data/resorts.json(날씨)과 같음. 화면은 위 스키장 고르기 + 고른 스키장 하나 (사용자 요구 2026-11-10: snowthing.org처럼)
// 캠 목록: [이름, 주소]. .m3u8은 이 페이지에서 영상(HLS)으로, 그 밖(유튜브, 외부 플레이어)은 iframe으로 (snowthing.org가 쓰는 주소, 2026-11-10 확인)
const hls = (base: string, list: [string, string][]) => list.map(([name, path]) => ({ name, src: base + path }));
const regions = [
	{
		name: '강원',
		resorts: [
			{
				id: 'yongpyong', name: '모나 용평', site: 'https://www.yongpyong.co.kr', embed: true, url: 'https://www.yongpyong.co.kr/kor/guide/realTimeNews/ypResortWebcam.do', note: 'HD 웹캠 5곳',
				cams: hls('https://live.yongpyong.co.kr/', [['발왕산 스카이워크', 'cam01/index.m3u8'], ['발왕산 천년주목숲길', 'cam02/index.m3u8'], ['옐로우 슬로프', 'cam11/index.m3u8'], ['베이스 전경 / 레드 슬로프', 'cam08/index.m3u8'], ['진입로', 'cam05/index.m3u8']]),
			},
			{ id: 'high1', name: '하이원', site: 'https://www.high1.com', url: 'https://www.high1.com/ski/slopeView.do?key=748&mode=p', note: '슬로프별 웹캠 | 새 탭에서' },
			{
				id: 'phoenix', name: '휘닉스 평창', site: 'https://phoenixhnr.co.kr', embed: true, url: 'https://phoenixhnr.co.kr/', note: '슬로프별 웹캠 7곳',
				cams: hls('https://streaming.phoenixhnr.co.kr/hls/', [['호크 / 스패로우', 'yh_02_02.m3u8'], ['도도', 'sp_01_01.m3u8'], ['불새마루', 'ht_01_01.m3u8'], ['베이스', 'bc_02_01.m3u8'], ['루지랜드', 'bc_01.m3u8'], ['스노우 빌리지', 'yh_01_01.m3u8'], ['몽블랑 정상', 'mb_03_02.m3u8']]),
			},
			{ id: 'vivaldi', name: '비발디파크', site: 'https://www.sonohotelsresorts.com/daemyung.vp.main.ds/dmparse.dm', url: 'https://mice.sonohotelsresorts.com/daemyung.vp.utill.09_02_02_01.ds/dmparse.dm?areaType=S', note: '온라인캠 | 새 탭에서' },
			{
				id: 'welli', name: '웰리힐리파크', site: 'https://wellihillipark.com', embed: true, url: 'https://wellihillipark.com/home/customer/webcam', note: '실시간 HD 웹캠 6곳',
				cams: hls('https://live.wellihillipark.com/wellihillipark/_definst_/', [['알파', 'cam02.stream/playlist.m3u8'], ['베이스', 'cam03.stream/playlist.m3u8'], ['슬로프 광장 / 전경', 'cam04.stream/playlist.m3u8'], ['정상 광장', 'cam05.stream/playlist.m3u8'], ['슬로프 전경', 'cam06.stream/playlist.m3u8'], ['워터플래닛', 'cam07.stream/playlist.m3u8']]),
			},
			{
				id: 'gangchon', name: '엘리시안 강촌', site: 'https://www.elysian.co.kr', embed: true, url: 'https://www.elysian.co.kr/about-gangchon/ski#guide-to-using-slopes', note: '유튜브 라이브',
				cams: [{ name: '실시간 영상', src: 'https://www.youtube.com/embed/O6_8VBu4FSA?autoplay=1&mute=1' }],
			},
			{
				id: 'alpensia', name: '알펜시아', site: 'https://www.alpensia.com', embed: true, url: 'https://www.alpensia.com/guide/web-cam.do', note: '유튜브 라이브',
				cams: [{ name: '알펜시아 라이브캠', src: 'https://www.youtube.com/embed/vvRfdby4YxI?autoplay=1&mute=1' }],
			},
			{
				id: 'oak', name: '오크밸리', site: 'https://oakvalley.co.kr', embed: true, url: 'https://oakvalley.co.kr/ski/introduction/realtime', note: '스키광장 | 슬로프별 실시간',
				cams: hls('https://cctv-oak9.ktcdn.co.kr/cctv/', [['베이스', 'ch2.stream/chunklist.m3u8'], ['I 슬로프', 'ch9.stream/chunklist.m3u8'], ['G 슬로프 하단', 'ch7.stream/chunklist.m3u8'], ['F 슬로프 상단', 'ch6.stream/chunklist.m3u8'], ['플라워 휴게소', 'ch5.stream/chunklist.m3u8']]),
			},
			{ id: 'o2', name: '오투리조트', site: 'https://www.o2resort.com', url: 'https://www.o2resort.com', note: '공식 사이트 웹캠' },
		],
	},
	{
		name: '경기',
		resorts: [
			{
				id: 'konjiam', name: '곤지암', site: 'https://www.konjiamresort.co.kr', embed: true, url: 'https://m.konjiamresort.co.kr/ski/skiLveCam.dev', note: '라이브캠 5곳 | 24시간',
				cams: hls('https://video.fpkorea.com/konjiam/', [['정상 휴게소', 'cam01.stream/playlist.m3u8'], ['정상부 슬로프 (씽큐, 그램)', 'cam02.stream/playlist.m3u8'], ['초중급 베이스 (휘센)', 'cam03.stream/playlist.m3u8'], ['중상급 베이스 (와이낫, CNP)', 'cam04.stream/playlist.m3u8'], ['중간 슬로프 (와이낫 상단)', 'cam05.stream/playlist.m3u8']]),
			},
			{
				id: 'jisan', name: '지산 포레스트', site: 'https://www.jisanresort.co.kr', url: 'https://www.jisanresort.co.kr/m/ski/slopes/webcam.asp', note: '탑승장 | 슬로프 웹캠',
				cams: hls('https://ant.livecity.co.kr:5443/jisancam/streams/', [['레몬 탑승장', 'jisan1.m3u8'], ['오렌지 / 뉴오렌지 탑승장', 'jisan2.m3u8'], ['5번 / 6번 슬로프', 'jisan3.m3u8'], ['블루 탑승장', 'jisan4.m3u8'], ['실버 탑승장', 'jisan5.m3u8']]),
			},
		],
	},
	{
		name: '전북',
		resorts: [{
			id: 'muju', name: '무주 덕유산', site: 'https://www.mdysresort.com', embed: true, url: 'https://www.mdysresort.com/guide/webcam.asp', note: '슬로프별 웹캠 11곳',
			cams: [
				['만선하우스', '01'], ['만선봉 정상', '02'], ['하이디하우스', '03'], ['서역기행 / 썬다운', '04'], ['설천하우스', '05'], ['설천 상단 슬로프', '06'],
				['설천봉 정상', '07'], ['모차르트 / 미뉴에트', '08'], ['폴카', '09'], ['실크로드 / 미뉴에트 하단', '10'], ['커넥션', '11'],
			].map(([name, n]) => ({ name, src: `${club.api}/cam/muju/start/${n}` })),
		}],
	},
	{
		name: '경남',
		resorts: [
			{
				id: 'eden', name: '에덴밸리', site: 'https://www.edenvalley.co.kr', url: 'https://www.edenvalley.co.kr', note: '웹캠 2곳',
				cams: [{ name: '베이직', src: 'https://rtsp.ru/embed/nKGZGiRD/' }, { name: '슬로프 광장', src: 'https://rtsp.ru/embed/dh6R7d4k/' }],
			},
		],
	},
];
// 지역 순서대로, 지역 안에선 가나다. 처음엔 곤지암 (영상이 바로 나오는 곳)
type Resort = { id: string; name: string; site: string; url: string; note: string; embed?: boolean; cams?: { name: string; src: string }[] };
const ordered = regions.flatMap((r) => (r.resorts as Resort[]).toSorted((a, b) => a.name.localeCompare(b.name, 'ko')).map((c) => ({ ...c, region: r.name })));
// 영상 바로 재생되는 곳 먼저, 공식 웹캠 버튼만 있는 곳(하이원·비발디·오투)은 맨 뒤로 (사용자 요구 2026-11-10)
const resorts = [...ordered.filter((c) => c.cams), ...ordered.filter((c) => !c.cams)];
const first = 'konjiam';
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<Meta title={`${club.name} — Live Cams`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/`}><img src={`${base}/logo-white.png`} alt="FREE SNOW" width="103" height="50" /></a>
			<nav id="site-nav" aria-label="메인">
				<a href={`${base}/#season`}>SEASON</a>
				<a href={`${base}/board/`}>BOARD</a>
				<a href={`${base}/gallery/`}>GALLERY</a>
				<a href={`${base}/webcam/`} aria-current="page">WEBCAM</a>
				<a href={`${base}/rank/`}>CHAT RANK</a>
				<a href={`${base}/shredlog/`}>SHRED LOG</a>
				<a href={`${base}/seasonroom/`}>RIDE &amp; STAY</a>
			</nav>
			<a class="nav-join" href={`${base}/login/`}>LOGIN</a>
			<button class="nav-menu" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="site-nav">☰</button>
		</header>

		<main>
			<section class="cam-intro">
				<p class="kicker"><span class="live-dot"></span>LIVE</p>
				<h1>SLOPE<br />CAMS.</h1>
				<p class="lede">출발 전에 슬로프 상태 먼저. 각 스키장 공식 웹캠으로 바로 연결돼요.</p>
			</section>

			<section class="cam-body">
				<nav class="cam-pick" aria-label="스키장 고르기">
					{resorts.map((c) => (
						<a href={`#${c.id}`} data-id={c.id} aria-current={c.id === first ? 'true' : undefined}>
							<span class="cam-pick-name">{c.name}</span>
							<span class="cam-pick-wx" data-resort={c.id}></span>
						</a>
					))}
				</nav>
				{/* 모바일은 알약 대신 선택 박스 (터치 기기는 picker.ts가 편한 선택 시트로 바꿈) */}
				<select class="cam-select" aria-label="스키장 고르기">
					{resorts.map((c) => <option value={c.id} data-resort={c.id} data-name={c.name}>{c.name}</option>)}
				</select>

				{resorts.map((c) => (
					<article class="cam-panel" id={c.id} data-id={c.id} hidden={c.id !== first}>
						<header class="cam-top">
							<div>
								<p class="cam-chips">
									<span>{c.region}</span>
									{c.cams ? <span>{c.cams.length > 1 ? `카메라 ${c.cams.length}개` : '실시간 영상'}</span> : <span>{c.embed ? '공식 페이지' : '공식 페이지 링크'}</span>}
									{c.cams && <span class="on">영상 바로 보기</span>}
								</p>
								<h2>{c.name}</h2>
								<p class="cam-note">{c.note}</p>
							</div>
							<div class="cam-side">
								<p class="cam-wx" data-resort={c.id}></p>
								<a class="cam-btn" href={c.url} target="_blank" rel="noopener">공식 웹캠 ↗</a>
								{/* 스키장 공식 사이트 (슬로프 지도, 개장 현황, 셔틀버스, 리프트권은 여기서 — 사용자 요구 2026-10-29. 깊은 주소는 자주 바뀌어서 첫 화면만, 확인 2026-10) */}
								<a class="cam-btn" href={c.site} target="_blank" rel="noopener" title="슬로프 지도, 개장 현황, 셔틀, 리프트권">공식 사이트 ↗</a>
							</div>
						</header>

						{c.cams ? (
							<ul class={`cam-grid${c.cams.length === 1 ? ' one' : ''}`}>
								{c.cams.map((v, i) => (
									<li class="cam-card" data-i={i}>
										<p class="cam-card-head">
											<span>{v.name}</span>
											<button type="button" class="cam-full" aria-label={`${v.name} 전체 화면`}>⤢</button>
										</p>
										<div class="cam-frame">
											{/youtube\.com|rtsp\.ru/.test(v.src) ? (
												<iframe data-src={v.src} title={`${c.name} ${v.name} 실시간 웹캠`} allow="autoplay; fullscreen" allowfullscreen></iframe>
											) : (
												<>
													<video data-src={v.src} muted playsinline aria-label={`${c.name} ${v.name} 실시간 웹캠`}></video>
													<p class="cam-state">연결 중…</p>
												</>
											)}
										</div>
									</li>
								))}
							</ul>
						) : c.embed ? (
							<div class="cam-card">
								<div class="cam-screen"><iframe data-src={c.url} title={`${c.name} 공식 웹캠`} allow="autoplay; fullscreen"></iframe></div>
							</div>
						) : (
							<div class="cam-card cam-link">
								<p>{c.name}은 여기서 바로 재생되지 않아 공식 웹캠을 새 탭에서 열어요.</p>
								<a class="cam-btn ink" href={c.url} target="_blank" rel="noopener">공식 웹캠 열기 ↗</a>
							</div>
						)}
					</article>
				))}
			</section>

			<p class="cam-fine">
				웹캠은 각 스키장이 운영하며, 시즌 외 기간이나 야간에는 꺼져 있거나 어둡게 보일 수 있어요.
			</p>
		</main>

		<footer class="footer">
			<div class="footer-row">
				<span>{club.footer}</span>
			</div>
			<p class="giant" aria-hidden="true">FREE SNOW</p>
		</footer>
		<script>
			import '../scripts/session';
			import { deg, sky, snow, weather } from '../scripts/weather';

			// 스키장 날씨 (사용자 요구 2026-10-29): 지금 기온 + 오늘 최저/최고 + 눈. id는 src/data/resorts.json과 같음
			weather().then((list) => {
				const byId = new Map(list.map((r) => [r.id, r]));
				// 고른 스키장 카드 오른쪽 큰 날씨 상자
				for (const el of document.querySelectorAll<HTMLElement>('.cam-wx')) {
					const w = byId.get(el.dataset.resort!);
					if (!w) continue;
					const d = w.days[0];
					const big = document.createElement('b');
					big.textContent = `${sky(w.now.code)[0]} ${deg(w.now.temp)}`;
					const small = document.createElement('small');
					small.textContent = [sky(w.now.code)[1], d && `오늘 ${deg(d.min)} / ${deg(d.max)}`, d && snow(d.snow)].filter(Boolean).join(' | ');
					el.replaceChildren(big, small);
				}
				// 스키장 고르기 칸: 이름 아래 아이콘 + 지금 기온 (눈이면 뒤에 붙임)
				for (const el of document.querySelectorAll<HTMLElement>('.cam-pick-wx')) {
					const w = byId.get(el.dataset.resort!);
					if (!w) continue;
					el.textContent = [`${sky(w.now.code)[0]} ${deg(w.now.temp)}`, snow(w.days[0]?.snow ?? 0)].filter(Boolean).join(' ');
				}
				// 모바일 선택 박스 항목에도 이름 옆에 날씨
				for (const opt of document.querySelectorAll<HTMLOptionElement>('.cam-select option')) {
					const w = byId.get(opt.dataset.resort!);
					if (w) opt.textContent = `${opt.dataset.name}  ${sky(w.now.code)[0]} ${deg(w.now.temp)}${snow(w.days[0]?.snow ?? 0) ? ' ' + snow(w.days[0]?.snow ?? 0) : ''}`;
				}
			});

			// 영상(HLS) 하나: Safari, 최신 Chrome은 기본으로, 그 밖엔 hls.js (처음 쓸 때만 불러옴)
			type Player = { start(): void; stop(): void };
			// 연결 안 되는 캠(실패 or 일정 시간 안에 못 불러옴)은 그 스키장 격자 맨 뒤로 (사용자 요구 2026-11-10).
			// 꺼진 카드에 .off를 달고, .off 카드만 원래 순서대로 끝으로 모음 (재생 중 카드는 DOM에서 안 옮겨서 안 끊김)
			const sink = (video: HTMLVideoElement) => {
				const card = video.closest<HTMLElement>('.cam-card');
				const grid = card?.parentElement;
				if (!card || !grid) return;
				card.classList.add('off');
				[...grid.querySelectorAll<HTMLElement>('.cam-card.off')]
					.sort((a, b) => Number(a.dataset.i) - Number(b.dataset.i))
					.forEach((c) => grid.appendChild(c));
			};
			const CONNECT_WAIT = 12000; // 이 시간 안에 영상이 안 뜨면 꺼진 걸로 보고 뒤로
			const player = (video: HTMLVideoElement): Player => {
				const state = video.parentElement!.querySelector<HTMLElement>('.cam-state')!;
				let hls: { destroy(): void } | null = null;
				let on = false;
				let timer = 0;
				const show = (text: string) => ((state.textContent = text), (state.hidden = !text));
				const offline = () => { show('지금은 영상을 불러오지 못했어요. 위 \'공식 웹캠\'에서 봐 주세요.'); sink(video); };
				const fail = () => on && offline();
				const live = () => { clearTimeout(timer); show(''); }; // 영상이 떴음 → 안내 지우고 그대로 둠
				video.addEventListener('playing', live);
				video.addEventListener('loadeddata', live);
				video.addEventListener('error', fail);
				const stop = () => {
					on = false;
					clearTimeout(timer);
					hls?.destroy();
					hls = null;
					video.removeAttribute('src');
					video.load();
				};
				return {
					stop,
					async start() {
						if (on) return;
						on = true;
						show('연결 중…');
						clearTimeout(timer);
						timer = window.setTimeout(() => { if (on && video.readyState < 1) offline(); }, CONNECT_WAIT);
						const src = video.dataset.src!;
						if (video.canPlayType('application/vnd.apple.mpegurl')) video.src = src;
						else {
							const { default: Hls } = await import('hls.js/dist/hls.light.mjs');
							if (!on) return;
							if (!Hls.isSupported()) return fail();
							const h = new Hls();
							h.on(Hls.Events.ERROR, (_e: unknown, d: { fatal: boolean }) => d.fatal && (fail(), h.destroy()));
							h.loadSource(src);
							h.attachMedia(video);
							hls = h;
						}
						video.play().catch(() => {});
					},
				};
			};

			// 유튜브, 외부 플레이어 캠: 보일 때 주소를 넣고 안 보이면 about:blank
			const framePlayer = (frame: HTMLIFrameElement): Player => ({
				start: () => void (frame.src !== frame.dataset.src && (frame.src = frame.dataset.src!)),
				stop: () => void (frame.src = 'about:blank'),
			});

			// 화면에 보이는 캠만 재생 (모바일 데이터 아끼기), 안 보이면 멈추고 연결 끊음
			const players = new Map<Element, Player>();
			const seen = new IntersectionObserver((list) => {
				for (const e of list) {
					const p = players.get(e.target)!;
					if (e.isIntersecting) p.start();
					else p.stop();
				}
			}, { threshold: 0.2 });
			for (const el of document.querySelectorAll<HTMLVideoElement | HTMLIFrameElement>('.cam-frame [data-src]')) {
				players.set(el, el instanceof HTMLVideoElement ? player(el) : framePlayer(el));
			}

			// 전체 화면 (아이폰 Safari는 video만 전체 화면 가능)
			for (const b of document.querySelectorAll<HTMLButtonElement>('.cam-full')) {
				b.addEventListener('click', () => {
					const v = b.closest('.cam-card')!.querySelector('.cam-frame [data-src]') as HTMLElement & { webkitEnterFullscreen?: () => void };
					if (v.requestFullscreen) v.requestFullscreen().catch(() => v.webkitEnterFullscreen?.());
					else v.webkitEnterFullscreen?.();
				});
			}

			// 스키장 고르기: 주소 #id (공유, 뒤로 가기), 마지막으로 본 곳 기억. 고른 곳만 영상, iframe을 엶
			const panels = [...document.querySelectorAll<HTMLElement>('.cam-panel')];
			const tabs = [...document.querySelectorAll<HTMLAnchorElement>('.cam-pick a')];
			const sel = document.querySelector<HTMLSelectElement>('.cam-select')!;
			const KEY = 'fs-cam';
			const pick = (id: string) => {
				const panel = panels.find((p) => p.dataset.id === id) ?? panels.find((p) => !p.hidden) ?? panels[0];
				for (const p of panels) {
					const open = p === panel;
					p.hidden = !open;
					for (const v of p.querySelectorAll('.cam-frame [data-src]')) {
						if (open) seen.observe(v);
						else (seen.unobserve(v), players.get(v)!.stop());
					}
					const frame = p.querySelector<HTMLIFrameElement>('.cam-screen iframe');
					if (frame) frame.src = open ? frame.dataset.src! : 'about:blank';
				}
				for (const t of tabs) t.toggleAttribute('aria-current', t.dataset.id === panel.dataset.id);
				if (sel.value !== panel.dataset.id) sel.value = panel.dataset.id!;
				try { localStorage.setItem(KEY, panel.dataset.id!); } catch {}
			};
			let saved = '';
			try { saved = localStorage.getItem(KEY) ?? ''; } catch {}
			pick(location.hash.slice(1) || saved);
			sel.addEventListener('change', () => { history.replaceState(null, '', `#${sel.value}`); pick(sel.value); });
			addEventListener('hashchange', () => pick(location.hash.slice(1)));
			// 고르면 스크롤이 패널로 튀지 않게 (해시만 바꿈)
			for (const t of tabs) t.addEventListener('click', (e) => {
				e.preventDefault();
				history.replaceState(null, '', `#${t.dataset.id}`);
				pick(t.dataset.id!);
			});
		</script>
	</body>
</html>

