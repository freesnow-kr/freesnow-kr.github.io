---
import { club } from '../data/club';
import Meta from '../components/Meta.astro';
import '../styles/ride.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // 끝 슬래시 없이 (scripts/session.ts 참고)
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<Meta title={`${club.name} — Login`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/`}><img src={`${base}/logo-white.png`} alt="FREE SNOW" width="103" height="50" /></a>
			<nav id="site-nav" aria-label="메인">
				<a href={`${base}/#season`}>SEASON</a>
				<a href={`${base}/board/`}>BOARD</a>
				<a href={`${base}/gallery/`}>GALLERY</a>
				<a href={`${base}/webcam/`}>WEBCAM</a>
				<a href={`${base}/rank/`}>CHAT RANK</a>
				<a href={`${base}/shredlog/`}>SHRED LOG</a>
				<a href={`${base}/seasonroom/`}>RIDE &amp; STAY</a>
			</nav>
			<a class="nav-join" href={`${base}/login/`} aria-current="page">LOGIN</a>
			<button class="nav-menu" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="site-nav">☰</button>
		</header>

		<main>
			<section class="mem-intro">
				<p class="kicker">MEMBERS ONLY</p>
				<h1>LOGIN.</h1>
			</section>

			<section class="mem-body">
				{!club.api && <p class="mem-msg">회원 로그인 준비 중이에요.</p>}

				<form class="login" hidden={!club.api}>
					<h2>회원 로그인</h2>
					<label>
						아이디
						<input name="phone" type="text" inputmode="numeric" autocomplete="username" placeholder="ex) 010 제외" required />
					</label>
					<label>
						비밀번호
						<input name="birth" type="password" autocomplete="current-password" required />
					</label>
					<button class="btn btn-ink" type="submit">로그인</button>
					<p class="mem-error" role="alert"></p>
				</form>

				<div class="join-box">
					<p>아직 회원이 아니신가요?</p>
					<a class="btn btn-line-dark" href={`${base}/signup/`}>회원가입</a>
					<p class="mem-hint">가입 신청 후 운영진이 확인 후 연락드립니다.</p>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-row">
				<span>{club.footer}</span>
			</div>
			<p class="giant" aria-hidden="true">FREE SNOW</p>
		</footer>

		<script>
			import { base, busy, call, passwordUrl, store } from '../scripts/session';

			const form = document.querySelector<HTMLFormElement>('.login')!;
			const error = form.querySelector<HTMLElement>('.mem-error')!;

			// 이미 로그인돼 있으면 회원 페이지로
			// 로그인 뒤 돌아갈 곳: 기본은 메인, ?next=/#season 등 이 사이트 안 주소면 거기로
			const want = new URLSearchParams(location.search).get('next') ?? '';
			const next = want.startsWith(`${base}/`) && !want.startsWith('//') ? want : `${base}/`;
			if (store.get()) location.replace(next);
			// 기억한 아이디 채우기
			const savedId = store.id();
			if (savedId) { form.phone.value = savedId; form.birth.focus(); }
			// 회원 페이지에서 토큰 만료로 돌아온 경우
			if (new URLSearchParams(location.search).has('expired')) error.textContent = '다시 로그인해 주세요.';

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				error.textContent = '';
				busy(form, true, '로그인 중…');
				const data = new FormData(form);
				// 로그인은 항상 30일 + 쓰는 동안 자동 연장 (session.ts). 아이디도 늘 기억
				const res = await call({ action: 'login', phone: data.get('phone'), birth: data.get('birth') }).catch(() => null);
				if (!res?.ok) {
					busy(form, false, '');
					error.textContent = res?.error ?? '서버에 연결하지 못했어요. 잠시 뒤 다시 시도해 주세요.';
					return;
				}
				store.set(res.token);
				// 브라우저가 저장을 막으면(Safari '모든 쿠키 차단' 등) 서버 로그인은 됐어도 다음 페이지에서 로그인 안 된 상태가 됨 → 조용히 넘어가지 말고 알림
				if (store.get() !== res.token) {
					busy(form, false, '');
					error.textContent = '이 브라우저가 로그인 정보 저장을 막고 있어요. Safari라면 설정 → Safari → \'모든 쿠키 차단\'을 끄고, 개인정보 보호 브라우징이 아닌 창에서 다시 로그인해 주세요.';
					return;
				}
				store.setId(String(data.get('phone')));
				try { localStorage.setItem('fs-member-renewed', String(Date.now())); } catch {}
				store.setName(res.name);
				// 첫 전환(생년월일로 로그인)·초기화 비밀번호로 들어왔으면 새 비밀번호부터
				location.href = res.mustChange ? `${passwordUrl}?first&next=${encodeURIComponent(next)}` : next;
			});
		</script>
	</body>
</html>

<style>
	.login {
		display: grid;
		gap: 18px;
		max-width: 420px;
	}
	.login h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		font-weight: 900;
		letter-spacing: -0.03em;
	}
	.login label {
		display: grid;
		gap: 8px;
		font-size: 14px;
		font-weight: 700;
	}
	.login input {
		min-height: 52px;
		padding: 0 16px;
		border: 1.5px solid var(--black);
		background: var(--white);
		font: inherit;
		font-size: 17px;
		font-weight: 400;
	}
	.mem-error {
		color: #c4320a;
		font-weight: 700;
		min-height: 1.6em;
	}
	.join-box {
		display: grid;
		gap: 12px;
		max-width: 420px;
		margin-top: 16px;
		padding-top: 28px;
		border-top: 1px solid var(--line);
	}
	.join-box > p:first-child {
		font-weight: 700;
	}
	.join-box .btn {
		justify-content: center;
	}
	.mem-hint {
		font-size: 14px;
		color: #4a4d55;
	}
</style>
