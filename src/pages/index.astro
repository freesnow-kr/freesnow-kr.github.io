---
import { club, faqs } from '../data/club';
import Meta from '../components/Meta.astro';
import '../styles/ride.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // 끝 슬래시 없이 (scripts/session.ts 참고)

const ticker = ['SKI', 'SNOWBOARD', 'CARPOOL', 'NIGHT RIDE', 'APRÈS', 'FIRST CHAIR'];

---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<Meta title={`${club.name} — Ride Together`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- API(Worker), 사진(드라이브) 서버에 미리 연결 -->
		<link rel="preconnect" href="https://api.freesnow.workers.dev" crossorigin />
		<link rel="preconnect" href="https://lh3.googleusercontent.com" />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href={`${base}/`}><img src={`${base}/logo-white.png`} alt="FREE SNOW" width="103" height="50" /></a>
			<nav id="site-nav" aria-label="메인">
				<a href="#season">SEASON</a>
				<a href={`${base}/board/`}>BOARD</a>
				<a href={`${base}/gallery/`}>GALLERY</a>
				<a href={`${base}/webcam/`}>WEBCAM</a>
				<a href={`${base}/rank/`}>CHAT RANK</a>
				<a href={`${base}/shredlog/`}>SHRED LOG</a>
				<a href={`${base}/seasonroom/`}>RIDE &amp; STAY</a>
			</nav>
			<a class="nav-join" href={`${base}/login/`}>LOGIN</a>
			<button class="nav-menu" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="site-nav">☰</button>
		</header>

		<main>
			<section class="hero">
				<video class="hero-art" autoplay muted loop playsinline poster={`${base}/hero.jpg`} aria-hidden="true">
					<source src={`${base}/hero.mp4`} type="video/mp4" />
				</video>
				<div class="hero-shade"></div>
				<button class="hero-sound" type="button" aria-pressed="false" aria-label="소리 켜기">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M4 9h4l5-4v14l-5-4H4z" />
						<path class="on" d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" />
						<path class="off" d="M17 9l5 6M22 9l-5 6" />
					</svg>
				</button>
				<button class="hero-pause" type="button" aria-label="배경 영상 일시정지">❚❚</button>
				<div class="hero-copy">
					<p class="kicker">2026 — 27 SEASON</p>
					<h1>RIDE<br />TOGETHER.</h1>
					<p class="lede">스키어와 보더가 함께 타는 동호회. 첫 리프트부터 마지막 런까지, 이번 시즌은 같이.</p>
					<div class="actions">
						<a class="btn btn-solid" href={club.joinUrl} target="_blank" rel="noopener">KAKAO OPEN CHAT</a>
						<a class="btn btn-line" href="#season">SEE THE SEASON</a>
					</div>
				</div>
			</section>

			<div class="ticker" aria-hidden="true">
				<div class="ticker-track">
					{[0, 1].map(() => ticker.map((t) => <span>{t}<i>✱</i></span>))}
				</div>
			</div>

			<!-- 고정 공지 (게시판 공지 중 운영진이 고정한 것, 없으면 안 보임) -->
			<section class="notice" aria-label="공지" hidden>
				<span class="notice-tag">NOTICE</span>
				<ul class="notice-list"></ul>
				<button class="notice-count" type="button" aria-label="다음 공지" hidden></button>
				<a class="notice-all" href={`${base}/board/?c=notice`}>전체 보기 →</a>
			</section>

			<!-- TODAY (사용자가 고른 시안 E, 2026-10-29): 왼쪽 흰 날씨 카드(엘리시안 강촌 지금 + 오늘, 내일 → 웹캠 페이지), 오른쪽 주황 카드(오늘 출격, 시즌방 인원 → RIDE & STAY)
			     하나만 있으면 그 카드가 가로 전체. 둘 다 없으면 안 보임 -->
			<section class="today" aria-label="오늘" hidden>
				<a class="today-wx" href={`${base}/webcam/`} hidden>
					<span class="today-icon" aria-hidden="true"></span>
					<span class="today-text">
						<span class="today-now"></span>
						<span class="today-days"></span>
					</span>
					<span class="today-go" aria-hidden="true">›</span>
				</a>
				<a class="today-crew" href={`${base}/seasonroom/`} hidden></a>
			</section>

			<section id="season" class="season">
				<div class="head">
					<h2>THE SEASON</h2>
					<p>소모임 정모 일정이에요.<br />참석 신청은 소모임에서 해 주세요.</p>
				</div>
				<!-- 소모임 공개 페이지의 '정모 일정' (backend/src/somoim.ts) -->
				<p class="mem-msg season-msg" role="status">정모 일정 불러오는 중…</p>
				<ol class="trip-list"></ol>
				<a class="season-more" href={club.somoimUrl} target="_blank" rel="noopener">소모임에서 전체 일정 보기 ↗</a>
			</section>

			<!-- 갤러리(드라이브 폴더) 최근 사진이 옆으로 흘러가는 띠. 사진 없으면 숨김 -->
			<section id="ride" class="reel" aria-label="갤러리 사진" hidden>
				<div class="reel-head">
					<h2>ON THE SLOPE.</h2>
					<div class="reel-ctrl">
						<button class="s-btn reel-pause" type="button" aria-label="사진 흐름 멈춤">❚❚</button>
						<a class="reel-all" href={`${base}/gallery/`}>갤러리 전체 보기 →</a>
					</div>
				</div>
				<!-- 두 줄: 윗줄은 왼쪽, 아랫줄은 오른쪽으로 흐름 -->
				<div class="reel-view"><div class="reel-track"></div></div>
				<div class="reel-view"><div class="reel-track reverse"></div></div>
			</section>

			<section class="manifesto">
				<p>
					잘 타는 사람보다<br />
					<em>오래 같이 타는 사람</em>이<br />
					더 많은 팀.
				</p>
			</section>

			<section id="faq" class="faq">
				<h2>FAQ</h2>
				<div>
					{faqs.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-row">
				<span>{club.footer}</span>
			</div>
			<p class="giant" aria-hidden="true">FREE SNOW</p>
		</footer>
		<script>
			// 메인 NOTICE 줄: 고정 공지 최대 3개 (공지는 누구나 볼 수 있음)
			import { base, call, ymd } from '../scripts/session';
			import { deg, sky, snow, weather } from '../scripts/weather';
			// TODAY 카드: 날씨(엘리시안 강촌) / 오늘 출격, 시즌방 인원(0명이면 그 칸 없음). 글자는 textContent로만
			{
				const box = document.querySelector<HTMLElement>('.today')!;
				const el = (tag: string, text = '', cls = '') => Object.assign(document.createElement(tag), { textContent: text, className: cls });
				const reveal = (card: HTMLElement) => {
					card.hidden = false;
					box.hidden = false;
					box.classList.toggle('both', !box.querySelector<HTMLElement>('.today-wx')!.hidden && !box.querySelector<HTMLElement>('.today-crew')!.hidden);
				};
				weather().then((list) => {
					const w = list.find((r) => r.id === 'gangchon');
					if (!w) return;
					const [icon, label] = sky(w.now.code);
					const card = box.querySelector<HTMLElement>('.today-wx')!;
					card.querySelector('.today-icon')!.textContent = icon;
					card.querySelector('.today-now')!.replaceChildren(`${w.name} ${deg(w.now.temp)}`, el('small', `지금 ${label}`));
					card.querySelector('.today-days')!.replaceChildren(
						...w.days.map((d, i) => {
							const s = el('span', `${i ? '내일' : '오늘'} `);
							s.append(el('b', `${deg(d.min)} / ${deg(d.max)}`), ' ', d.snow > 0 ? el('em', snow(d.snow)) : sky(d.code)[0]);
							return s;
						}),
					);
					reveal(card);
				});
				call({ action: 'today' }).then((r) => {
					if (!r?.ok || !(r.rides || r.stays)) return;
					const card = box.querySelector<HTMLElement>('.today-crew')!;
					card.replaceChildren(
						...[[r.rides, '출격'], [r.stays, '시즌방']].map(([n, t]) => {
							const d = el('span');
							d.append(el('b', String(n)), el('small', String(t)));
							return d;
						}),
					);
					reveal(card);
				}).catch(() => {});
			}

			const box = document.querySelector<HTMLElement>('.notice')!;
			const res = await call({ action: 'board.list', category: 'notice', pinned: true }).catch(() => null);
			const posts = (res?.posts ?? []).slice(0, 5);
			if (posts.length) {
				const list = box.querySelector('.notice-list')!;
				list.replaceChildren(
					...posts.map((p: { id: string; title: string; created_at: string }, i: number) => {
						const li = document.createElement('li');
						li.classList.toggle('on', i === 0);
						const a = document.createElement('a');
						a.href = `${base}/board/view/?id=${encodeURIComponent(p.id)}`;
						a.textContent = p.title; // textContent로만 (HTML 주입 방지)
						const d = document.createElement('span');
						d.textContent = ymd(p.created_at);
						li.append(a, d);
						return li;
					}),
				);
				box.hidden = false;
				// 공지가 여러 개면 하나씩 바꿔 가며 (사용자 요구 2026-10-29): 4.5초마다, 마우스를 올리거나 포커스가 있으면 멈춤, 모션 줄이기면 안 넘김
				const items = [...list.children] as HTMLElement[];
				const count = box.querySelector<HTMLElement>('.notice-count')!;
				let at = 0, hold = false;
				const go = (i: number) => {
					items[at].classList.remove('on');
					at = (i + items.length) % items.length;
					items[at].classList.add('on');
					count.textContent = `${at + 1} / ${items.length}`;
				};
				if (items.length > 1) {
					count.hidden = false;
					go(0);
					box.addEventListener('pointerenter', () => (hold = true));
					box.addEventListener('pointerleave', () => (hold = false));
					box.addEventListener('focusin', () => (hold = true));
					box.addEventListener('focusout', () => (hold = false));
					count.addEventListener('click', () => go(at + 1)); // 숫자를 누르면 다음 공지
					if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => !hold && !document.hidden && go(at + 1), 4500);
				}
			}
		</script>
		<script>
			import '../scripts/session';

			const video = document.querySelector<HTMLVideoElement>('.hero-art')!;
			const btn = document.querySelector<HTMLButtonElement>('.hero-pause')!;
			const sync = () => {
				btn.textContent = video.paused ? '▶' : '❚❚';
				btn.ariaLabel = video.paused ? '배경 영상 재생' : '배경 영상 일시정지';
			};
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) video.pause();
			btn.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
			// 자동재생은 음소거로만 허용돼서, 소리는 버튼으로 켬
			const sound = document.querySelector<HTMLButtonElement>('.hero-sound')!;
			sound.addEventListener('click', () => {
				video.muted = !video.muted;
				if (!video.muted && video.paused) video.play();
				sound.setAttribute('aria-pressed', String(!video.muted));
				sound.ariaLabel = video.muted ? '소리 켜기' : '소리 끄기';
			});
			video.addEventListener('play', sync);
			video.addEventListener('pause', sync);
			sync();
		</script>
		<script>
			// THE SEASON: 소모임 '정모 일정'을 서버가 1시간마다 읽어 옴 (참석은 소모임에서)
			import { call } from '../scripts/session';

			type Meetup = { title: string; date: string; time: string; place: string; fee: string; count: number | null; cap: number | null };
			const list = document.querySelector<HTMLOListElement>('.trip-list')!;
			const msg = document.querySelector<HTMLElement>('.season-msg')!;
			const more = document.querySelector<HTMLAnchorElement>('.season-more')!;

			const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text = '') => {
				const e = document.createElement(tag);
				e.className = cls;
				e.textContent = text; // 소모임 글은 textContent로만
				return e;
			};

			const bar = (m: Meetup) => {
				const wrap = el('div', 'att');
				if (m.count == null) return wrap;
				const left = m.cap ? m.cap - m.count : Infinity;
				const state = left <= 0 ? 'full' : left <= 2 ? 'soon' : '';
				const head = el('div', 'att-head');
				head.append(el('span', 'att-num', m.cap ? `${m.count} / ${m.cap}명` : `${m.count}명 참석`));
				if (m.cap) head.append(el('span', `att-left ${state}`, state === 'full' ? '마감' : state === 'soon' ? `마감 임박 | ${left}자리 남음` : `${left}자리 남음`));
				wrap.append(head);
				if (m.cap) {
					const b = el('div', `att-bar ${state}`);
					b.setAttribute('role', 'progressbar');
					b.ariaValueNow = String(m.count);
					b.ariaValueMax = String(m.cap);
					b.ariaLabel = '참석 인원';
					const fill = el('span', '');
					fill.style.width = `${Math.min(100, (m.count / m.cap) * 100)}%`;
					b.append(fill);
					wrap.append(b);
				}
				return wrap;
			};

			const res = await call({ action: 'somoim' }).catch(() => null);
			if (res?.url) more.href = res.url;
			const meetups: Meetup[] = res?.ok ? res.meetups : [];
			msg.textContent = !res?.ok ? '정모 일정을 불러오지 못했어요. 소모임에서 확인해 주세요.' : meetups.length ? '' : '예정된 정모가 아직 없어요.';
			msg.hidden = !msg.textContent;
			list.replaceChildren(
				...meetups.map((m, i) => {
					const li = document.createElement('li');
					const when = el('time', '', m.date);
					if (m.time) when.append(el('small', 'trip-end', m.time));
					const main = el('div', 'trip-main');
					main.append(el('h3', '', m.title), el('p', '', m.place));
					if (m.fee) main.append(el('p', 'trip-fee', m.fee));
					const box = el('div', 'trip-rsvp');
					const full = m.cap != null && m.count != null && m.count >= m.cap;
					const go = el('a', full ? 'btn-rsvp is-full' : 'btn-rsvp go', full ? '마감 | 소모임 보기 ↗' : '소모임에서 참석 ↗');
					go.href = res.url;
					go.target = '_blank';
					go.rel = 'noopener';
					box.append(go);
					li.append(el('span', 'idx', String(i + 1).padStart(2, '0')), when, main, box, bar(m));
					return li;
				}),
			);
		</script>
		<script>
			// 사진 띠 (히어로 스크립트와 따로 — 사진 목록 기다리는 동안 영상 버튼이 막히지 않게)
			import { base, galleryPhotos, thumbOf } from '../scripts/session';

			const MAX = 20; // 메인에는 최근 사진만
			const sec = document.querySelector<HTMLElement>('.reel')!;
			const photos = ((await galleryPhotos()) ?? []).slice(0, MAX);

			if (photos.length) {
				// 두 줄로 나눔. 사진이 적으면 두 줄 다 전체를 쓰되 아랫줄은 순서를 돌려서
				const half = Math.ceil(photos.length / 2);
				const rows = photos.length >= 8
					? [photos.slice(0, half), photos.slice(half)]
					: [photos, [...photos.slice(half), ...photos.slice(0, half)]];
				// 같은 묶음을 두 번 이어 붙여서 끊김 없이 반복 (두 번째 묶음은 화면 읽기 프로그램에서 숨김)
				const set = (list: typeof photos, copy: boolean) =>
					list.map((p, i) => {
						const a = document.createElement('a');
						a.href = `${base}/gallery/`;
						if (copy) { a.tabIndex = -1; a.ariaHidden = 'true'; }
						const img = document.createElement('img');
						img.src = thumbOf(p); // 갤러리 격자와 같은 사진 → 브라우저에 저장된 걸 같이 씀
						img.alt = copy ? '' : p.caption || `프리스노우 사진 ${i + 1}`;
						img.referrerPolicy = 'no-referrer';
						img.decoding = 'async';
						a.append(img);
						return a;
					});
				sec.querySelectorAll<HTMLElement>('.reel-track').forEach((track, r) => {
					track.replaceChildren(...set(rows[r], false), ...set(rows[r], true));
					track.style.setProperty('--dur', `${rows[r].length * 6}s`); // 사진 한 장에 약 6초
				});
				sec.hidden = false;

				const btn = sec.querySelector<HTMLButtonElement>('.reel-pause')!;
				btn.addEventListener('click', () => {
					const paused = sec.classList.toggle('is-paused');
					btn.textContent = paused ? '▶' : '❚❚';
					btn.ariaLabel = paused ? '사진 흐름 재생' : '사진 흐름 멈춤';
				});
			}
		</script>
	</body>
</html>
